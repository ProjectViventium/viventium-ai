xp_supervisor() {  # xp_supervisor STATE: the pid of this state's xPerfect supervisor, proved by the kernel and xPerfect's own
  # records, never by which process opened a file first: the process serving the state's control socket (the kernel names
  # it, LOCAL_PEERPID), which says this state runs from this checkout and has the state's service.lock open (only the
  # lock's holder ever serves that socket: scripts/host.py serve() locks first, and returns when it cannot)
  [ -n "$(lsof -t "$1/service.lock" 2>/dev/null)" ] || return 1  # (no process has its lock file open: none runs)
  local pid
  pid=$("$ROOT/.venv/bin/python" - "$(cd "$1" 2>/dev/null && pwd -P)" "$(cd "$ROOT/brain/xperfect" 2>/dev/null && pwd -P)" \
        "${VX_XPERFECT_SOCKETS:-/tmp/xperfect-$(id -u)}" 2>/dev/null <<'PY'
import hashlib, json, socket, sys
state, checkout, folder = sys.argv[1:4]
if not state or not checkout:
    sys.exit(1)
where = f"{folder}/{hashlib.sha256(state.encode()).hexdigest()[:24]}.sock"  # (scripts/host.py control_path)
try:
    with socket.socket(socket.AF_UNIX) as asked:
        asked.settimeout(3)
        asked.connect(where)
        server = asked.getsockopt(0, 2)  # (SOL_LOCAL, LOCAL_PEERPID: the pid serving this socket, from the kernel)
        asked.sendall(b"status")
        said = json.loads(asked.recv(65536))
except (OSError, ValueError):
    sys.exit(1)
if said.get("status") != "running" or said.get("checkout") != checkout or server <= 0:
    sys.exit(1)
print(server)
PY
) || return 1
  [ -n "$pid" ] && lsof -a -p "$pid" -- "$1/service.lock" >/dev/null 2>&1 && echo "$pid"
}
xp_record() {  # xp_record STATE: the records that prove this state's xPerfect: vx's launch record for its supervisor (the
  # pid xp_supervisor proves: after vx started it, or the first look after an update) and, while that supervisor is
  # proven, one for each service it started (pid and start time), refreshed at every look
  local name=${1##*/} sup child launch_source="" launch_build_source="" record lock
  [ -f "$1/service.lock" ] || return 0
  lock="$LOGS/$name.launch.lock"; mine "$lock"
  (
    # up and keep look can both prove the same supervisor. Keep the lock on the shell's open file
    # until all its records are written, so a look cannot replace the identity up just recorded.
    "$ROOT/.venv/bin/python" -c 'import fcntl; fcntl.flock(9, fcntl.LOCK_EX)' || exit 1
    sup=$(xp_supervisor "$1") || exit 0
    record="$LOGS/launched/$sup"
    if launch_holds "$sup" "xp:$name"; then launch_source=$(sed -n 4p "$record"); fi
    if [ -z "$launch_source" ] && [ -n "${3:-}" ] && [ "$sup" != "$2" ]; then
      launch_source=$3; launch_build_source=$(source_identity "$ROOT/brain/xperfect")
      launched "$sup" "xp:$name" xperfect
    else
      launch_holds "$sup" "xp:$name" || launched "$sup" "xp:$name" xperfect
    fi
    launch_build_source=""  # the supervisor's record holds the xPerfect build identity
    for child in $(pgrep -P "$sup" 2>/dev/null); do
      if ! launch_holds "$child" "xp-service:$name" ||
          { [ -n "$launch_source" ] && [ -z "$(sed -n 4p "$LOGS/launched/$child")" ]; }; then
        launched "$child" "xp-service:$name" xperfect-service
      fi
    done
  ) 9<>"$lock"
}
xp_own() {  # xp_own STATE PID: one of this state's xPerfect processes, by its record alone (its pid with the same start
  # time): the supervisor, or a service recorded while that supervisor was proven, also once the supervisor is gone.
  # Nothing is inferred from when a process started, nor from its arguments.
  launch_holds "$2" "xp:${1##*/}" || launch_holds "$2" "xp-service:${1##*/}"
}
xp_on_port() {  # xp_on_port NAME STATE, for keep: that xPerfect's API is up (its own, by its records), else gone or held
  local port pid found=""; port=$(xp_ports "$2" api)
  xp_record "$2"
  for pid in $(lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null); do
    if xp_own "$2" "$pid"; then return 0; fi
    found=held
  done
  if [ -z "$found" ] && nc -z 127.0.0.1 "$port" 2>/dev/null; then found=held; fi
  if [ "$found" = held ]; then held="$held $1"; else gone="$gone $1"; fi
}
xp_stop() {  # xp_stop STATE_DIR: stop that xPerfect; then end any of its own services its supervisor left behind
  # (the supervisor was gone, "xPerfect is stopped", yet its API still held 8866 and the next start failed), each
  # proved its own by its record (xp_own), never by its arguments or its start time alone
  xp_record "$1" || true  # shutdown uses the records it has if it cannot refresh them
  "$ROOT/brain/xperfect/xperfect" stop --state-dir "$1" >/dev/null 2>&1 || true
  local pid port ports; ports=$(xp_ports "$1")
  for port in $ports; do
    for pid in $(lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null); do
      if xp_own "$1" "$pid"; then kill -TERM "$pid" 2>/dev/null || true; fi
    done
  done
  for _ in $(seq 1 20); do
    local left=""
    for port in $ports; do for pid in $(lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null); do xp_own "$1" "$pid" && left=1; done; done
    [ -n "$left" ] || break; sleep 0.5
  done
  local record  # (the records of what is gone go with it)
  for record in "$LOGS"/launched/*; do
    [ -f "$record" ] || continue
    case "$(sed -n 1p "$record")" in "xp:${1##*/}"|"xp-service:${1##*/}") launch_holds "${record##*/}" || rm -f "$record" ;; esac
  done
}

restart() {  # restart [PROFILE]: checked first, once, before anything stops (what keeps it from starting is said, and
  # nothing stops; before, it was asked twice), and another program on LiveKit's or the page's port too; then only
  # what changes stops (settle) and she starts on it. A new mind that then does not answer leaves her new parts up with
  # the reason (mind_answers, exit 3 or 4): never half.
  recover_restore
  local profile="${1:-$(cat "$LOGS/profile" 2>/dev/null || echo local)}" said
  said=$("$ROOT/vx" ready "$profile" 2>&1) || { echo "$said"; exit 1; }
  if held_by_other; then exit 1; fi
  load_profile "$profile"; livekit_keys; phone_key; own_folders; settle; up "$profile"
}

down() {  # (VX_KEEP_UI=1: a restart from the settings page keeps the page up, to show how it went.)
  # A start at work (the app's, Terminal's or the keeper's) is stopped first, so nothing comes up after this (before,
  # Quit stopped only the app's own); what it was downloading goes on from there at the next start.
  local owner group
  owner=$(cat "$LOGS/up.lock/pid" 2>/dev/null || true)
  if [ -n "$owner" ] && [ "$owner" != "$$" ] && kill -0 "$owner" 2>/dev/null; then
    group=$(ps -o pgid= -p "$owner" 2>/dev/null | tr -d ' ')
    if [ -n "$group" ] && [ "$group" != "$(ps -o pgid= -p $$ | tr -d ' ')" ]; then kill -TERM -- "-$group" 2>/dev/null || true
    else pkill -TERM -P "$owner" 2>/dev/null || true; kill -TERM "$owner" 2>/dev/null || true; fi
    for _ in 1 2 3 4 5; do kill -0 "$owner" 2>/dev/null || break; sleep 1; done
    rm -rf "$LOGS/up.lock"
  fi
  [ "${VX_KEEP_UI:-}" = 1 ] || stop ui "$UI_PORT"
  stop hearing-setup
  stop chat; stop clock; stop agent; stop doorbell 8869; stop livekit 7880; stop tts 8940; stop stt 8930
  stop hearing-files
  stop setup-memory; stop life-index; stop model 11435; stop worker-model 11436; stop embed-model 11437; stop_doors
  for state in "$ROOT"/brain/state-*; do
    if [ -f "$state/config.json" ]; then xp_stop "$state"; fi
  done
  echo "Stopped."
}

status() {
  if restore_pending; then
    printf 'restore reason: '
    (cd "$ROOT" && "$ROOT/.venv/bin/python" -m core.backup reason)
    if (cd "$ROOT" && "$ROOT/.venv/bin/python" -m core.backup blocked); then echo 'restore blocked: yes'; fi
    return 0
  fi
  echo "profile: $(cat "$LOGS/profile" 2>/dev/null || echo none)"
  for pair in model:11435 worker-model:11436 embed-model:11437 stt:8930 tts:8940 livekit:7880 ui:$UI_PORT; do
    name=${pair%%:*}; port=${pair##*:}
    case "$(holder "$port")" in
      ours) echo "  $name: up ($port)" ;;
      other) echo "  $name: not started: port $port is held by another program, not this Viventium (quit it, then ./vx up)" ;;
      *) echo "  $name: down" ;;
    esac
  done
  if running agent; then echo "  agent: up"
    # (up, but a start at work has not written its own verdict yet: not ready until it does, and not "not answering"
    # either; on a clean Mac her parts were up 15 s before the verdict, and the menu bar showed her ready. No start
    # at work, or one whose run is gone: the last verdict as it stands, and none ever written reads as her parts)
    if starting && [ ! "$LOGS/mind-answer" -nt "$LOGS/up.lock" ]; then echo "  mind: not asked yet (a start is at work)"
    # (up, but her mind did not answer when last asked: not ready until a verdict says it does, mind_answers)
    elif [ -s "$LOGS/mind-answer" ]; then
      case "$(awk 'NR == 1 {print $1}' "$LOGS/mind-answer")" in
        answered) ;;
        connected)
          local mind_state="${VX_STATE:-$ROOT/state}/core" since="$LOGS/mind-answer" reason=""
          [ ! -s "$LOGS/agent.pid" ] || since="$LOGS/agent.pid"
          if [ ! "$mind_state/mind-answered" -nt "$since" ]; then
            if [ "$mind_state/mind-first-failure" -nt "$since" ] && [ -s "$mind_state/mind-first-failure" ]; then
              echo "  mind: not answering"
              echo "  mind reason: $(sed -n 1p "$mind_state/mind-first-failure")"
            else
              reason=$(cd "$ROOT" && "$ROOT/.venv/bin/python" -m settings.probe connection 2>/dev/null) ||
                reason="ChatGPT's connection could not be checked."
              if [ -n "$reason" ]; then
                echo "  mind: not answering"
                echo "  mind reason: $reason"
              else
                echo "  mind: connected, awaiting first answer"
              fi
            fi
          fi ;;
        *) echo "  mind: not answering" ;;
      esac
    fi
  else echo "  agent: down"; fi
  running chat && echo "  telegram: up" || echo "  telegram: off"
  if running clock; then echo "  clock: up (reminders, with no Telegram bot)"; fi
  if running doors; then echo "  phone: on ($(door_ports | head -2 | tr '\n' ' ')calls from your phone on this Wi-Fi)"; fi
  nc -z 127.0.0.1 8869 2>/dev/null && echo "  doorbell: up (8869; xPerfect's clock rings it)" || echo "  doorbell: down (Light rings its reminders itself)"
  local online=down here=down  # her Workers' xPerfect: the online ones', and the one of the Workers on this Mac
  if nc -z 127.0.0.1 8866 2>/dev/null; then online=up; echo "  xperfect: up (8866, UI 8880)"; fi
  if nc -z 127.0.0.1 8876 2>/dev/null; then here=up; echo "  xperfect, Workers on this Mac: up (8876, UI 8890)"; fi
  if [ "$online$here" = downdown ]; then echo "  xperfect: down"; fi
  source_status
}

source_line() {  # label, recorded identity, current checkout commit
  local commit dirty stale=""
  read -r commit dirty <<< "$2"
  if [[ ! "$commit" =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]]; then echo "  source $1: source unknown"; return; fi
  case "$dirty" in clean|dirty|packaged) ;; *) dirty="dirty state unknown" ;; esac
  if [ "$3" != unknown ] && [ "$commit" != "$3" ]; then stale=" [stale]"; fi
  printf '  source %s: %s (%s)%s\n' "$1" "$commit" "$dirty" "$stale"
}

tool_ready() {  # A stock Mac's Apple executables can be installer stubs. Resolve without running them.
  local tool
  tool=$(command -v "$1") || return 1
  case "$tool" in
    /usr/bin/python3|/usr/bin/git|/usr/bin/swiftc|/usr/bin/cc|/usr/bin/clang|/usr/bin/make)
      xcode-select -p >/dev/null 2>&1 ;;
    *) return 0 ;;
  esac
}

source_status() {
  # Status runs during first setup too, before Homebrew's Python and Git exist.
  if ! tool_ready python3 || { [ -z "${RELEASE:-}" ] && ! tool_ready git; }; then
    echo "  source: waiting for system tools"; return 0
  fi
  local revisions head file name pid record id identity state child xp_head app_root note
  if [ -n "${RELEASE:-}" ]; then
    head=${RELEASE%% *}; xp_head=$(cat "$ROOT/brain/xperfect.pin")
  else
    revisions=$(git -C "$ROOT" rev-parse --revs-only HEAD HEAD:brain/xperfect 2>/dev/null || true)
    head=$(sed -n 1p <<<"$revisions"); xp_head=$(sed -n 2p <<<"$revisions")
  fi
  head=${head:-unknown}; xp_head=${xp_head:-unknown}
  printf '  source checkout HEAD %s\n' "$head"
  if [ -f "$ROOT/brain/xperfect.files.json" ]; then
    if xperfect_source_clean "$head" "$xp_head" >/dev/null 2>&1; then
      echo "  source xPerfect files: verified pin and patches"
    else echo "  source xPerfect files: not verified; keep this copy and install a fresh copy of Light"; fi
  fi
  for file in "$LOGS"/*.pid; do
    [ -f "$file" ] || continue
    name=${file##*/}; name=${name%.pid}
    pid=$(own_pid "$name") || continue
    record="$LOGS/launched/$pid"
    source_line "$name" "$(sed -n 4p "$record" 2>/dev/null || true)" "$head"
    case "$name" in
      ui) id=$(sed -n 5p "$record" 2>/dev/null || true)
          [[ "$id" =~ ^[A-Za-z0-9._-]+$ ]] || id=unknown
          source_line "running page build ${id:-unknown}" "$(sed -n 6p "$record" 2>/dev/null || true)" "$head" ;;
      menubar) source_line 'running menu bar build' "$(sed -n 6p "$record" 2>/dev/null || true)" "$head" ;;
    esac
  done
  for state in "$ROOT"/brain/state-*; do
    [ -f "$state/service.lock" ] || continue
    pid=$(xp_supervisor "$state") || continue
    name=${state##*/}
    for child in "$pid" $(pgrep -P "$pid" 2>/dev/null); do
      identity=""
      if xp_own "$state" "$child"; then identity=$(sed -n 4p "$LOGS/launched/$child"); fi
      source_line "Workers $name (PID $child)" "$identity" "$head"
    done
    identity=""
    if xp_own "$state" "$pid"; then identity=$(sed -n 6p "$LOGS/launched/$pid"); fi
    source_line "xPerfect $name" "$identity" "$xp_head"
  done
  id=$(cat "$ROOT/call/ui/.next/BUILD_ID" 2>/dev/null || true)
  if [ -n "$id" ]; then
    identity=$(page_source "$id")
    [[ "$id" =~ ^[A-Za-z0-9._-]+$ ]] || id=unknown
    source_line "page build $id" "$identity" "$head"
  fi
  if [ -x "$APP/Contents/MacOS/Viventium" ]; then
    app_root=$(app_value ViventiumRoot)
    if [ -n "$app_root" ] && [ "$app_root" != "$ROOT" ]; then
      source_line 'installed app (another checkout)' "$(app_value ViventiumSource)" unknown
    else source_line 'installed app' "$(app_value ViventiumSource)" "$head"; fi
  fi
  note="$HOME/Library/Application Support/Viventium Light/keep.json"
  if kept && [ -s "$note" ] && [ "$(plutil -extract root raw "$note" 2>/dev/null || true)" = "$ROOT" ]; then
    pid=$(launchctl list 2>/dev/null | awk -v name="$KEEPER" '$3 == name {print $1}' || true)
    if [ -n "$pid" ] && [ "$pid" != - ] && [ "$(plutil -extract pid raw "$note" 2>/dev/null || true)" = "$pid" ]; then
      source_line 'running keeper app build' "$(plutil -extract source raw "$note" 2>/dev/null || true)" "$head"
    fi
  fi
}

keep() {  # what autostart runs: brings back any part of her that stopped, on the profile she last ran
  # Never during a test run (it swaps her agent) or after ./vx down (stay down until ./vx up).
  tests_running && return 0
  if [ "${1:-}" != look ]; then  # (./vx keep look: only say which parts are missing; ./vx doctor asks)
    starting && return 0  # (a start is at work this minute: what looks gone is being brought up)
    [ -f "$LOGS/stopped" ] && return 0
    if restore_pending && (cd "$ROOT" && "$ROOT/.venv/bin/python" -m core.backup blocked); then
      return 0  # a failed recovery waits for the person's one explicit retry or another backup
    fi
    recover_restore
    [ -f "$LOGS/settings-pending.json" ] && return 0  # (a settings change is restarting her this minute: not gone)
    kept || menubar start  # (her mark stays while she rests: it is how you start her again; the keeper app shows its own)
  fi
  local profile gone="" held=""; profile="$(cat "$LOGS/profile" 2>/dev/null || echo local)"
  load_profile "$profile"
  running agent || gone="$gone agent"
  if [ -f "$LOGS/chat.pid" ] && ! running chat; then gone="$gone telegram"; fi
  if [ ! -f "$LOGS/chat.pid" ] && ! running clock; then gone="$gone clock"; fi  # (no bot: the clock is its own process)
  on_port doorbell 8869
  if [ -n "${VX_LAN_ORIGIN:-}" ] && ! running doors; then gone="$gone doors"; fi
  # (a new address on his network: LiveKit offers the phone's sound where nothing answers; started again, never in a call)
  if [ -n "${VX_LAN_ORIGIN:-}" ] && ! call_live && (cd "$ROOT" && "$ROOT/.venv/bin/python" -m call.phone moved); then
    gone="$gone phone-address"
  fi
  on_port livekit 7880
  on_port ui "$UI_PORT"
  xp_on_port workers "$XPERFECT_STATE"  # (xPerfect starts its own services: proved by its records, xp_own)
  if [ -n "${XPERFECT_LOCAL_STATE:-}" ]; then xp_on_port workers-on-this-mac "$XPERFECT_LOCAL_STATE"; fi
  if [ -n "${LIFE:-}" ] && [ "${MEMORY_EMBED:-}" != off ]; then on_port embed-model 11437; fi
  if [ "$QUEEN" = ollama ]; then on_port model 11435; fi
  if [ "${WORKERS:-}" = local ] || [ -n "${WORKERS_LOCAL:-}" ] || [[ "${FEELINGS_URL:-}${MEMORY_URL:-}" == *:11436* ]]; then
    on_port worker-model 11436
  fi
  if [ "$STT" = whisper_local ]; then on_port stt 8930; fi
  if local_voice; then on_port tts 8940; fi
  if [ "${1:-}" = look ]; then echo "$gone${held:+ held:$held}"; return 0; fi
  # (a part whose port another program holds cannot start until it is quit: said once a run, never started over it)
  if [ -n "$held" ]; then echo "$(date '+%F %T') held by another program, so not started:$held"; fi
  [ -z "$gone" ] && return 0
  echo "$(date '+%F %T') down:$gone; starting $profile"
  VX_NO_OPEN=1 VX_KEEPING=1 up "$profile"
}

# Her one small native program (tools/menubar/main.swift), the app "Viventium AI" in your Applications folder:
# opened like any app (Launchpad, Spotlight, the Dock), it starts her and opens her call page; it is also the mark in
# the menu bar and, when she starts with this Mac, the keeper that runs ./vx keep. It lives outside this folder because
# macOS lets no background program read Documents, Desktop or Downloads until you allow that program by name:
# launchd running /bin/bash on ./vx there only fails ("Operation not permitted") and nobody is asked.
# An app is asked for once, by name, and everything it starts is allowed with it. (Not ~/Applications/Viventium.app:
# that is main Viventium's own helper.) Before, it was built hidden in Application Support; it moves here once.
APP="${VX_APP:-$HOME/Applications/Viventium AI.app}"
OLD_APP="$HOME/Applications/Viventium Light.app"
LEGACY_APP="$HOME/Library/Application Support/Viventium Light/Viventium.app"
KEEPER=ai.viventium-light.keep
if [ -n "$RELEASE" ]; then
  APP=$(cat "$ROOT/.vx-app" 2>/dev/null || true)
  KEEPER=ai.viventium-light.package.keep
  export PATH="$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
fi
kept() { [ -f "$HOME/Library/LaunchAgents/$KEEPER.plist" ]; }  # launchd runs the app (she starts with this Mac)

app_path() {  # the PATH the app and launchd give vx: this one, each folder once, only folders that exist and are not
  # one window's or one session's own (a shell's per-window entries, temporary folders, which
  # are gone once that window or session ends)
  # (each line ends, the last one too: an unended last folder was dropped, so every rewrite of the app's PATH
  # lost one, /sbin and then /usr/sbin, and vx ran without lsof or sysctl. macOS's own folders always come last.)
  local dir
  printf '%s:/usr/bin:/bin:/usr/sbin:/sbin\n' "$PATH" | tr : "\n" | while IFS= read -r dir; do
    case "$dir" in ""|*fnm_multishells*|/tmp/*|/private/tmp/*|/var/folders/*|/private/var/folders/*|/var/run/*|*/.codex/tmp/*) continue ;; esac
    [ -d "$dir" ] && printf '%s\n' "$dir"
  done | awk '!seen[$0]++' | paste -sd : -
}

helper() {  # the app, built once and again only when its source changed (a new build is asked for again by macOS)
  local bin="$APP/Contents/MacOS/Viventium" src="$ROOT/tools/menubar/main.swift" plist="$APP/Contents/Info.plist"
  if [ -n "${RELEASE:-}" ]; then
    [ -x "$bin" ] && [ "$(app_value ViventiumSource)" = "$RELEASE" ]
    return
  fi
  # Rename the existing bundle in place: its identifier, inode, state and Keychain services stay the same.
  # Only migrate this checkout's app, never main Viventium or an unrelated installation.
  local old migrated=""
  for old in "$OLD_APP" "$LEGACY_APP"; do
    [ "$APP" = "$HOME/Applications/Viventium AI.app" ] || continue
    if [ -d "$old" ]; then
      local old_id old_root
      old_id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$old/Contents/Info.plist" 2>/dev/null || true)
      old_root=$(/usr/libexec/PlistBuddy -c 'Print :ViventiumRoot' "$old/Contents/Info.plist" 2>/dev/null || true)
      if [ "$old_id" != ai.viventium.light ] || [ "$old_root" != "$ROOT" ]; then
        echo "The previous app belongs to another installation. Keep it until its owner moves it."; return 1
      fi
      migrated=yes
    fi
  done
  if [ -n "$migrated" ] && [ -e "$APP" ]; then
    if [ "$(app_value CFBundleIdentifier)" != ai.viventium.light ] || [ "$(app_value ViventiumRoot)" != "$ROOT" ]; then
      echo "The new app name is already used by another installation. Keep both apps until their owner moves them."; return 1
    fi
  fi
  if [ -x "$bin" ] && [ ! "$src" -nt "$bin" ] && [ "$(app_value ViventiumRoot)" = "$ROOT" ] &&
     [ -n "$(app_value ViventiumSource)" ] && [ -z "$migrated" ] && [ "$(app_value CFBundleDisplayName)" = "Viventium AI" ]; then
    return 0; fi
  if ! xcode-select -p >/dev/null 2>&1; then
    [ "${1:-}" = build ] || return 0  # ./vx up runs without building a native app from source.
    echo "Building the app needs Apple's developer tools: run 'xcode-select --install' once."; return 1
  fi
  local identity; identity=$(source_identity)
  # Compile before changing the old app or its login item. A failed build leaves the old install usable.
  local compiled; compiled=$(mktemp -d)
  swiftc -O -o "$compiled/Viventium" "$src" >"$LOGS/menubar-build.log" 2>&1 || {
    rm -rf "$compiled"; echo "It did not build; see logs/menubar-build.log"; return 1;
  }
  if [ -n "$migrated" ] && [ ! -e "$APP" ]; then
    for old in "$OLD_APP" "$LEGACY_APP"; do
      if [ -d "$old" ]; then mv "$old" "$APP"; break; fi
    done
  fi
  mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
  mv "$compiled/Viventium" "$bin"; rmdir "$compiled"
  # Its icon, drawn by the app itself at every size macOS asks for.
  local set; set="$(mktemp -d)/AppIcon.iconset"; mkdir -p "$set"
  for side in 16 32 128 256 512; do
    "$bin" "$ROOT" --icon "$set/icon_${side}x${side}.png" "$side" && "$bin" "$ROOT" --icon "$set/icon_${side}x${side}@2x.png" $((side * 2))
  done >>"$LOGS/menubar-build.log" 2>&1
  iconutil -c icns -o "$APP/Contents/Resources/AppIcon.icns" "$set" >>"$LOGS/menubar-build.log" 2>&1 || true
  rm -rf "$(dirname "$set")"
  local why="Viventium lives in this folder. It reads it to start and to stay running."
  cat >"$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleIdentifier</key><string>ai.viventium.light</string>
  <key>CFBundleName</key><string>Viventium AI</string>
  <key>CFBundleDisplayName</key><string>Viventium AI</string>
  <key>NSHumanReadableCopyright</key><string>© 2026 xPerfect.ai</string>
  <key>CFBundleExecutable</key><string>Viventium</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1</string>
  <key>CFBundleVersion</key><string>$(date +%Y%m%d%H%M)</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
  <key>LSUIElement</key><true/>
  <key>ViventiumRoot</key><string>$ROOT</string>
  <key>ViventiumSource</key><string>$identity</string>
  <key>LSEnvironment</key><dict><key>PATH</key><string>$(app_path)</string><key>UI_PORT</key><string>$UI_PORT</string></dict>
  <key>NSDocumentsFolderUsageDescription</key><string>$why</string>
  <key>NSDesktopFolderUsageDescription</key><string>$why</string>
  <key>NSDownloadsFolderUsageDescription</key><string>$why</string>
</dict></plist>
EOF
  codesign --force -s - "$APP" >>"$LOGS/menubar-build.log" 2>&1 || return 1
  # A test exercises the same migration and plist rewrite but never contacts this login's launchd.
  if [ -n "$migrated" ] && kept; then autostart plist >"$HOME/Library/LaunchAgents/$KEEPER.plist"; fi
  if [ -n "$migrated" ]; then
    for old in "$OLD_APP" "$LEGACY_APP"; do
      [ "$old" = "$APP" ] || rm -rf "$old"
    done
  fi
  [ -n "${VX_APP:-}" ] && return 0  # (a test's own app: never registered, and nothing of his is stopped, moved or restarted)
  # Launchpad and Spotlight find it at once.
  /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$APP" \
    >>"$LOGS/menubar-build.log" 2>&1 || true
  # (asked by the app itself, starting her: it never restarts itself; the new build is used at its next open or login)
  [ -n "${VX_FROM_APP:-}" ] && return 0
  stop menubar  # (a new build replaces the one that is running)
  if [ -n "$migrated" ]; then  # launchd runs the renamed app from now on
    if kept; then
      autostart plist >"$HOME/Library/LaunchAgents/$KEEPER.plist"
      launchctl bootout "gui/$(id -u)/$KEEPER" 2>/dev/null || true
      # (launchd takes a moment to let go of the old one: a bootstrap at once can fail)
      local tries=0
      until launchctl bootstrap "gui/$(id -u)" "$HOME/Library/LaunchAgents/$KEEPER.plist" 2>/dev/null; do
        tries=$((tries + 1)); [ "$tries" -ge 10 ] && { echo "launchd did not take the new app yet: ./vx autostart on puts it back."; break; }
        sleep 1
      done
    fi
    echo "Viventium AI is in your Applications folder now: open it from there, Launchpad or Spotlight."
  elif kept; then launchctl kickstart -k "gui/$(id -u)/$KEEPER" >/dev/null 2>&1 || true; fi
}

menubar() {  # menubar on|off|start|menu: her mark in the menu bar, there whenever she runs, unless you switched
  # it off in Settings (logs/menubar.off: what you chose stays chosen)
  local bin="$APP/Contents/MacOS/Viventium"
  case "${1:-}" in
    on) helper || exit 1; rm -f "$LOGS/menubar.off"; menubar start; echo "Menu bar: on." ;;
    off) touch "$LOGS/menubar.off"; rm -f "$LOGS/menubar.on"; kept || stop menubar; echo "Menu bar: off." ;;  # (the keeper takes its own mark down)
    menu) if [ -x "$bin" ]; then UI_PORT="$UI_PORT" "$bin" "$ROOT" --menu; else echo "Not built yet: ./vx app"; fi ;;  # its panel as it would open now
    start) if kept; then launchctl kickstart "gui/$(id -u)/$KEEPER" >/dev/null 2>&1 || true  # (launchd's; started if it is not running)
      elif [ ! -f "$LOGS/menubar.off" ] && [ -x "$bin" ] && ! running menubar; then start menubar - env UI_PORT="$UI_PORT" "$bin" "$ROOT" >/dev/null; fi ;;
    *) if [ -f "$LOGS/menubar.off" ]; then echo "menubar: off (./vx menubar on)"; else echo "menubar: on"; fi ;;
  esac
}

autostart() {  # autostart on|off: launchd (yours, in ~/Library/LaunchAgents) runs the app, which runs ./vx keep
  local plist="$HOME/Library/LaunchAgents/$KEEPER.plist"
  case "${1:-}" in
    on) helper || exit 1
      stop menubar  # (launchd runs the one app from now on, and it shows the mark too)
      mkdir -p "$HOME/Library/LaunchAgents"; autostart plist >"$plist"
      launchctl bootout "gui/$(id -u)/$KEEPER" 2>/dev/null || true
      launchctl bootstrap "gui/$(id -u)" "$plist" || { echo "launchd did not take it; see $plist"; exit 1; }
      echo "Autostart on: Viventium starts when you log in, and a part that stops comes back within 2 minutes (logs/keep.log)."
      echo "If this folder is in Documents, Desktop or Downloads, macOS asks once whether Viventium may read it: choose Allow."
      echo "./vx down still stops it until ./vx up. Undo: ./vx autostart off" ;;
    off) launchctl bootout "gui/$(id -u)/$KEEPER" 2>/dev/null || true; rm -f "$plist"; menubar start; echo "Autostart off." ;;
    plist) cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$KEEPER</string>
  <key>ProgramArguments</key><array><string>$APP/Contents/MacOS/Viventium</string><string>$ROOT</string><string>--keep</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key><string>Interactive</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>$(app_path)</string><key>UI_PORT</key><string>$UI_PORT</string></dict>
  <key>StandardOutPath</key><string>$LOGS/keep.log</string>
  <key>StandardErrorPath</key><string>$LOGS/keep.log</string>
</dict></plist>
EOF
      ;;
    *) if [ -f "$plist" ]; then echo "autostart: on"; else echo "autostart: off (./vx autostart on)"; fi ;;
  esac
}

subscriptions() {  # subscriptions [claude|codex|grok_mind]: the subscriptions this Mac's tools can use, one line each ("claude
  # signed-in", "codex signed-out"; one whose tool is not here is not listed), for the app's sign-in logos; with a name,
  # that provider's own sign-in started (its tool opens the browser; nothing is kept here)
  local name harness tool active
  active=$(cat "$LOGS/profile" 2>/dev/null || true)
  if [ "${1:-}" = chatgpt_mind ]; then
    [ -x "$ROOT/.venv/bin/python" ] || return 1
    if [ "${2:-}" = --cancel ]; then
      (cd "$ROOT" && "$ROOT/.venv/bin/python" -m core.chatgpt_sign_in cancel)
      return
    fi
    local args=()
    [ -z "${VX_SIWC_CONSENT_FILE:-}" ] || args+=(--consent-file "$VX_SIWC_CONSENT_FILE")
    (cd "$ROOT" && "$ROOT/.venv/bin/python" -m core.chatgpt_sign_in login "${args[@]}")
    return
  fi
  if [ "${1:-}" = grok_mind ]; then
    load_profile "${active:-local}" assess
    [ -x "$ROOT/.venv/bin/python" ] || return 1
    mine "$LOGS/sign-in.log"
    (cd "$ROOT" && "$ROOT/.venv/bin/python" -m core.grok_sign_in start 2>>"$LOGS/sign-in.log")
    return
  fi
  for name in claude codex; do
    harness=$([ "$name" = claude ] && echo claude-code || echo codex-cli); tool=$([ "$name" = claude ] && echo claude || echo codex)
    command -v "$tool" >/dev/null 2>&1 || continue
    if [ -z "${1:-}" ]; then
      if signed_in_now "$harness"; then echo "$name signed-in"; else echo "$name signed-out"; fi
    elif [ "$1" = "$name" ]; then
      rm -f "$LOGS/settings-signins.json"  # (Settings asks again)
      if [ "$name" = claude ]; then set -- claude auth login; else set -- codex login; fi
      # Its own tool opens the browser. Keep stdout and stderr away from app logs.
      export BROWSER=/usr/bin/open
      "$@" >/dev/null 2>&1 </dev/null; return
    fi
  done
  [ -z "${1:-}" ] || { echo "No such subscription on this Mac: ${1}"; return 1; }
}

doctor() {  # what is wrong, in plain words, and what to do (core/doctor.py says it; this gathers what only vx knows)
  if restore_pending; then
    (cd "$ROOT" && "$ROOT/.venv/bin/python" -m core.backup doctor)
    return $?
  fi
  local profile said code=0 code2 flags=()
  profile="$(cat "$LOGS/profile" 2>/dev/null || echo local)"
  said="$(mktemp)"; "$0" ready "$profile" >"$said" 2>&1 </dev/null || code=$?
  [ ! -f "$LOGS/stopped" ] || flags+=(--stopped)
  ! kept || flags+=(--autostart)
  load_profile "$profile" check
  if [ "$QUEEN" = ollama ] || [ "${WORKERS:-}" = local ] || [ -n "${WORKERS_LOCAL:-}" ] || [[ "${FEELINGS_URL:-}${MEMORY_URL:-}" == *:11436* ]]; then
    flags+=(--local-models)
  fi
  ! running chat || flags+=(--telegram)
  local missing identity; missing="$(keep look)"; identity="$(source_status)"; code2=0
  (cd "$ROOT" && "$ROOT/.venv/bin/python" -m core.doctor --profile "$PROFILE" --missing "$missing" --ready-code "$code" \
    --ready-file "$said" --source "$identity" ${flags[@]+"${flags[@]}"}) || code2=$?
  rm -f "$said"; return $code2
}

setup_marker() {
  local profile="${PROFILE:-local}" old
  if [ -f "$LOGS/.setup-done" ] && [ ! -s "$LOGS/.setup-done" ]; then
    old=$(cat "$LOGS/profile" 2>/dev/null || true)
    case "$old/$profile" in
      small-*/small-*) [ "$old" != "$profile" ] || { echo "$LOGS/.setup-done"; return; } ;;
      small-*/*|*/small-*) ;;
      *) echo "$LOGS/.setup-done"; return ;;
    esac
  fi
  echo "$LOGS/.setup-done.$profile"
}

migrate_setup_marker() {  # Before replacing the profile that an older setup marker belongs to.
  [ -f "$LOGS/.setup-done" ] && [ ! -s "$LOGS/.setup-done" ] || return 0
  local old profile
  old=$(cat "$LOGS/profile" 2>/dev/null || true)
  case "$old" in small-8|small-16|small-24) set -- "$old" ;; *) set -- local hybrid cloud ;; esac
  for profile; do touch -r "$LOGS/.setup-done" "$LOGS/.setup-done.$profile"; done
  printf 'profiles\n' > "$LOGS/.setup-done"
}

needs_setup() {  # the first run for this profile, or an update changed what setup installs
  local marker; marker=$(setup_marker)
  [ ! -f "$marker" ] || [ -n "$(find "$ROOT/uv.lock" "$ROOT/speech/tts/uv.lock" "$ROOT/call/ui/pnpm-lock.yaml" \
    "$ROOT/brain/patches" "$ROOT/core/downloads.json" "$ROOT/brain/xperfect.files.json" -newer "$marker" 2>/dev/null | head -1)" ]
}

fetching() {  # fetching WHAT COMMAND...: one of setup's downloads, in a subshell of its own. When it fails (no connection,
  # a server that dropped it) one plain line says what to do and its detail goes to logs/setup.log, never a traceback
  # (a clean Mac: Hugging Face's file server dropped her voice model mid-file and ./vx up ended in a Python
  # traceback). Every step is safe to run again, so a dropped one is tried again by itself twice before it is told.
  local what=$1 try; shift
  for try in 1 2 3; do
    if ( "$@" ) >>"$LOGS/setup.log" 2>&1; then return 0; fi
    [ "$try" = 3 ] || [ "$(free_gb)" -lt 2 ] && break
    sleep $(( try * 5 ))
  done
  download_failed "$what"
}

homebrew() {  # Homebrew, which her tools come from, installed by its own official script on a Mac that has none (before,
  # the first run stopped at a link and a separate install). It asks for this Mac's password once.
  local b script=""
  for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do  # (installed already, only not on this shell's PATH)
    [ -x "$b" ] && { eval "$("$b" shellenv)"; return 0; }
  done
  if [ -n "${VX_FROM_APP:-}" ]; then
    homebrew_package
    echo "Approve the system tools in Installer."
    blocked tools; exit 1
  fi
  if [ ! -t 0 ]; then
    echo "Homebrew is required. Open the Viventium AI app to install it."; blocked tools; exit 1
  fi
  echo "Installing Homebrew, which its tools come from (it asks for this Mac's password once)."
  if xcode-select -p >/dev/null 2>&1; then
    # Keep the existing developer route when Apple's tools are already installed.
    script="$LOGS/homebrew-install.sh"
    fetch "$script" https://raw.githubusercontent.com/Homebrew/install/c9c975046f78e6e6d662deb801bd461ebd6a54ed/install.sh \
      "the system tools" 8fd2f1a5287a7c2e3d7362924c677edcc04c5a0e16448c77132d056bc88cf1ed
  else
    homebrew_package
  fi
  # sudo first, whoever the account is (one sudo lets in installs it, an administrator or not; no prompt when none is
  # needed). When it does not (a clean Mac: an administrator who gave no password was sent to brew.sh): not an
  # administrator, today's lines; this Mac's sudo settings refusing the account, said as that (sudo's own fixed line, the
  # only thing that tells it from a password: its exit is the same); else the password. sudo's own lines stay on screen.
  local said; said="$(mktemp)"
  if ! sudo -n true 2>/dev/null && ! { sudo -v 2>&1 1>&3 3>&- | tee "$said" >&2; } 3>&1; then
    rm -f "$script"
    if [[ " $(id -Gn) " != *" admin "* ]]; then
      echo "Homebrew did not install (it needs an administrator account on this Mac). Install it from https://brew.sh,"
      echo "then run ./vx up again."
    elif grep -qF -e "may not run sudo" -e "is not in the sudoers file" "$said"; then
      echo "Homebrew did not install: this Mac's settings do not let this account use sudo, which Homebrew needs. Whoever"
      echo "manages this Mac can allow it; then run ./vx up again."
    else
      echo "Homebrew did not install: this Mac's password was not given, or did not work (it is the one you log in with)."
      echo "Run ./vx up again."
    fi
    rm -f "$said"; exit 1
  fi
  rm -f "$said"
  local installed=0
  if [ -n "$script" ]; then
    NONINTERACTIVE=1 /bin/bash "$script" || installed=$?
  else
    sudo /usr/sbin/installer -pkg "$LOGS/Homebrew.pkg" -target / || installed=$?
  fi
  if [ "$installed" != 0 ]; then
    rm -f "$script"
    echo "Homebrew did not install (it needs an administrator account on this Mac). Install it from https://brew.sh,"
    echo "then run ./vx up again."; exit 1
  fi
  rm -f "$script"
  for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do [ -x "$b" ] && { eval "$("$b" shellenv)"; break; }; done
  command -v brew >/dev/null || unfinished "Homebrew"
}

homebrew_package() {
  local pkg="$LOGS/Homebrew.pkg" version=7.0.15
  local checksum=af0827528fda9e8b653ac57815e1a003af588b7153749e8eb23d474afc60976c
  fetch "$pkg" "https://github.com/Homebrew/brew/releases/download/$version/Homebrew.pkg" "the system tools" "$checksum"
  pkgutil --check-signature "$pkg" >>"$LOGS/setup.log" 2>&1 || download_failed "The system tools"
}

brewed() {  # the tools this Mac lacks, installed with Homebrew (nothing to choose or configure): the one part of setup
  # that may need Terminal, for Homebrew itself and this Mac's password
  local need="" pair
  for pair in uv:uv pnpm:pnpm npm:node python3:python livekit-server:livekit whisper-server:whisper.cpp \
      ffmpeg:ffmpeg rg:ripgrep git:git; do
    if [ "${STT:-}" != whisper_local ] && [ "$pair" = whisper-server:whisper.cpp ]; then continue; fi
    tool_ready "${pair%%:*}" || need="$need ${pair##*:}"
  done
  if [ -n "$need" ]; then
    command -v brew >/dev/null || homebrew
    # (never a question, never a wait on a terminal: Homebrew 7 asks y/n in one by default, and Terminal waited on it;
    # HOMEBREW_NO_ASK is its own switch, ignored by an older one)
    progress "the system tools"
    echo "Installing:$need"
    if ! HOMEBREW_NO_ASK=1 brew install $need </dev/null 2>>"$LOGS/setup.log"; then
      download_failed "Installing$need"
    fi
  fi
  hash -r  # discard any system stub cached before Homebrew installed its tools
}

hand_off() {  # the first run, started in Terminal: once what needs Terminal is done (Homebrew and
  # this Mac's password), the app takes over in its own window and Terminal can close (Terminal only for what
  # truly needs it). Anywhere else (the app, the keeper, a script, a set-up Mac) this does nothing.
  [ -t 0 ] && [ -t 1 ] && [ -z "${VX_FROM_APP:-}${VX_KEEPING:-}${VX_APP:-}" ] && [ "${VX_NO_OPEN:-}" != 1 ] || return 0
  [ ! -f "$LOGS/.setup-done" ] || return 0
  [ -z "${RELEASE:-}" ] || return 0
  helper >>"$LOGS/menubar-build.log" 2>&1 || return 0  # (it cannot be built: setup goes on here, as before)
  [ -x "$APP/Contents/MacOS/Viventium" ] || return 0
  open "$APP" || return 0  # (it cannot open: setup goes on here, still holding the lock)
  rm -rf "$LOGS/up.lock"  # (the app's own start takes it once this one has let go)
  echo "Viventium AI goes on in its own window. You can close Terminal."
  exit 0
}

voice_files() {
  # Unknown custom models need a reviewed manifest entry; never silently fetch main.
  if [ "${TTS_MODEL:-mlx-community/chatterbox-turbo-8bit}" != mlx-community/chatterbox-turbo-8bit ]; then
    echo "This voice has no verified download yet. Choose Chatterbox in Settings."
    exit 1
  fi
  python3 "$ROOT/core/downloads.py" voice 2>>"$LOGS/setup.log" || download_failed "Her voice"
}

harnesses() {  # her Workers' harnesses, when this Mac has none: into Light's own tools/, never globally (main uses the
  # global ones). Light's PATH finds them there. (Before a first sign-in can be asked: sign_in.)
  python3 "$ROOT/core/downloads.py" harnesses 2>>"$LOGS/setup.log" || download_failed "The Workers' tools"
}

xperfect_patches() {  # Peel later patches on a private copy, so overlap cannot hide an earlier patch.
  python3 - "$ROOT/brain/patches" "${1:-$ROOT/brain/xperfect}" <<'EOF'
import os, shutil, subprocess, sys, tempfile
from pathlib import Path

patches = sorted(Path(sys.argv[1]).glob("xperfect-*.patch"))
xp = Path(sys.argv[2]).resolve()

def apply(where, *args, check=True):
    return subprocess.run(["git", "-C", str(where), "apply", *map(str, args)],
                          env={**os.environ, "GIT_CEILING_DIRECTORIES": str(where.parent)},
                          capture_output=True, check=check)

try:
    with tempfile.TemporaryDirectory(prefix="vx-patches-") as folder:
        probe = Path(folder)
        # Only patched files: never copy an installed environment, state or credentials.
        paths = set()
        for patch in patches:
            for entry in apply(xp, "--numstat", "-z", patch).stdout.split(b"\0"):
                if entry:
                    paths.add(os.fsdecode(entry.split(b"\t", 2)[2]))
        for name in paths:
            source, target = xp / name, probe / name
            if source.exists() or source.is_symlink():
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(source, target, follow_symlinks=False)
        present = []
        for patch in reversed(patches):
            present.append(apply(probe, "--reverse", "--whitespace=nowarn", patch, check=False).returncode == 0)
        present.reverse()
        if present != sorted(present, reverse=True):
            sys.exit("  The Workers' patches are out of order; their files were left unchanged.")
        # Prove the whole series before changing the install; do not mistake a conflict for an applied patch.
        for patch in patches:
            apply(probe, "--whitespace=nowarn", patch)
        for patch, installed in zip(patches, present):
            if not installed:
                apply(xp, "--whitespace=nowarn", patch)
except subprocess.CalledProcessError as error:
    sys.exit(f"  The Workers' patches could not be prepared: {error.stderr.decode(errors='replace').strip()}")
EOF
}

prepare_xperfect() {
  local xp="$ROOT/brain/xperfect"
  if [ -f "$ROOT/brain/xperfect.pin" ]; then
    install_pinned_xperfect || download_failed "The Workers' manager"
  elif [ ! -f "$xp/xperfect" ]; then
    progress "the Workers' manager"
    fetching "her Workers' manager" git -C "$ROOT" submodule update --init brain/xperfect
  fi
  xperfect_patches || exit 1
  if ! python3 "$ROOT/core/downloads.py" xperfect >>"$LOGS/setup.log" 2>&1; then
    echo "The Workers' files do not match this release. Keep this copy and install a fresh copy of Light."
    exit 1
  fi
}

install_pinned_xperfect() (
  local xp="$ROOT/brain/xperfect" pin stage checksum checked_pin archive
  [ -x "$xp/xperfect" ] && return 0
  pin=$(cat "$ROOT/brain/xperfect.pin")
  [[ "$pin" =~ ^[0-9a-f]{40}$ ]] || exit 1
  read -r checked_pin checksum <"$ROOT/brain/xperfect.archive.sha256.txt"
  [ "$checked_pin" = "$pin" ] && [[ "$checksum" =~ ^[0-9a-f]{64}$ ]] || exit 1
  archive="$LOGS/xperfect-$pin.tgz"
  fetch "$archive" "https://codeload.github.com/xPerfectAI/xPerfect/tar.gz/$pin" "the Workers' manager" "$checksum"
  stage=$(mktemp -d "$ROOT/brain/.xperfect.XXXXXXXX")
  trap 'rm -rf "$stage"' EXIT
  tar -xz -f "$archive" --strip-components 1 -C "$stage" || exit 1
  [ -x "$stage/xperfect" ] || exit 1
  xperfect_patches "$stage" || exit 1
  [ ! -e "$xp" ] && mv "$stage" "$xp" && rm -f "$archive"
)

install_ollama() (
  local destination archive stage
  destination=$(dirname "$OLLAMA_BIN")
  archive="$destination.tgz"
  fetch "$archive" "https://github.com/ollama/ollama/releases/download/v$OLLAMA_VERSION/ollama-darwin.tgz" \
    "the model server" 607c79d5d6315ef9d896db83adde736a4c0057196329843544e79b95afb260a8
  stage=$(mktemp -d "$destination.part.XXXXXX")
  trap 'rm -rf "$stage"' EXIT
  tar -xz -f "$archive" -C "$stage" && [ -x "$stage/ollama" ] || download_failed "The model server"
  rm -rf "$destination"
  mv "$stage" "$destination"
  rm -f "$archive"
)

grok_harness() {
  [ "${WORKER_GROK_SIGN_IN:-}" = 1 ] || return 0
  local into="$ROOT/tools/grok-build" version expected actual staged binary packed
  read -r version expected < <(python3 -c 'import json, platform, sys
pin = json.load(open(sys.argv[1]))
print(pin["version"], pin["sha256"][platform.machine()])' "$ROOT/tools/grok-build-pin.json") || return 1
  if [ -x "$into/grok" ] && [ ! -L "$into/grok" ]; then
    actual=$(shasum -a 256 "$into/grok") || return 1
    [ "${actual%% *}" != "$expected" ] || return 0
  fi
  progress "Grok Build"
  mkdir -p "$into" || return 1
  staged=$(mktemp -d "$into/.install.XXXXXX") || return 1
  # (the package ships its program brotli-packed in its platform part and unpacks it in an install script, which is
  # never run here: it is unpacked here instead, then checked against the pin. On a clean Mac, without this, a new
  # Grok-only install stopped at "could not be verified")
  binary="$staged/grok"
  packed="$staged/node_modules/@xai-official/grok-darwin-$( [ "$(uname -m)" = arm64 ] && echo arm64 || echo x64 )/bin/grok.br"
  if fetching "Grok Build" npm install --prefix "$staged" --ignore-scripts --no-save --package-lock=false "@xai-official/grok@$version" --no-audit --no-fund --silent \
      && [ -f "$packed" ] && node -e 'const z = require("zlib"), f = require("fs");
f.writeFileSync(process.argv[2], z.brotliDecompressSync(f.readFileSync(process.argv[1])), {mode: 0o755})' "$packed" "$binary" \
      && [ -x "$binary" ] && actual=$(shasum -a 256 "$binary") && [ "${actual%% *}" = "$expected" ] \
      && [ ! -d "$into/grok" ] && mv -f "$binary" "$into/grok"; then
    rm -rf "$staged"
    return 0
  fi
  rm -rf "$staged"
  echo "Grok Build could not be verified." >&2
  blocked failed "Grok Build could not be verified. Try again."
  return 1
}

setup() {  # idempotent: install what's missing, create private xPerfect states
  brewed
  harnesses
  [ -d "/Applications/Google Chrome.app" ] || echo "  note: her Workers browse the web in your Google Chrome; install it (google.com/chrome) for web tasks."
  if [ ! -x "$OLLAMA_BIN" ] && [ "${MEMORY_EMBED:-}" != off ]; then install_ollama; fi
  echo "Setting up (a few minutes the first time)…"
  progress "Viventium's parts"
  fetching "her Python parts" sh -c 'cd "$1" && uv sync --locked --group test --quiet' sh "$ROOT"
  if [ "${1:-}" != background ] && { [ "${STT:-off}" != off ] || [ "${STT_AUTO:-}" = 1 ]; }; then
    python3 "$ROOT/core/downloads.py" hearing || download_failed "Hearing"
  fi
  if [ -z "${SMALL_MAC_TIER:-}" ] || local_voice; then
    progress "the voice"
    fetching "her voice's parts" sh -c 'cd "$1/speech/tts" && uv sync --locked --quiet' sh "$ROOT"
    if [ "${1:-}" != background ]; then voice_files; fi
  fi
  progress "the page"
  fetching "her page's parts" pnpm --dir "$ROOT/call/ui" install --frozen-lockfile --silent
  # (no LiveKit key here: ./vx gives the page Light's own from the Keychain, in its environment; an older file loses
  # the published sample pair it was made with, and nothing else)
  if [ -f "$ROOT/call/ui/.env.local" ]; then sed -i '' -e '/^LIVEKIT_API_KEY=devkey$/d' -e '/^LIVEKIT_API_SECRET=secret$/d' "$ROOT/call/ui/.env.local"; \
  else printf 'LIVEKIT_URL=ws://127.0.0.1:7880\nAGENT_NAME=\n' > "$ROOT/call/ui/.env.local"; fi
  prepare_xperfect
  for kind in local cloud; do
    state="$ROOT/brain/state-$kind"
    [ -f "$state/config.json" ] && continue
    "$ROOT/brain/xperfect/xperfect" doctor --state-dir "$state" --api-port "$(xp_ports "$state" api)" --ui-port "$(xp_ports "$state" ui)" \
      --mcp-port "$(xp_ports "$state" mcp)" >/dev/null 2>&1 || true
    python3 - "$state/config.json" "$kind" "$ROOT" <<'EOF'
import json, os, sys
path, kind, root = sys.argv[1:]
c = json.load(open(path))
c["env"].update({"WPR_CODEX_CLI_REASONING_EFFORT": "high", "WPR_CLAUDE_CODE_EFFORT": "high",
                 # Claude Code Workers never change this Mac's security (brain/patches/xperfect-0002)
                 "WPR_CLAUDE_CODE_DENY": json.dumps(["Bash(sudo *)", "Bash(spctl *)", "Bash(csrutil *)", "Bash(tccutil *)", "Bash(systemsetup *)", "Bash(fdesetup *)", "Bash(pfctl *)", "Bash(nvram *)", "Bash(dscl *)", "Bash(security delete-*)", "Bash(security add-trusted-cert *)", "Bash(defaults write /Library/*)", "Bash(launchctl bootout *)"])})
if kind == "local":  # Workers on the local Qwen, through this project's own Codex home
    c["env"].update({"CODEX_HOME": f"{root}/brain/codex-home-local",
                     "WPR_CLAUDE_CODE_BASE_URL": "http://127.0.0.1:11436", "WPR_CLAUDE_CODE_AUTH_TOKEN": "ollama-local",
                     "WPR_CLAUDE_CODE_MAX_CONTEXT_TOKENS": "65536",  # = OLLAMA_CONTEXT_LENGTH: compact before it
                     # Built-in tools a local Worker never needs leave its prompt (31k -> 17k tokens, prefill
                     # 21 s -> 10 s on the local model); web search needs Anthropic's servers anyway.
                     "WPR_CLAUDE_CODE_DENY": json.dumps(json.loads(c["env"]["WPR_CLAUDE_CODE_DENY"]) + ["Task", "CronCreate", "CronDelete", "CronList", "DesignSync", "EnterWorktree", "ExitWorktree", "ListAgents", "NotebookEdit", "ReportFindings", "ScheduleWakeup", "SendMessage", "Skill", "TaskStop", "WebFetch", "WebSearch", "Workflow"])})
    c["models"] = {"codex-cli": "qwen3.6:latest", "claude-code": "qwen3.6:latest"}
else:                # Workers on your own Codex / Claude Code sign-ins
    c["models"] = {"codex-cli": "gpt-6.1-sol", "claude-code": "claude-opus-5-5"}
with open(path + ".tmp", "w", opener=lambda p, f: os.open(p, f, 0o600)) as h:
    json.dump(c, h, indent=2); h.write("\n")
os.replace(path + ".tmp", path)
EOF
    (umask 077; python3 -c "import secrets; print(secrets.token_urlsafe(18))" > "$state/unlock-password")
  done
  if [ -n "${SMALL_MAC_TIER:-}" ]; then touch "$LOGS/.setup-done.$PROFILE"
  else touch "$LOGS/.setup-done.local" "$LOGS/.setup-done.hybrid" "$LOGS/.setup-done.cloud"; fi
  printf 'profiles\n' > "$LOGS/.setup-done"
  echo "Setup done."
}

case "${1:-}" in
  setup-catalog) PYTHONDONTWRITEBYTECODE=1 "$ROOT/.venv/bin/python" -c 'import json; from settings.catalog import setup_accounts; print(json.dumps(setup_accounts()))' ;;
  setup-hearing) load_profile "${2:?}" check running; prepare_hearing ;;
  setup-memory) load_profile "${2:?}" check running
    serve_embed background
    start life-index - "$ROOT/.venv/bin/python" -m core.memory refresh ;;
  tools-ready)
    [ "${2:-}" = tools ] && [ -x /opt/homebrew/bin/brew ] && pkgutil --pkg-info sh.brew.homebrew >/dev/null 2>&1 ;;
  setup-accounts) load_profile "$(cat "$LOGS/profile" 2>/dev/null || echo local)" assess
    (cd "$ROOT" && "$ROOT/.venv/bin/python" -m settings setup-accounts) ;;
  setup) load_profile "$(cat "$LOGS/profile" 2>/dev/null || echo local)" check
    migrate_setup_marker; shared record; trap 'shared check' EXIT; setup ;;
  up) up "${2:-}" ;;  # (no profile: the one she last ran; on the first run, Local or Hybrid: first_choice)
  telegram) load_profile "$(cat "$LOGS/profile" 2>/dev/null || echo local)"; telegram ;;
  down) touch "$LOGS/stopped"; resting; down ;;
  keep) keep "${2:-}" ;;
  autostart) autostart "${2:-}" ;;
  menubar) menubar "${2:-}" ;;
  app) helper build && echo "Viventium AI: $APP (open it from Applications, Launchpad or Spotlight)" ;;
  life) load_profile "$(cat "$LOGS/profile" 2>/dev/null || echo local)" check; echo "$LIFE" ;;
  preflight) load_profile "${2:-local}" assess; preflight; echo "Profile: $PROFILE." ;;
  ready) load_profile "${2:-$(cat "$LOGS/profile" 2>/dev/null || echo local)}" check; preflight
    require_small_mac_sign_in </dev/null; ask_keys </dev/null; sign_in </dev/null
    # An online mind is asked for a word first: a key that exists can still be refused, or point at the wrong place. Only a
    # definite failure refuses (mind_answers check): no answer in time is the start's to ask again at its gate.
    if [ "$QUEEN" != ollama ] && [ -x "$ROOT/.venv/bin/python" ]; then mind_answers check || exit 1; fi
    echo "Ready: $PROFILE can start on this Mac." ;;
  restart) restart "${2:-}" ;;
  status) status ;;
  doors-off) stop_doors ;;  # (Settings turned calling from the phone off: its doors close now, with no restart)
  backup) case "${2:-save}" in  # core/backup.py
      save|list) (cd "$ROOT" && "$ROOT/.venv/bin/python" -m core.backup "${2:-save}") ;;
      *) echo "./vx backup        make one"; echo "./vx backup list   see them"; echo "./vx restore [name]" ;;
    esac ;;
  restore)  # put a backup back: only while nothing of hers is running (a running part would write over it)
    if starting || running agent || running chat || running clock || nc -z 127.0.0.1 "$UI_PORT" 2>/dev/null; then
      echo "Stop Viventium first (./vx down), then run this again: a running part would write over what is restored."; exit 1
    fi
    (cd "$ROOT" && "$ROOT/.venv/bin/python" -m core.backup restore "${@:2}") || exit $?
    # Calls from a phone: off until it is paired on this Mac again (the doors' keys and a pairing never travel in a backup).
    (cd "$ROOT" && "$ROOT/.venv/bin/python" -m settings phone-off) || true
    # What a backup never holds (a key, a sign-in, a bot, a paired phone): said once, for the profile just restored.
    load_profile "$(cat "$LOGS/profile" 2>/dev/null || echo local)" check
    (cd "$ROOT" && "$ROOT/.venv/bin/python" -m core.doctor --reconnect) ;;
  doctor) doctor ;;
  agent-again) shift; load_profile "$(cat "$LOGS/profile" 2>/dev/null || echo local)" check  # (tests: her agent restarts as
    stop agent; : > "$LOGS/agent.log"; start_agent "$@" ;;                                    # given, and nobody waits for it)
  settings) shift
    if restore_pending; then
      (cd "$ROOT" && "$ROOT/.venv/bin/python" -m core.backup status)
    else
      load_profile "$(cat "$LOGS/profile" 2>/dev/null || echo local)" check
      (cd "$ROOT" && "$ROOT/.venv/bin/python" -m settings "$@")
    fi ;;
  subscriptions) subscriptions "${2:-}" ;;
  first-run-key) load_profile "$(cat "$LOGS/profile" 2>/dev/null || echo local)" assess
    (cd "$ROOT" && "$ROOT/.venv/bin/python" -m settings first-run-key "${2:-OPENAI_API_KEY}") ;;
  install) "$ROOT/.venv/bin/python" -m settings install "${2:-}" ;;  # one thing this Mac lacks (a photo, video or language model, a provider's tool): settings/install.py
  test) shift; load_profile "$(cat "$LOGS/profile" 2>/dev/null || echo local)"; sound_check; bench_test "$@" ;;
  scorecard) shift; load_profile "$(cat "$LOGS/profile" 2>/dev/null || echo local)"; "$ROOT/.venv/bin/python" tests/scorecard.py "$@" ;;
  test-telegram) shift; load_profile "$(cat "$LOGS/profile" 2>/dev/null || echo local)"
    TEST_TELEGRAM=1 test_life tests/telegram_test.py "$@" ;;  # (it runs the channel itself)
  test-sound) shift; load_profile "$(cat "$LOGS/profile" 2>/dev/null || echo local)"; load_keys
    # (no Life: the test reads none, and his real one, which the profile names, makes every test refuse to run)
    sound_check && shared record && env -u LIFE "$ROOT/.venv/bin/python" tests/sound_test.py "$@"; shared check ;;
  sounds) load_profile "$(cat "$LOGS/profile" 2>/dev/null || echo local)"; load_keys; sound_check
    (cd "$ROOT" && "$ROOT/.venv/bin/python" -m speech.sounds build) ;;
  samples) shift; load_profile "$(cat "$LOGS/profile" 2>/dev/null || echo local)" check; load_keys
    (cd "$ROOT" && "$ROOT/.venv/bin/python" -m settings sample "$@") ;;
  *) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0" ;;  # (the lines at the top of this file)
esac
