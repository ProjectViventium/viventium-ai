#!/usr/bin/env bash
# Viventium AI: one command to talk to her.
#   ./vx up [local|hybrid|cloud]  start her and open the call page (no profile: the one she last ran; local
#                           the first time). The first run installs what this Mac is missing; a cloud
#                           profile asks once for any key it needs
#   ./vx telegram           talk on Telegram too: connect your own bot (asks for its token once)
#   ./vx down               stop everything this project started
#   ./vx restart [profile]  down, then up (checked first: nothing stops if the profile cannot start)
#   ./vx ready [profile]    can this profile start here? Says what is missing; changes nothing
#   ./vx preflight [profile]  assess memory and free space before any sign-in
#   ./vx status             what is running
#   ./vx doctor             what is wrong, in plain words, and what to do about it
#   ./vx backup             keep what makes her yours (state and private settings) outside this folder, checked;
#                           ./vx restore [name] puts one back (./vx backup list shows them)
#   ./vx install NAME       get a model or tool this Mac lacks (what "Install" on the settings page does)
#   ./vx autostart on|off   start her at login; any part that stops comes back within 2 minutes
#   ./vx menubar on|off     her mark in the menu bar (on unless switched off): her ears, eyes, Wing, Listen, where she runs
#   ./vx subscriptions [name] the subscriptions this Mac can sign in to, or one's own sign-in started (the app's logos)
#   ./vx app                the app "Viventium AI" in Applications, made new if its source changed (./vx up does too)
#   ./vx test [scenario|all] real-browser call tests (synthetic voice); flags double speech, latencies
#   ./vx test-telegram      the Telegram channel end to end (scripted incoming messages, real replies)
#   ./vx test-sound         her voice's laughs, sighs and gasps, measured on the profile's own voice
#   ./vx sounds             keep checked laughs, sighs and gasps for the profile's voice (another TTS_VOICE)
#   ./vx samples [voice]    record each voice saying one line, for the settings page's play buttons
#   ./vx scorecard          the product metric, measured (quality, performance, activation, secure)
set -euo pipefail
clean_start() {  # her parts start from what a fresh login gives them, whoever runs this: a terminal, an AI session,
  # a script. Only these names pass, and the VX_* and LIFE a caller sets on purpose; her own settings come from her
  # profile and the Keychain. (Otherwise a calling session's CLAUDECODE, CLAUDE_CODE_*, CODEX_* and ANTHROPIC_BASE_URL,
  # or a test's dead EMBED_URL, reach her agent and xPerfect through a ./vx restart run from inside it.)
  [ -n "${VX_CLEAN_ENV:-}" ] && return 0
  local keep=(VX_CLEAN_ENV=1) name
  for name in HOME USER LOGNAME SHELL TMPDIR LANG LC_ALL LC_CTYPE TERM PATH; do
    [ -n "${!name:-}" ] && keep+=("$name=${!name}")
  done
  for name in $(compgen -e); do
    case "$name" in VX_*|LIFE) keep+=("$name=${!name}") ;; esac
  done
  exec env -i "${keep[@]}" "$BASH" "$0" "$@"
}
if [ "${BASH_SOURCE[0]}" = "$0" ]; then clean_start "$@"; fi  # (run as a command; a script that sources vx for its parts
#  keeps its own environment)
ROOT="$(cd "$(dirname "$0")" && pwd)"
LOGS="$ROOT/logs"; mkdir -p -m 700 "$LOGS"  # (her logs are his alone: core/state.py)
RELEASE=""
[ ! -s "$ROOT/.vx-release" ] || RELEASE=$(cat "$ROOT/.vx-release")
unset LK_KEY LK_SECRET PHONE_SECRET  # (Light's own secrets: read from the Keychain by this run, never inherited)
export PATH="$ROOT/tools/grok-build:$ROOT/tools/harnesses/bin:$ROOT/tools/node_modules/.bin:$PATH"  # (this project's CLIs)
# Keep established developer paths. A stock Mac must find Homebrew before Apple's installer stubs.
if ! xcode-select -p >/dev/null 2>&1; then
  export PATH="$ROOT/tools/grok-build:$ROOT/tools/harnesses/bin:$ROOT/tools/node_modules/.bin:$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:$PATH"
fi
BOOT=$(sysctl -n kern.boottime | sed -E 's/^[{] sec = ([0-9]+).*/\1/')  # a pid or lock from before it is stale
UI_PORT=3400
# Light's own Ollama for its private model servers (the system one, shared with Viventium, is left
# alone). 0.40 runs qwen3.6 about twice as fast to the first word as 0.31, and runs Qwen3.8.
OLLAMA_VERSION=0.40.15
OLLAMA_BIN="$HOME/.cache/viventium-light/ollama-$OLLAMA_VERSION/ollama"

xp_ports() {  # xp_ports STATE [api|ui|mcp]: an xPerfect state's own ports, so two can run side by side
  local api=8866 ui=8880 mcp=8867
  case "$1" in *state-local) api=8876; ui=8890; mcp=8877 ;; esac  # (the Workers on this Mac)
  case "${2:-}" in api) echo $api ;; ui) echo $ui ;; mcp) echo $mcp ;; *) echo "$api $ui $mcp" ;; esac
}

small_mac_profile() {
  local bytes
  bytes=$(sysctl -n hw.memsize 2>/dev/null) || return 0
  case "$bytes" in ''|*[!0-9]*) return 0 ;; esac
  [ "$bytes" -gt 0 ] || return 0
  local name memory setup model previous=small-8
  while read -r name memory setup model; do
    case "$name" in small-*|local) ;; *) continue ;; esac
    if [ "$bytes" -lt $((memory * 1073741824)) ]; then echo "$previous"; return 0; fi
    [ "$name" != local ] || return 0
    previous=$name
  done < "$ROOT/profiles/resources.tsv"
}

load_profile() {
  if restore_pending; then
    echo "An interrupted restore is pending. Start Viventium to recover it first."; exit 1
  fi
  local profile="${1:-local}" small
  if [ "${3:-}" != running ]; then
    small=$(small_mac_profile)
    if [ -n "$small" ]; then profile="$small"
    else case "$profile" in small-8|small-16|small-24) profile=local ;; esac; fi
  fi
  [ -f "$ROOT/profiles/$profile.env" ] || { echo "No profile: $profile (local, hybrid or cloud)"; exit 1; }
  # (never left over from a profile loaded before: the first run promoted from Local to Hybrid sent her online
  # mind to Local's own model server; a profile that names its own address or tier still sets it below)
  unset WORKERS_LOCAL XPERFECT_LOCAL_STATE XPERFECT_LOCAL_API QUEEN_URL QUEEN_TIER
  unset SMALL_MAC_TIER WORKERS_OPTIONAL LOCAL_CONTEXT MEMORY_EMBED MEMORY_CORTEX STT_AUTO TTS_FALLBACK
  unset WORKER_GROK_SIGN_IN
  unset QUEEN_FALLBACK_MODEL QUEEN_FALLBACK_URL MISSING_KEY
  unset HELPERS HELPERS_OPENAI_URL HELPERS_OPENAI_API_KEY_ITEM
  set -a; source "$ROOT/profiles/$profile.env"
  # Private, untracked: this Mac's settings for every profile (e.g. LIFE=/path/to/Life), then the
  # profile's own overrides (endpoints, key item names).
  if [ -f "$ROOT/profiles/machine.local.env" ]; then source "$ROOT/profiles/machine.local.env"; fi
  if [ -f "$ROOT/profiles/$profile.local.env" ]; then source "$ROOT/profiles/$profile.local.env"; fi
  # Calling from the phone turned off in Settings over a line of your own (VX_PHONE=off): off, whatever a file says.
  if [ "${VX_PHONE:-}" = off ]; then VX_LAN_ORIGIN="" VX_LAN_LIVEKIT_URL=""; fi
  # Her memory of you: your Viventium Life folder, read in place (where main Viventium keeps it too).
  LIFE="${LIFE:-$HOME/Documents/Viventium/Life}"
  set +a
  PROFILE="$profile"; export PROFILE
  [ "${2:-}" = assess ] || stand_in
  export XPERFECT_STATE="$ROOT/$XPERFECT_STATE"
  export XPERFECT_API="http://127.0.0.1:$(xp_ports "$XPERFECT_STATE" api)"
  export XCLOCK=on  # xPerfect keeps the time of her reminders (core/xclock.py; never from a test's own state)
  # Workers on this Mac beside online ones (WORKERS_LOCAL=also|first, from the settings page): xPerfect runs a
  # harness one way per instance, so theirs is a second xPerfect, on its own ports (brain/xperfect.py).
  if [ "${WORKERS:-}" = signed-in ] && [ -n "${WORKERS_LOCAL:-}" ]; then
    export XPERFECT_LOCAL_STATE="$ROOT/brain/state-local"
    export XPERFECT_LOCAL_API="http://127.0.0.1:$(xp_ports "$XPERFECT_LOCAL_STATE" api)"
  fi
  case "${2:-}" in check|assess) ;; *) migrate_setup_marker; echo "$profile" > "$LOGS/profile" ;; esac
}

restore_pending() {  # only the affected state is gated; an unrelated marker is left untouched
  local marker
  for marker in "${VX_LOGS:-$LOGS}"/restore-in-progress*.json; do
    if [ -e "$marker" ] || [ -L "$marker" ]; then
      local code=0
      (cd "$ROOT" && "$ROOT/.venv/bin/python" -m core.backup pending) || code=$?
      [ "$code" != 1 ]; return  # a broken guard also keeps normal writers stopped
    fi
  done
  return 1
}

KEYS="ASSEMBLYAI_API_KEY XAI_API_KEY OPENAI_API_KEY ANTHROPIC_API_KEY"
key_item() {  # the Keychain item a key lives in: KEY_ITEM if set, else Viventium's own name for it
  local item_var="${1}_ITEM"
  echo "${!item_var:-viventium/$(echo "${1%_API_KEY}" | tr 'A-Z' 'a-z' | sed 's/^xai$/x_ai/')_api_key}"
}

load_keys() {  # Keys for the part about to use them: environment first, else the macOS Keychain
  local key value
  for key in $KEYS; do
    if [[ " ${KEYS_OFF:-} " == *" $key "* ]] || [ -e "$LOGS/$key.off" ]; then unset "$key"; continue; fi
    if [ -z "${!key:-}" ] && value=$(security find-generic-password -s "$(key_item "$key")" -w 2>/dev/null); then
      export "$key=$value"
    fi
  done
  load_helper_key
}

load_helper_key() {  # Keep an OpenAI helper's private endpoint and its key together, even with another mind.
  local configured="${HELPERS:-}" pair=() line value
  unset HELPERS_OPENAI_API_KEY
  [[ ",${configured//[[:space:]]/}," == *,openai:*,* ]] || return 0
  [[ " ${KEYS_OFF:-} " == *" OPENAI_API_KEY "* ]] && return 0
  [ ! -e "$LOGS/OPENAI_API_KEY.off" ] || return 0
  if [ -z "${HELPERS_OPENAI_URL:-}${HELPERS_OPENAI_API_KEY_ITEM:-}" ] && [ "${QUEEN:-}" != openai ] &&
     { [ "${QUEEN_FALLBACK:-}" != openai ] || [ -z "${QUEEN_FALLBACK_URL:-}" ]; } &&
     { [ -f "$ROOT/profiles/cloud.local.env" ] || [ -f "$ROOT/profiles/machine.local.env" ]; }; then
    while IFS= read -r -d '' line; do pair+=("$line"); done < <(
      unset QUEEN_URL OPENAI_API_KEY_ITEM
      source "$ROOT/profiles/cloud.env" >/dev/null
      if [ -f "$ROOT/profiles/machine.local.env" ]; then source "$ROOT/profiles/machine.local.env" >/dev/null; fi
      if [ -f "$ROOT/profiles/cloud.local.env" ]; then source "$ROOT/profiles/cloud.local.env" >/dev/null; fi
      if [ "${QUEEN:-}" = openai ] && [ -n "${QUEEN_URL:-}" ]; then
        printf '%s\0%s\0' "$QUEEN_URL" "$(key_item OPENAI_API_KEY)"
      fi
    )
    if [ "${#pair[@]}" -eq 2 ]; then
      export HELPERS_OPENAI_URL="${pair[0]}" HELPERS_OPENAI_API_KEY_ITEM="${pair[1]}"
    fi
  fi
  if [ -n "${HELPERS_OPENAI_API_KEY_ITEM:-}" ] &&
     value=$(security find-generic-password -s "$HELPERS_OPENAI_API_KEY_ITEM" -w 2>/dev/null); then
    export HELPERS_OPENAI_API_KEY="$value"
  fi
}

mind_key() {  # the key her chosen online mind needs (none for this Mac's model); for your Grok subscription, Light's own
  # sign-in (grok_mind: core/grok_sign_in), which stands where a key would: turned off the same way, its backup the same
  case "${QUEEN:-}" in openai) echo OPENAI_API_KEY ;; anthropic) echo ANTHROPIC_API_KEY ;; xai) echo XAI_API_KEY ;;
    xai_plan) echo grok_mind ;; chatgpt_plan) echo chatgpt_mind ;; *) return 1 ;; esac
}

have_key() {  # have_key NAME: Light has this key to use (environment or Keychain), and it is not one you turned off
  [[ " ${KEYS_OFF:-} " == *" $1 "* ]] && return 1
  [ ! -e "$LOGS/$1.off" ] || return 1
  if [ "$1" = grok_mind ]; then  # (Light's own sign-in: its Keychain item, read whole by core/grok_sign_in, never in the
    # environment; a test's stand-ins of xAI get a stand-in item of their own; the page's own switch off wins)
    (cd "$ROOT" && "$ROOT/.venv/bin/python" -m core.grok_sign_in status) >/dev/null 2>&1; return
  fi
  if [ "$1" = chatgpt_mind ]; then
    (cd "$ROOT" && "$ROOT/.venv/bin/python" -c 'from core.chatgpt_sign_in import connection; raise SystemExit(connection.status()["state"] not in ("connected", "limited", "unavailable", "refresh_unavailable", "unauthorized"))') >/dev/null 2>&1
    return
  fi
  [ -n "${!1:-}" ] || security find-generic-password -s "$(key_item "$1")" >/dev/null 2>&1
}

stand_in() {  # on a profile whose online parts may start on their declared backup (MISSING_KEY=backup: Hybrid, so one
  # subscription is enough), a mind whose key this Mac lacks (or that you turned off) runs as Local runs it, on
  # this Mac, warm on its own server (QUEEN_FALLBACK=local: the local profile's mind, as you set it there). Her voice's
  # backup speaks by itself (speech/factory.py) and her quick helpers fall back to this Mac (core/helpers.py). Nothing is
  # asked; Settings says what answers now. With the key, nothing changes.
  [ "${MISSING_KEY:-}" = backup ] && [ "${QUEEN_FALLBACK:-}" = local ] || return 0
  local key mind; key=$(mind_key) || return 0
  have_key "$key" && return 0
  mind=$(set -a; for f in "$ROOT/profiles/local.env" "$ROOT/profiles/machine.local.env" "$ROOT/profiles/local.local.env"; do
           if [ -f "$f" ]; then . "$f"; fi; done
         printf 'QUEEN=%q QUEEN_MODEL=%q QUEEN_URL=%q QUEEN_EFFORT=%q' "$QUEEN" "$QUEEN_MODEL" "${QUEEN_URL:-}" "${QUEEN_EFFORT:-}")
  eval "export $mind"
}

ask_keys() {  # each cloud key this profile uses and this Mac lacks: asked for once, kept in the Keychain
  local key name url keys=""
  if [ "$STT" = assemblyai ]; then keys="$keys ASSEMBLYAI_API_KEY"; fi
  if [ "$STT" = xai ]; then keys="$keys XAI_API_KEY"; fi
  if [ "$STT" = openai ] || [ "$TTS" = openai ]; then keys="$keys OPENAI_API_KEY"; fi
  # (a voice with a declared backup on this Mac, on a profile that lets it stand in: that backup speaks, nothing is asked)
  if [ "$TTS" = xai ] && { [ "${MISSING_KEY:-}" != backup ] || [ "${TTS_FALLBACK:-}" != mlx_local ]; }; then keys="$keys XAI_API_KEY"; fi
  if [ "$QUEEN" = xai ]; then keys="$keys XAI_API_KEY"; fi
  case "$QUEEN" in openai) keys="$keys OPENAI_API_KEY" ;; anthropic) keys="$keys ANTHROPIC_API_KEY" ;; esac
  # Her mind on your Grok subscription: Light's own sign-in, made once in your browser (no key to paste). On a profile
  # that lets its backup stand in (stand_in), nothing is asked: her backup answers until you sign in (Settings, System).
  if [ -z "${SMALL_MAC_TIER:-}" ] && [ "$QUEEN" = xai_plan ] && [[ " ${KEYS_OFF:-} " != *" grok_mind "* ]] && [ ! -e "$LOGS/grok_mind.off" ] && ! have_key grok_mind; then
    if [ ! -t 0 ]; then
      if [ -n "${VX_FROM_APP:-}" ]; then echo "$(place_name) needs your Grok sign-in. Sign in in Settings, or choose Local or Hybrid."; blocked signin
      else echo "The $PROFILE profile uses your Grok subscription. Run ./vx up $PROFILE in a terminal once to sign in."; fi
      exit 1
    fi
    echo "The $PROFILE profile uses your Grok subscription for its mind. Sign in once in your browser (kept only in this Mac's Keychain)."
    (cd "$ROOT" && "$ROOT/.venv/bin/python" -m core.grok_sign_in login) || exit 1
  fi
  for key in $keys; do
    if [[ " ${KEYS_OFF:-} " == *" $key "* ]] || [ -e "$LOGS/$key.off" ]; then continue; fi
    if [ -n "${!key:-}" ] || security find-generic-password -s "$(key_item "$key")" >/dev/null 2>&1; then continue; fi
    if [ -n "${SMALL_MAC_TIER:-}" ] && [ "${QUEEN_FALLBACK:-}" = openai ] \
        && [ "$key" = "$(mind_key)" ]; then
      if have_key OPENAI_API_KEY; then continue; fi
      if [ -n "${VX_FROM_APP:-}" ]; then
        echo "The current mind needs its key. Add an OpenAI key to use the backup."
        blocked small-key; exit 1
      fi
    fi
    case $key in
      ASSEMBLYAI_API_KEY) name=AssemblyAI url=https://www.assemblyai.com/dashboard/api-keys ;;
      XAI_API_KEY) name=xAI url=https://console.x.ai ;;
      OPENAI_API_KEY) name=OpenAI url=https://platform.openai.com/api-keys ;;
      ANTHROPIC_API_KEY) name=Anthropic url=https://console.anthropic.com/settings/keys ;;
    esac
    if [ ! -t 0 ]; then
      if [ -n "${VX_FROM_APP:-}" ]; then echo "$(place_name) needs your $name key. Add it in Settings, or choose Local or Hybrid."; blocked key
      else echo "The $PROFILE profile needs your $name key ($url). Run ./vx up $PROFILE in a terminal once to add it."; fi
      exit 1
    fi
    echo "The $PROFILE profile uses $name. Get a key at $url and paste it below, twice (hidden; kept only in this Mac's Keychain)."
    security add-generic-password -U -s "$(key_item "$key")" -a viventium-light -w || exit 1
  done
}

require_small_mac_sign_in() {
  [ -n "${SMALL_MAC_TIER:-}" ] && [ "$QUEEN" = xai_plan ] || return 0
  have_key grok_mind && return 0
  if [ "${QUEEN_FALLBACK:-}" = openai ] && have_key OPENAI_API_KEY; then return 0; fi
  # When explicitly turned off after setup, open Settings so the person can turn it on.
  if [ -f "$LOGS/.setup-done" ] && { [ -e "$LOGS/grok_mind.off" ] || [[ " ${KEYS_OFF:-} " == *" grok_mind "* ]]; }; then return 0; fi
  if [ -t 0 ] && [ -z "${VX_FROM_APP:-}" ]; then
    (cd "$ROOT" && "$ROOT/.venv/bin/python" -m core.grok_sign_in login)
    return
  fi
  echo "Sign in to Grok to start."
  if [ -n "${VX_FROM_APP:-}" ]; then blocked small-signin "$SMALL_MAC_TIER"; fi
  return 1
}

sign_in() {  # cloud Workers run on your own sign-ins (your Claude, ChatGPT or Grok plan), and one is enough:
  # the first of the ones this profile names (WORKER_PROFILE, then WORKER_FALLBACK, in order) that is signed in does the
  # work, and manages it unless the manager you chose is signed in itself. The order you chose comes back by itself at
  # the next start once the first is signed in.
  unset WORKER_SIGN_IN_REQUIRED
  [ "${WORKERS:-}" = signed-in ] || return 0
  local named other ready="" fallback="${WORKER_FALLBACK:-}" grok=""
  unset WORKER_GROK_SIGN_IN
  if have_key grok_mind; then grok=grok-build; export WORKER_GROK_SIGN_IN=1; fi
  named=$(printf '%s\n' "$WORKER_PROFILE" ${fallback//,/ } "$grok" |
    awk -v grok="$grok" 'NF && ($0 != "grok-build" || grok != "") && !seen[$0]++')
  for other in $named; do
    if [ "$other" = "$grok" ] || signed_in_now "$other"; then ready=$other; break; fi
  done
  if [ -z "$ready" ] && [ "${WORKERS_OPTIONAL:-}" = 1 ]; then
    export WORKER_SIGN_IN_REQUIRED=1
    return 0
  fi
  if [ "$ready" = grok-build ] && [ "${WORKERS_OPTIONAL:-}" = 1 ]; then
    # On a Grok-only install, the absent plans are not fallback routes.
    named=$(for other in $named; do
      if [ "$other" = "$grok" ] || signed_in_now "$other"; then echo "$other"; fi
    done)
  fi
  if [ -n "$ready" ] && [ "$ready" != "$WORKER_PROFILE" ]; then
    WORKER_PROFILE=$ready; export WORKER_PROFILE
    echo "  workers: on your $(harness_name "$ready") sign-in"
  fi
  if [ -n "$ready" ]; then
    WORKER_FALLBACK=$(printf '%s\n' $named | awk -v r="$ready" '$0 != r' | paste -sd , -)
    export WORKER_FALLBACK
  fi
  if [ -n "${MANAGER_PROFILE:-}" ] && [ "$MANAGER_PROFILE" != "$WORKER_PROFILE" ] && ! signed_in_now "$MANAGER_PROFILE"; then
    export MANAGER_PROFILE=""  # (unset: the first Worker's harness manages)
  fi
  signed_in "$WORKER_PROFILE" first
  fallback="${WORKER_FALLBACK:-}"
  for other in ${fallback//,/ }; do
    if [ "$other" != "$WORKER_PROFILE" ]; then signed_in "$other" backup; fi
  done
}

harness_name() { case "$1" in claude-code) echo Claude ;; grok-build) echo Grok ;; *) echo ChatGPT ;; esac; }  # (as Settings names them)

signed_in_now() {  # signed_in_now HARNESS: its own tool says it is signed in (nothing is said or asked)
  case "$1" in
    claude-code) claude auth status >/dev/null 2>&1 ;;
    grok-build) have_key grok_mind ;;
    codex-cli) codex login status >/dev/null 2>&1 ;;
    *) return 1 ;;
  esac
}

place_name() { echo "$PROFILE" | awk '{print toupper(substr($0, 1, 1)) substr($0, 2)}'; }  # (Local, Hybrid, Cloud)

blocked() {  # blocked KIND [AMOUNT]: why this start stopped, for the app to show its one way forward (logs/blocked, one
  # line: chip, memory GB, disk GB, signin, key, held, terminal, offline, or mind and what happened to it: mind_answers);
  # every start begins without one. Never fails.
  echo "$*" >"$LOGS/blocked" 2>/dev/null || true
}

signed_in() {  # signed_in HARNESS first|backup: the first choice must be signed in; a missing backup is only said
  local login="codex login" name=Codex cli=codex
  case "$1" in
    claude-code) login="claude auth login" name="Claude" cli=claude ;;
    grok-build)
      if have_key grok_mind; then return 0; fi
      if [ "$2" = backup ]; then return 0; fi
      echo "Sign in to Grok in Viventium AI to use its Worker."; blocked signin; exit 1 ;;
  esac
  if signed_in_now "$1"; then return 0; fi
  if [ "$2" = backup ]; then echo "  note: her Workers' backup, $name, is not signed in. Run '$login' once so it can take over."; return 0; fi
  if ! "$cli" --version >/dev/null 2>&1; then  # installed but not runnable is not a sign-in problem
    echo "$name is installed but can't run on this Mac right now ($(command -v "$cli" || echo "$cli")). If it came with an"
    echo "app (ChatGPT ships Codex), reopen or update that app; or set WORKER_PROFILE in profiles/$PROFILE.env."; exit 1
  fi
  if [ ! -t 0 ]; then
    if [ -n "${VX_FROM_APP:-}" ]; then  # (the app shows the sign-ins it can start, and starts her once one is made)
      local fallback="${WORKER_FALLBACK:-}"
      echo "$(place_name) needs your $(printf '%s\n' "$WORKER_PROFILE" ${fallback//,/ } | while read -r h; do harness_name "$h"; done \
        | awk '!seen[$0]++' | paste -sd '|' - | sed 's/|/ or /g') sign-in."; blocked signin
    else echo "Her Workers need your $name sign-in: run '$login' once."; fi
    exit 1
  fi
  echo "Its Workers use your own $name sign-in. A browser opens once to sign in."
  $login
}

model_present() {  # model_present NAME:TAG: in Ollama's model store on this Mac
  [ -f "${OLLAMA_MODELS:-$HOME/.ollama/models}/manifests/registry.ollama.ai/library/${1%%:*}/${1##*:}" ]
}

local_voice() { [ "$TTS" = mlx_local ] || [ "${TTS_FALLBACK:-}" = mlx_local ]; }  # in use, or the declared backup

small_voice() {
  [ "${STT_AUTO:-}" = 1 ] && [ "$STT" = off ] || return 0
  if have_key XAI_API_KEY; then export STT=xai TURN=stt
  elif have_key OPENAI_API_KEY; then export STT=openai TURN=""; fi
}

preflight() {  # preflight [up]: before anything starts or downloads, can this Mac hold her local models?
  local free model need name memory setup have mode=${1:-} model_gb=22 space="$LOGS/.space-asked.${PROFILE:-local}" legacy="$LOGS/.space-asked"
  # (one plain line each, and why for the app: logs/blocked. Every profile counts here, since each runs the same
  # model on this Mac as memory and as every online part's backup, and Hybrid on a subscription alone as her mind)
  if { local_voice || [ -n "${SMALL_MAC_TIER:-}" ]; } && [ "$(uname -m)" != arm64 ]; then
    echo "Viventium needs a Mac with Apple silicon (M1 or later)."; blocked chip; exit 1
  fi
  while read -r name memory setup model_gb; do
    [ "$name" != "${PROFILE:-local}" ] || break
  done < "$ROOT/profiles/resources.tsv"
  [ "$name" = "${PROFILE:-local}" ] || { echo "No resource budget for this profile."; exit 1; }
  have=$(sysctl -n hw.memsize 2>/dev/null) || have=""
  case "$have" in ''|*[!0-9]*) ;; *)
    if [ "$have" -gt 0 ] && [ "$have" -lt $((memory * 1073741824)) ]; then
      echo "This profile needs $memory GB of memory."
      if [ "${PROFILE:-local}" = small-8 ]; then echo "Use a Mac with Apple silicon and at least $memory GB of memory."
      else echo "Run ./vx up to use this Mac's supported profile. Sign in or add a key in Settings, System if asked."; fi
      blocked memory "$memory"; exit 1
    fi ;;
  esac
  if [ -n "${SMALL_MAC_TIER:-}" ]; then
    model="${MEMORY_MODEL:-}"
  else
    [ "$QUEEN" = ollama ] || [ "${WORKERS:-}" = local ] || [ -n "${WORKERS_LOCAL:-}" ] || [[ "${FEELINGS_URL:-}${MEMORY_URL:-}" == *:11436* ]] || return 0
    model="$(grep -m1 '^model *=' "$ROOT/brain/codex-home-local/config.template.toml" | cut -d'"' -f2)"
  fi
  # The space is asked for once, before the first download (measured on a clean Mac: 22 GB for her model,
  # 12 GB for the rest). A run that goes on after a dropped download already holds part of it, so it is not
  # asked again (a retry with 30 to 34 GB free stopped before resuming); a disk that fills up
  # meanwhile is told by the download that cannot finish (unfinished).
  need=0
  [ -f "$(setup_marker)" ] || need="$setup"
  if [ -n "$model" ] && ! model_present "$model"; then need=$(( need + model_gb )); fi
  if [ "$need" = 0 ]; then
    rm -f "$space"
    [ -n "${SMALL_MAC_TIER:-}" ] || rm -f "$legacy"
    return 0
  fi
  [ -f "$space" ] && return 0
  # Older builds shared this marker across full profiles, even before setup was complete.
  if [ -z "${SMALL_MAC_TIER:-}" ] && [ -f "$legacy" ]; then return 0; fi
  free=$(free_gb)
  if [ "$free" -le "$need" ]; then
    echo "Setting up needs about $(( need + 1 )) GB of free space. This Mac has $free GB: free up the rest and $(again)."
    blocked disk $(( need + 1 )); exit 1
  fi
  # (only the run that goes on to download records it: ./vx ready asks, and a later start asks again)
  [ "$mode" = up ] && touch "$space"
  return 0
}

free_gb() { echo $(( $(df -k "$HOME" | awk 'NR==2 {print $4}') / 1048576 )); }

again() {  # what goes on after a stop: the app tries again by itself or with its one button; a terminal runs vx again
  if [ -n "${VX_FROM_APP:-}" ]; then echo "it goes on by itself"; else echo "run ./vx up again"; fi
}

online() {  # this Mac reaches the internet now (where her downloads come from): asked of two hosts, a few seconds each
  curl -s -o /dev/null --max-time 6 -I https://huggingface.co 2>/dev/null || curl -s -o /dev/null --max-time 6 -I https://github.com 2>/dev/null
}

unfinished() {  # unfinished WHAT: a setup step or download did not finish. One plain line says what to do, never a
  # traceback or a silent exit; every step goes on from what is already here when ./vx up runs again.
  if [ "$(free_gb)" -lt 2 ]; then  # (how much the rest needs is not known here: 5 GB more free, and it goes on)
    if [ -n "${VX_FROM_APP:-}" ]; then echo "  $1: this Mac's disk is full. Free up some space: it goes on by itself."
    else echo "  $1: this Mac's disk is full. Free up some space and run ./vx up again: it goes on from where it stopped."; fi
    blocked disk $(( $(free_gb) + 5 ))
  elif ! online; then  # (no connection is a wait, not a failure; the app tries again by itself)
    if [ -n "${VX_FROM_APP:-}" ]; then echo "  This Mac is not online. It goes on by itself once it is."
    else echo "  $1 did not finish: this Mac is not online. Run ./vx up again once it is: it goes on from where it stopped."; fi
    blocked offline
  elif [ -n "${VX_FROM_APP:-}" ]; then
    echo "  $1 did not finish. Try again: it goes on from where it stopped."
  else
    echo "  $1 did not finish (what happened: logs/setup.log). Run ./vx up again: it goes on from where it stopped."
  fi
  exit 1
}

sha256() {
  [ -f "$1" ] && /usr/bin/openssl dgst -sha256 <"$1" | awk '{print $NF}'
}

fetch() {  # fetch FILE URL LABEL SHA256: keep the partial across attempts and restarts
  local file=$1 partial="$1.part" before after rc status misses=0
  if [ "$(sha256 "$file")" = "$4" ]; then return 0; fi
  progress "$3"
  mkdir -p "$(dirname "$file")"
  while [ "$misses" -lt 4 ]; do
    before=$(stat -f %z "$partial" 2>/dev/null || echo 0)
    rc=0
    # A fresh curl invocation recalculates the Range offset. Its built-in retry reuses the original offset.
    status=$(curl -qfsSL --connect-timeout 15 --speed-limit 1 --speed-time "${VX_DOWNLOAD_STALL:-30}" \
      -C - -o "$partial" -w '%{http_code}' "$2" 2>>"$LOGS/setup.log") || rc=$?
    after=$(stat -f %z "$partial" 2>/dev/null || echo 0)
    if [ "$rc" = 0 ] || { [ "$before" -gt 0 ] && { [ "$rc" = 33 ] || [ "$status" = 416 ]; }; }; then
      if [ "$(sha256 "$partial")" = "$4" ]; then
        mv -f "$partial" "$file"
        return $?
      fi
      # A digest mismatch or a rejected range needs a clean start. Never install these bytes.
      echo "Download did not verify: $(basename "$file") (curl $rc, HTTP $status)" >>"$LOGS/setup.log"
      rm -f "$partial"
      after=0
    else
      echo "Download interrupted: $(basename "$file") (curl $rc, HTTP $status, $after bytes kept)" >>"$LOGS/setup.log"
    fi
    [ "$(free_gb)" -ge 2 ] || break
    if [ "$after" -gt "$before" ]; then misses=0; else misses=$(( misses + 1 )); fi
    [ "$misses" -lt 4 ] && sleep $(( 2 ** misses ))
  done
  download_failed "$(basename "$file")"
}

download_failed() {
  if [ -n "${VX_FROM_APP:-}" ] && [ "$(free_gb)" -ge 2 ]; then
    echo "Download paused. Retrying…"
    blocked download
    exit 1
  fi
  unfinished "$1"
}

life_folder() {  # a Life folder that doesn't exist yet starts from main Viventium's template (never overwrites)
  [ -f "$LIFE/AGENTS.md" ] && return 0
  mkdir -p "$LIFE"; chmod 700 "$LIFE"; cp -Rn "$ROOT/life-template/" "$LIFE/" 2>/dev/null || true
  if [ -f "$LIFE/AGENTS.md" ]; then echo "  life: your Life folder is $LIFE (her memory of you; yours to read and add to)"
  else echo "  life: could not start a Life folder at $LIFE; she runs without memory of you"; fi
}

sound_check() {  # the AudioSet check her sound tests use (tools/soundcheck, ~0.8 GB once): installed when first needed
  [ -x "$ROOT/tools/soundcheck/.venv/bin/python" ] && return 0
  echo "  installing the sound check once (tools/soundcheck: an AudioSet classifier, about 0.8 GB)"
  (cd "$ROOT/tools/soundcheck" && uv venv -q --python 3.12 .venv && uv pip install -q --python .venv/bin/python -r requirements.txt)
}

shared() {  # shared record|check: the real files behind the Codex and Claude CLIs main Viventium also uses.
  # Light never changes them; it only records them and says loudly if one changed while it ran (a
  # shared CLI can lose its execute bit, and the cause may never be known).
  # A fresh Mac has neither program (there, the last test failing once ended ./vx up at once, with no
  # word, under set -e), and the copies setup installs into Light's own tools/ are Light's, never main's: neither is
  # flagged.
  local rec="$LOGS/shared-programs.txt" now own was
  own="$(cd "$ROOT" && pwd -P)/"
  now="$(for name in codex claude; do for p in "$(command -v "$name" 2>/dev/null || true)" "$HOME/.local/bin/$name"; do
           if [ -n "$p" ] && [ -e "$p" ]; then realpath "$p"; fi; done; done | sort -u | while read -r f; do
           if [ "${f#"$own"}" = "$f" ]; then stat -f '%Lp %i %N' "$f"; fi; done)"  # (no case here: macOS bash 3.2 ends $( at its ")")
  mkdir -p "$LOGS"
  if [ "$1" = record ]; then printf '%s\n' "$now" > "$rec"; return 0; fi
  [ -f "$rec" ] || return 0
  # (an older record can hold Light's own tools: read it the same way, so an upgrade is not a change)
  was="$(awk -v o=" $own" 'index($0, o) == 0' "$rec")"
  [ "$now" = "$was" ] && return 0
  echo "  !! A program main Viventium also uses changed while Light ran (Light leaves it as it is):"
  diff <(printf '%s\n' "$was") <(printf '%s\n' "$now") | sed -n 's/^< /     was: /p; s/^> /     now: /p'
  echo "     (mode, file id, path; a lost run permission comes back with: chmod 755 <path>)"
  printf '%s changed:\n%s\n' "$(date '+%F %T')" "$now" >> "$LOGS/shared.log"
  return 1
}

unload_keys() { unset ASSEMBLYAI_API_KEY XAI_API_KEY OPENAI_API_KEY HELPERS_OPENAI_API_KEY ANTHROPIC_API_KEY TELEGRAM_BOT_TOKEN; }

own_secret() {  # own_secret ITEM MAKE: Light's own secret in the Keychain item ITEM (account viventium-light), made
  # once by the Python expression MAKE and handed to security on its input, never its command line; prints what the
  # Keychain kept ("" when it would not), read back so two starts at once agree
  local value
  value=$(security find-generic-password -s "$1" -a viventium-light -w 2>/dev/null || true)
  if [ -z "$value" ]; then
    value=$(python3 -c "import secrets; print($2)")
    printf 'add-generic-password -s %s -a viventium-light -w %s\n' "$1" "$value" | security -i >/dev/null 2>&1 || true
    value=$(security find-generic-password -s "$1" -a viventium-light -w 2>/dev/null || true)
  fi
  printf '%s' "$value"
}

livekit_keys() {  # Light's own LiveKit key, made once on this Mac and kept only in its Keychain: sets LK_KEY and LK_SECRET
  # (not exported) for the three that use it, LiveKit, her agent and the call page, each given it in its environment
  # (never a file, a log or a command line). Read once per run: a restart checks it before anything stops, and the
  # rest of the run uses that checked pair. The published sample pair a profile may still name is dropped: without
  # its own key, nothing of the call starts or stops.
  unset LIVEKIT_API_KEY LIVEKIT_API_SECRET LIVEKIT_KEYS
  [[ "${LK_KEY:-}:${LK_SECRET:-}" =~ ^[A-Za-z0-9]+:[A-Za-z0-9]{32,}$ ]] && return 0
  local pair
  pair=$(own_secret viventium-light/livekit '"light" + secrets.token_hex(4) + ":" + secrets.token_hex(32)')
  if [[ ! "$pair" =~ ^[A-Za-z0-9]+:[A-Za-z0-9]{32,}$ ]]; then
    echo "Viventium could not keep its call key in this Mac's Keychain. Unlock the Keychain (allow it if asked), then run ./vx up again."
    exit 1
  fi
  LK_KEY="${pair%%:*}" LK_SECRET="${pair#*:}"
}

phone_key() {  # the secret his phone's pairing is signed with (call/ui/app/api/token/pairing.ts): made once and kept in
  # the Keychain, only when calling from his phone is on (VX_LAN_ORIGIN); given to the page in its environment
  PHONE_SECRET="${PHONE_SECRET:-}"
  [ -n "${VX_LAN_ORIGIN:-}" ] && [ -z "$PHONE_SECRET" ] || return 0
  PHONE_SECRET=$(own_secret viventium-light/phone-pairing 'secrets.token_hex(32)')
  if [[ ! "$PHONE_SECRET" =~ ^[0-9a-f]{64}$ ]]; then
    echo "Viventium could not keep the key that pairs your phone in this Mac's Keychain. Unlock the Keychain, then run ./vx up again."
    exit 1
  fi
}

own_folders() {  # her state and logs his alone (core/state.py), before anything of hers starts or stops: a folder that
  # cannot be (a link, his home or Life, a disk that will not keep it) stops this run, the reason said just above
  (cd "$ROOT" && "$ROOT/.venv/bin/python" -m core.state) && return 0
  echo "  Viventium's own folders could not be made private, so nothing was started or stopped."; exit 1
}

key_proof() {  # before "Ready": LiveKit lets a token on Light's own key in, and the page signs its tokens with it
  # (a part kept running from before could still hold another key). The secret goes in the environment only.
  LK_KEY="$LK_KEY" LK_SECRET="$LK_SECRET" UI_PORT="$UI_PORT" LIVEKIT_URL="${LIVEKIT_URL:-ws://127.0.0.1:7880}" \
    "$ROOT/.venv/bin/python" - <<'EOF'
import json, os, sys, urllib.request
import jwt
from livekit import api
key, secret = os.environ["LK_KEY"], os.environ["LK_SECRET"]
server = "http" + os.environ["LIVEKIT_URL"].removeprefix("ws")
page = f"http://127.0.0.1:{os.environ['UI_PORT']}"
try:
    token = api.AccessToken(key, secret).with_grants(api.VideoGrants(room_list=True)).to_jwt()
    urllib.request.urlopen(urllib.request.Request(f"{server}/twirp/livekit.RoomService/ListRooms", data=b"{}",
                           headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"}), timeout=10)
except Exception:
    sys.exit("  the call server does not take Light's own key")
try:
    reply = urllib.request.urlopen(urllib.request.Request(f"{page}/api/token", data=b"{}", headers={
        "Content-Type": "application/json", "Origin": page, "Sec-Fetch-Site": "same-origin"}), timeout=20)
    jwt.decode(json.load(reply)["participantToken"], secret, algorithms=["HS256"], options={"verify_aud": False})
except Exception:
    sys.exit("  the call page does not sign calls with Light's own key")
EOF
}

telegram_token() {  # Telegram bot token: environment first, else the Keychain item TELEGRAM_TOKEN_ITEM
  if [ -z "${TELEGRAM_BOT_TOKEN:-}" ] && value=$(security find-generic-password \
      -s "${TELEGRAM_TOKEN_ITEM:-viventium-light/telegram_bot_token}" -w 2>/dev/null); then
    export TELEGRAM_BOT_TOKEN="$value"
  fi
}

resting() {  # his own Quit (./vx down): his paired Telegram chat is told Viventium rests; never a restart (restart calls down)
  [ "${TELEGRAM:-on}" != off ] || return 0
  pgrep -f "$ROOT/.venv/bin/python chat/telegram.py" >/dev/null 2>&1 || return 0  # (no bot running: nobody was reached)
  ( telegram_token; [ -n "${TELEGRAM_BOT_TOKEN:-}" ] && cd "$ROOT" \
      && perl -e 'alarm shift; exec @ARGV' 10 "$ROOT/.venv/bin/python" chat/telegram.py --resting ) >/dev/null 2>&1 || true
}

started_at() { ps -o lstart= -p "$1" 2>/dev/null | tr -s ' ' | sed 's/ $//'; }  # when a process started (with its pid: which one)
xperfect_source_clean() (  # one pin, patch, file and Git-index verdict for status and startup
  python3 "$ROOT/core/downloads.py" xperfect --check --pin "$2"
)

source_identity() {  # commit and working tree at launch or build time, even in a linked worktree
  local dir=${1:-$ROOT} xp="$ROOT/brain/xperfect" prefix commit changes light pin state=clean
  if [ -n "${RELEASE:-}" ]; then
    if [ "$dir" = "$xp" ]; then
      if python3 "$ROOT/core/downloads.py" xperfect --check >/dev/null 2>&1; then state=packaged; else state=dirty; fi
      printf '%s %s\n' "$(cat "$ROOT/brain/xperfect.pin")" "$state"
    else printf '%s\n' "$RELEASE"; fi
    return
  fi
  if [ "$dir" = "$xp" ] && [ ! -e "$xp/.git" ]; then
    commit=$(git -C "$ROOT" rev-parse --verify HEAD:brain/xperfect) || { echo 'unknown unknown'; return; }
    if python3 "$ROOT/core/downloads.py" xperfect --check >/dev/null 2>&1; then state=clean; else state=dirty; fi
    echo "$commit $state"; return
  fi
  if ! prefix=$(git -C "$dir" rev-parse --show-prefix 2>/dev/null) || [ -n "$prefix" ] ||
     ! commit=$(git -C "$dir" rev-parse --verify HEAD 2>/dev/null); then
    echo 'unknown unknown'; return
  fi
  if [ "$dir" = "$xp" ]; then
    light=$(git -C "$ROOT" rev-parse --verify HEAD 2>/dev/null || true)
  else
    # Git still reports a changed gitlink. Check its working files separately against Light's patches.
    changes=$(git --no-optional-locks -C "$dir" -c submodule.brain/xperfect.ignore=dirty \
      status --porcelain --untracked-files=no 2>/dev/null) || { echo "$commit unknown"; return; }
    [ -z "$changes" ] || { echo "$commit dirty"; return; }
    light=$commit
  fi
  if [ "$dir" = "$ROOT" ] || [ "$dir" = "$xp" ]; then
    if pin=$(git -C "$ROOT" rev-parse --verify "$light:brain/xperfect" 2>/dev/null); then
      xperfect_source_clean "$light" "$pin" 2>/dev/null || state=dirty
    elif [ "$dir" = "$xp" ]; then state=dirty; fi
  fi
  echo "$commit $state"
}
page_source() {  # only a stamp written for this Next build ID describes the files on disk
  local stamp="$ROOT/call/ui/.next/vx-source"
  [ -n "$1" ] && [ "$(sed -n 2p "$stamp" 2>/dev/null)" = "$1" ] && sed -n 1p "$stamp" || true
}
app_value() {
  /usr/libexec/PlistBuddy -c "Print :$1" "$APP/Contents/Info.plist" 2>/dev/null || true
}
# A launch record for every process vx starts (logs/launched/PID): its part, when it started and the program it was
# started as (that last for the reader: a script that hands over to its program, or a program that renames itself, is
# still the process vx started). A process is this checkout's only by such a record: its pid with the same start time (a
# pid the system gives another program has another start time), never its working folder or a path in its command line.
# A part started before vx kept records: by the start time its older record (NAME.started) kept, and only where no record
# of any kind exists, by its start within seconds before its pid file was written (a pid file is written as it starts).
mine() {  # mine FILE...: a file of hers that vx itself writes, his alone before a word is in it (0600: core/state.py
  # closes what is left open at the next start; the part being started keeps the permissions a login gives it)
  local file; for file in "$@"; do (umask 077; : >>"$file"); chmod go-rwx "$file" 2>/dev/null || true; done
}
launched() {  # launched PID NAME COMMAND...: the record, written as it starts
  local pid=$1 name=$2 word program="" record temp; shift 2
  for word in "$@"; do  # (the program: the first word that is not env, nor a VAR=value env sets)
    [ "$word" = env ] || [[ "$word" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || { program=${word##*/}; break; }
  done
  mkdir -p -m 700 "$LOGS/launched"
  record="$LOGS/launched/$pid"
  temp=$(mktemp "$LOGS/launched/.record.XXXXXXXX") || return 1
  printf '%s\n' "$name" "$(started_at "$pid")" "$program" "${launch_source:-}" "${launch_build:-}" \
    "${launch_build_source:-}" >"$temp" && mv -f "$temp" "$record" || { rm -f "$temp"; return 1; }
}
launch_holds() {  # launch_holds PID [NAME]: its launch record (for NAME) holds: the same pid with the same start time
  local record="$LOGS/launched/$1"
  [ -f "$record" ] && kill -0 "$1" 2>/dev/null || return 1
  [ -z "${2:-}" ] || [ "$(sed -n 1p "$record")" = "$2" ] || return 1
  [ "$(started_at "$1")" = "$(sed -n 2p "$record")" ]
}
own_pid() {  # own_pid NAME: the pid vx recorded for NAME, only while that very process runs (proved by its record; a pid
  # the system has since given another program is never NAME)
  local pid at gap; pid=$(cat "$LOGS/$1.pid" 2>/dev/null) || return 1
  [[ "$pid" =~ ^[0-9]+$ ]] && [ "$(stat -f %m "$LOGS/$1.pid")" -ge "$BOOT" ] && kill -0 "$pid" 2>/dev/null || return 1
  if [ -f "$LOGS/launched/$pid" ]; then launch_holds "$pid" "$1" || return 1
  elif [ -f "$LOGS/$1.started" ]; then [ "$(started_at "$pid")" = "$(tr -s ' ' <"$LOGS/$1.started" | sed 's/ $//')" ] || return 1
  else  # (no record of any kind: it started within seconds before its pid was written)
    at=$(date -j -f "%a %b %d %T %Y" "$(started_at "$pid")" +%s 2>/dev/null) || return 1
    gap=$(( $(stat -f %m "$LOGS/$1.pid") - at )); [ "$gap" -ge 0 ] && [ "$gap" -le 10 ] || return 1
  fi
  echo "$pid"
}
proven() {  # proven PID: a process this checkout started, or one of the process group such a process leads (its child)
  local pid=$1 leader file own
  leader=$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ')
  for file in "$LOGS"/*.pid; do
    [ -f "$file" ] || continue
    own=$(own_pid "$(basename "$file" .pid)") || continue
    if [ "$own" = "$pid" ] || [ "$own" = "$leader" ]; then return 0; fi
  done
  for file in "$LOGS"/launched/*; do  # (a part whose pid file is gone: its launch record still proves it)
    [ -f "$file" ] || continue
    own=${file##*/}
    if { [ "$own" = "$pid" ] || [ "$own" = "$leader" ]; } && launch_holds "$own"; then return 0; fi
  done
  return 1
}
running() { own_pid "$1" >/dev/null; }
tests_running() {  # a live test run holds the lock (a lock from before the last restart, or a dead pid, does not)
  [ -d "$LOGS/tests.lock" ] && [ "$(stat -f %m "$LOGS/tests.lock")" -ge "$BOOT" ] || return 1
  local owner; owner=$(cat "$LOGS/tests.lock/pid" 2>/dev/null)
  if [ -z "$owner" ]; then [ $(( $(date +%s) - $(stat -f %m "$LOGS/tests.lock") )) -lt 60 ]; else kill -0 "$owner" 2>/dev/null; fi
}

# Every part vx starts is his live Light (brain/xperfect.py lets only these use his live xPerfect; tests never have it).
export VX_RUNTIME=live

start() {  # start NAME PORT COMMAND...  (background, own process group, log + pid in logs/)
  local name=$1 port=$2; shift 2
  # How it was started is remembered (logs/NAME.how): a part whose settings did not change stays up, warm.
  local how; how=$(printf '%s\n' "$@" | shasum | cut -c1-16)
  if [ "$port" != - ] && ! running "$name" && [ "$(holder "$port")" = other ]; then  # (said by status and keep too)
    echo "  $name could not start: port $port is held by another program, not this Viventium. Quit that program, then ./vx up."
    if [[ " livekit agent ui " == *" $name "* ]]; then blocked held; exit 1; fi
    return 0
  fi
  if running "$name" || { [ "$port" != - ] && nc -z 127.0.0.1 "$port" 2>/dev/null; }; then
    # LiveKit, her agent and the page hold Light's key: one that this project did not record starting is never kept.
    if [ ! -f "$LOGS/$name.how" ] && [[ " livekit agent ui " == *" $name "* ]]; then
      echo "  $name: something this project did not start is running$([ "$port" = - ] || echo " on port $port"). Stop it (./vx down), then ./vx up."; exit 1
    fi
    if [ ! -f "$LOGS/$name.how" ] || [ "$(cat "$LOGS/$name.how")" = "$how" ]; then echo "  $name: already running"; return; fi
    echo "  $name: its settings changed"; if [ "$name" = doors ]; then stop_doors; else stop "$name" "${port#-}"; fi
  fi
  mine "$LOGS/$name.how" "$LOGS/$name.log" "$LOGS/$name.pid"  # (her part's own files: his alone from the start)
  echo "$how" >"$LOGS/$name.how"
  local launch_source launch_build="" launch_build_source=""
  launch_source=$(source_identity)
  case "$name" in
    ui) launch_build=$(cat "$ROOT/call/ui/.next/BUILD_ID" 2>/dev/null || true); launch_build_source=$(page_source "$launch_build") ;;
    menubar) launch_build_source=$(app_value ViventiumSource) ;;
  esac
  # macOS has no setsid(1); a new session makes "down" stop the whole process tree.
  cd "$ROOT"
  nohup python3 -c 'import os,sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' "$@" \
    >"$LOGS/$name.log" 2>&1 </dev/null &
  echo $! >"$LOGS/$name.pid"; disown; launched $! "$name" "$@"
  echo "  $name: started"
}

start_ui() {  # start_ui NEXT UI: the page only needs to know if a room can publish audio.
  local next="$1" ui="$2" voice=on
  [ "$STT" != off ] || voice=off
  LIVEKIT_API_SECRET="$LK_SECRET" VX_PHONE_SECRET="$PHONE_SECRET" start ui "$UI_PORT" env NEXT_TELEMETRY_DISABLED=1 LOCAL_ONLY=1 \
    VX_ROOT="$ROOT" LIVEKIT_API_KEY="$LK_KEY" VX_LAN_ORIGIN="${VX_LAN_ORIGIN:-}" VX_LAN_LIVEKIT_URL="${VX_LAN_LIVEKIT_URL:-}" \
    STT="$voice" "$next" start -H 127.0.0.1 -p "$UI_PORT" "$ui"
}

holder() {  # holder PORT: who listens on this computer's port: "ours" (proved this checkout's), "other" (another program),
  # or "" (nothing)
  local pid found=""
  for pid in $(lsof -nP -iTCP:"$1" -sTCP:LISTEN -t 2>/dev/null); do
    if proven "$pid"; then echo ours; return; fi
    found=other
  done
  if [ -z "$found" ] && nc -z 127.0.0.1 "$1" 2>/dev/null; then found=other; fi  # (another user's: its process unseen)
  echo "$found"
}
held_by_other() {  # before anything stops: another program holds LiveKit's port or the page's, so they could not start
  # again (said, with what to do; then nothing is stopped)
  local pair said=""
  for pair in livekit:7880 page:$UI_PORT; do
    if [ "$(holder "${pair##*:}")" = other ]; then said="$said ${pair%%:*} (port ${pair##*:})"; fi
  done
  [ -n "$said" ] || return 1
  echo "Another program holds the port of$said, so Viventium could not start again: nothing was stopped. Quit that program, then try again."
  blocked held; return 0
}
on_port() {  # on_port NAME PORT, for keep: up on its port (this Viventium's), else gone (nothing there) or held (another program)
  case "$(holder "$2")" in ours) ;; other) held="$held $1" ;; *) gone="$gone $1" ;; esac
}

wait_port() {  # wait_port NAME PORT SECONDS
  for _ in $(seq 1 "$3"); do nc -z 127.0.0.1 "$2" 2>/dev/null && return 0; sleep 1; done
  echo "  $1 did not open port $2; see logs/$1.log"; return 1
}

stop() {  # stop NAME [PORT...]: the recorded process (its group with it), then what of this checkout's is still on its
  # ports. Nothing is signalled that is not proved this checkout's by its launch record (own_pid, proven): a group only
  # when its leader is that process, a listener only when it or its group's leader is one vx started.
  local name=$1 pid group member port; shift
  if pid=$(own_pid "$name"); then
    group=$pid; [ "$(ps -o pgid= -p "$pid" | tr -d ' ')" = "$pid" ] || group=""
    kill -TERM -- "${group:+-}$pid" 2>/dev/null || true
    # A draining agent can linger (and keep old settings): give it 10 s, then end it.
    for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
    if own_pid "$name" >/dev/null; then kill -KILL -- "${group:+-}$pid" 2>/dev/null || true
    elif [ -n "$group" ]; then  # (its leader gone: what is left of the group it led, which only its children can be in)
      for member in $(pgrep -g "$group" 2>/dev/null); do kill -KILL "$member" 2>/dev/null || true; done
    fi
    rm -f "$LOGS/launched/$pid"
  fi
  rm -f "$LOGS/$name.pid" "$LOGS/$name.started"
  for port in "$@"; do  # (a leftover of this checkout's own; another program on the port is never stopped)
    [ -n "$port" ] || continue
    for pid in $(lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null); do
      if ! proven "$pid"; then echo "  $name: port $port is held by another program; it is left alone"; continue; fi
      group=$(ps -o pgid= -p "$pid" | tr -d ' ')
      if [ -n "$group" ] && proven "$group" && [ "$(ps -o pgid= -p "$group" 2>/dev/null | tr -d ' ')" = "$group" ]; then
        kill -TERM -- "-$group" 2>/dev/null || true; rm -f "$LOGS/launched/$group"
      else kill -TERM "$pid" 2>/dev/null || true; rm -f "$LOGS/launched/$pid"; fi
    done
  done
}

serve_embed() {  # Light's own small server for the embedding model (memory by meaning, core/memory.py): its own
  # port and process, like her other models, so she never leans on another program's Ollama (main Viventium's :11434).
  local model="${EMBED_MODEL:-qwen3-embedding:0.6b}"
  start embed-model 11437 env OLLAMA_HOST=127.0.0.1:11437 OLLAMA_KEEP_ALIVE=-1 OLLAMA_MAX_LOADED_MODELS=1 OLLAMA_NOPRUNE=1 OLLAMA_CONTEXT_LENGTH=8192 "$OLLAMA_BIN" serve
  wait_port embed-model 11437 30
  if ! model_present "$model" && ! pull_retry 11437 "$model"; then
    if [ "${1:-}" = background ]; then return 1; fi
    download_failed "Her memory's model"
  fi
}

pull() {  # pull PORT MODEL: let Ollama handle blob ranges and verify the registry digests
  python3 - "$1" "$2" "$LOGS/up.progress" <<'EOF'
import json, sys, urllib.request
port, model, kept = sys.argv[1:4]
asked = urllib.request.Request(f"http://127.0.0.1:{port}/api/pull", data=json.dumps({"model": model}).encode(), method="POST")
shown = -1
with urllib.request.urlopen(asked, timeout=120) as reply:
    for line in reply:
        said = json.loads(line or b"{}")
        if said.get("error"):
            print(f"  {said['error']}", file=sys.stderr)
            sys.exit(1)
        if said.get("status") == "success":
            sys.exit(0)
        total, done = said.get("total") or 0, said.get("completed") or 0
        if total > 1e9 and int(done * 100 / total) != shown:  # (its weights; its small parts come and go at once)
            shown = int(done * 100 / total)
            print(f"  download: the brain \u00b7 {shown}%", flush=True)
            try:
                open(kept, "w").write(f"download: the brain \u00b7 {shown}%\n")  # (for a start waiting on this one)
            except OSError:
                pass
sys.exit(1)
EOF
}

pull_retry() {
  local attempt
  for attempt in 1 2 3; do
    if pull "$@" 2>>"$LOGS/setup.log"; then return 0; fi
    [ "$attempt" -lt 3 ] && [ "$(free_gb)" -ge 2 ] || return 1
    sleep $(( 2 ** attempt ))
  done
}

serve_model() {  # serve_model NAME PORT MODEL [KEEP] [SLOTS]: a private Ollama server, model loaded (kept warm, or KEEP)
  # One model per server: a model tried once (e.g. an eval) replaces it instead of staying resident too.
  # SLOTS: requests it runs at once, each with its own cached conversation (her own server has two: one
  # slot made every one-word question swap her conversation out to memory and back, 0.7 s each way on a long call).
  start "$1" "$2" env OLLAMA_HOST="127.0.0.1:$2" OLLAMA_KEEP_ALIVE="${4:--1}" OLLAMA_MAX_LOADED_MODELS=1 OLLAMA_FLASH_ATTENTION=1 \
    OLLAMA_CONTEXT_LENGTH="${LOCAL_CONTEXT:-65536}" OLLAMA_NUM_PARALLEL="${5:-1}" OLLAMA_NOPRUNE=1 "$OLLAMA_BIN" serve
  # (a server that never listens could not start its model: kept as that answer, and the start goes on to her page and
  # the reason, mind_answers; before, it stopped the start here, after a restart had already stopped her agent)
  if ! wait_port "$1" "$2" 30; then printf -v "WARMED_$2" '%s' "$3 load"; return 0; fi
  # The model itself, downloaded once into Ollama's store on this Mac (shared with any other Ollama).
  model_present "$3" || pull_retry "$2" "$3" || download_failed "Her model ($3)"
  # Its first load, now and never on a first word, given three minutes (VX_LOAD_WAIT; a load that hangs never holds the
  # start). What it said is kept for this run as WARMED_PORT="MODEL WHAT", for "Ready" (answered).
  local heard; heard=$(answer "http://127.0.0.1:$2/v1" "$3" "${VX_LOAD_WAIT:-180}")
  printf -v "WARMED_$2" '%s' "$3 ${heard:-ok}"
}

answer() {  # answer URL MODEL SECONDS: one word asked of a model server on this Mac (its OpenAI-style API, as her mind asks
  # it), bounded in time (curl's own limit). Nothing when a word came back; else what happened, by structure, never by its
  # words: "load" (an error status, or gone mid-answer: this Mac could not run the model), "absent" (no server there: it
  # could not start, or has not started yet), "empty" (it answered, with no word in it), "silent" (no answer in SECONDS:
  # the only one that may pass by asking again)
  local said="" rc=0
  said=$(curl -s -w '\n%{http_code}' --max-time "$3" "${1%/}/chat/completions" -H 'Content-Type: application/json' -d \
    "{\"model\":\"$2\",\"messages\":[{\"role\":\"user\",\"content\":\"Say OK.\"}],\"max_tokens\":8,\"reasoning_effort\":\"none\"}") || rc=$?
  local code=${said##*$'\n'}
  if [ "$rc" = 28 ]; then echo silent
  elif [ "$rc" = 7 ]; then echo absent
  elif [ "$rc" != 0 ] || [ "${code:0:1}" != 2 ]; then echo load
  elif ! printf %s "${said%$'\n'*}" | python3 -c 'import json, sys
choice = (json.load(sys.stdin).get("choices") or [{}])[0]
sys.exit(0 if str((choice.get("message") or {}).get("content") or "").strip() else 1)' 2>/dev/null; then echo empty; fi
}

answered() {  # answered URL MODEL SECONDS: as answer, from what this Mac's server at that address said when serve_model
  # loaded that model this run, when that settled it (a word, an error, no server, no word); asked now when it was not
  # loaded here, or gave no answer in time then (a restart leaves her last Life summary running, which can hold its one
  # slot for minutes)
  local port="" kept
  case "$1" in http://127.0.0.1:*) port=${1#http://127.0.0.1:}; port=${port%%/*} ;; esac
  kept="WARMED_${port:-none}"; kept="${!kept:-}"
  if [ -n "$port" ] && [ "${kept%% *}" = "$2" ] && [ "${kept##* }" != silent ]; then [ "${kept##* }" = ok ] || echo "${kept##* }"
  else answer "$@"; fi
}

verdict() {  # verdict WHAT: this start's verdict on her mind (logs/mind-answer), whole or not at all: written beside it and
  # moved in, so no look ever finds it empty (the menu bar took an empty one for no failure), with
  # the profile it is of on its second line (her channels and her page ignore another profile's: core/accounts mind_down)
  local into="$LOGS/mind-answer.$$"
  mine "$into"; printf '%s\n%s\n' "$1" "$PROFILE" >"$into"; mv -f "$into" "$LOGS/mind-answer"
}

mind_answers() {  # mind_answers [check]: before "Ready", one real answer from the mind she will use, bounded in time (a clean Mac: her
  # model aborted on its graphics while every part was up, and only her page said so, once a word was typed). An answer
  # is a word. Her chosen mind, else its declared backup (QUEEN_FALLBACK=local: this Mac's model at MEMORY_URL, as
  # brain/queen builds it); an online mind refused while its backup answers is no stop (Settings shows why once her first
  # turn sets it aside: core/accounts). The verdict is kept in logs/mind-answer ("answered", or what happened), replaced
  # only by the next verdict: ./vx status reads it, so a start that asks again never shows her ready before it knows.
  # When neither answers: one plain line, and why for the app (logs/blocked "mind KIND"), decided by what happened;
  # returns 3 when asking again may work (no answer in time or a transient online backup failure), else 4 (another mind).
  # This Mac's servers answered as serve_model loaded them (answered); an online mind is asked here (settings/probe.py),
  # given VX_MIND_WAIT seconds.
  # check (./vx ready, before a restart stops anything): a timeout, a local backup not started yet, or a transient
  # online backup failure is the start's own to ask again at its gate. It writes nothing and returns 1 with one line, or 0.
  local looking="${1:-}" wait="${VX_MIND_WAIT:-60}" first="" second="" what="" backed="" key said here probe=answer
  [ -z "$looking" ] || wait="${VX_MIND_WAIT:-10}"
  if [ "$QUEEN" = ollama ]; then  # (a mind on this Mac declares no backup)
    first=$(answered "${QUEEN_URL:-http://127.0.0.1:11435/v1}" "$QUEEN_MODEL" "$wait")
  else
    if [ "${QUEEN_FALLBACK:-}" = local ] && [ -n "${MEMORY_URL:-}" ]; then backed=local; fi
    if [ "${QUEEN_FALLBACK:-}" = openai ] && [ "$QUEEN" != openai ] && have_key OPENAI_API_KEY; then backed=openai; fi
    # Her mind on your Grok subscription turned off (the page's switch, or KEYS_OFF) with no backup declared: your
    # choice, never a missing sign-in. Her replies pause; the check passes, a start says so and goes on.
    if [ -z "$backed" ] && [ "$(mind_key 2>/dev/null)" = grok_mind ] \
        && { [ -e "$LOGS/grok_mind.off" ] || [[ " ${KEYS_OFF:-} " == *" grok_mind "* ]]; }; then
      [ -n "$looking" ] && return 0
      verdict off
      echo "Viventium's mind is turned off in Settings: replies pause until you turn a mind on."
      return 0
    fi
    if [ "$QUEEN" = chatgpt_plan ] && [ -z "$looking" ] && [ -n "${VX_FROM_APP:-}" ] \
        && [ -z "${VX_KEEPING:-}" ] && [ "${VX_SETUP_WINDOW:-}" = 1 ] && [ -p /dev/fd/0 ] \
        && [ -s "$LOGS/.first-conversation-pending" ] && [ ! -e "$LOGS/.first-ready" ]; then
      probe=greeting
    fi
    if [ "$QUEEN" != chatgpt_plan ] && [ -n "$backed" ] && key=$(mind_key) && ! have_key "$key"; then
      first=key  # (no key to use: it is not built at all, and its backup answers alone, brain/queen)
    else  # (its key reaches this one check, in a subshell of its own: no part started after it inherits it)
      local into=/dev/null; [ -n "$looking" ] || { into="$LOGS/mind.log"; mine "$into"; }
      if said=$( (load_keys; cd "$ROOT" && VX_MIND_WAIT="${VX_MIND_WAIT:-25}" "$ROOT/.venv/bin/python" -m settings.probe "$probe") \
          2>"$into"); then first=""
      else
        first=$(sed -n 1p <<<"$said"); what=$(sed -n 2p <<<"$said")
        [ -n "$first" ] || { first=failed; what="It could not be asked"; }  # (the check itself did not run)
      fi
      if [ -n "$looking" ] && [ "$first" = silent ]; then return 0; fi
    fi
    if [ -n "$looking" ] && [ "$first" = connected ]; then return 0; fi
    if [ -n "$first" ] && [ "$backed" = local ]; then
      second=$(answered "$MEMORY_URL" "${MEMORY_MODEL:-qwen3.6:latest}" "$wait")
      [ -n "$second" ] || first=""  # (its backup answers)
      if [ -n "$looking" ] && { [ "$second" = silent ] || [ "$second" = absent ]; }; then return 0; fi
    elif [ -n "$first" ] && [ "$backed" = openai ]; then
      if said=$( (load_keys; cd "$ROOT" && QUEEN=openai QUEEN_MODEL="$QUEEN_FALLBACK_MODEL" QUEEN_EFFORT=low \
          QUEEN_URL="${QUEEN_FALLBACK_URL:-}" VX_MIND_WAIT="${VX_MIND_WAIT:-25}" "$ROOT/.venv/bin/python" -m settings.probe answer) 2>/dev/null); then
        first=""
      else
        # The backup is the route that could still answer. Only its own auth refusal needs a different mind.
        local fallback; fallback=$(sed -n 1p <<<"$said")
        if [ "$first" != connected ]; then
          case "$fallback" in
            "refused 401"|"refused 403") first="$fallback" ;;
            *) first=silent ;;
          esac
        fi
        what="${what:+$what. }$(sed -n 2p <<<"$said")"
        what="${what:-OpenAI could not be asked}"
      fi
    fi
  fi
  if [ -n "$looking" ] && { [ "$first" = silent ] || [ "$first" = absent ]; }; then return 0; fi
  if [ "$first" = connected ]; then
    verdict connected
    echo "ChatGPT is connected. Readiness waits for its first answer."
    return 5
  fi
  if [ "$first" = absent ]; then first=load; fi
  if [ "$second" = absent ]; then second=load; fi
  if [ -n "$looking" ] && [ -n "$first" ]; then  # (./vx ready: definite; its words, and nothing written)
    case "${second:-$first}" in empty) here="This Mac's model gave no answer" ;; *) here="This Mac could not run its model" ;; esac
    if [ "$QUEEN" = ollama ] || [ "$first" = key ]; then what=$here
    elif [ "$second" = empty ]; then what="$what, and its backup on this Mac gave no answer"
    elif [ -n "$second" ]; then what="$what, and this Mac could not run its backup"; fi
    echo "Viventium's mind did not answer on $PROFILE: $what."; return 1
  fi
  [ -z "$looking" ] || return 0
  if [ -z "$first" ]; then verdict answered; return 0; fi
  case "${second:-$first}" in
    silent) here="This Mac's model is not answering" ;; empty) here="This Mac's model gave no answer" ;;
    *) here="This Mac could not run its model" ;;
  esac
  if [ "$QUEEN" = ollama ]; then what=$here
  elif [ "$first" = key ]; then first=$second; what=$here
  elif [ -n "$second" ]; then
    case "$second" in
      silent) what="$what, and its backup on this Mac is not answering" ;; empty) what="$what, and its backup on this Mac gave no answer" ;;
      *) what="$what, and this Mac could not run its backup" ;;
    esac
  fi
  # (her mind refused while its backup only ran out of time, as when her last Life summary holds its one slot: asking
  # again may pass, so that is the reason; the line still says both)
  if [ "$second" = silent ]; then first=silent; fi
  verdict "$first"; blocked mind $first
  if [ -n "${VX_FROM_APP:-}" ]; then echo "$what."  # (the app's window: its title, this line and its one way forward)
  elif [ "$first" = silent ]; then echo "Viventium's mind did not answer: $what. ./vx up asks it again."
  else echo "Viventium's mind did not answer: $what. Choose another mind in Settings, under Brain: http://localhost:$UI_PORT/settings#brain"; fi
  if [ "$first" = silent ]; then return 3; fi
  return 4
}

coordinator() {  # coordinator [STATE HARNESS local|signed-in]: an xPerfect state's coordinator settings and its own
  # ports (this profile's Workers by default); prints "changed" if updated
  local state="${1:-$XPERFECT_STATE}"
  python3 - "$state/config.json" "${2:-${WORKER_PROFILE:-codex-cli}}" "${3:-${WORKERS:-signed-in}}" "$ROOT" "${LOGS:-$ROOT/logs}" $(xp_ports "$state") <<'EOF'
import json, os, platform, sys
path, profile, workers, root, logs = sys.argv[1:6]
ports = dict(zip(("api", "ui", "mcp"), map(int, sys.argv[6:9])))  # (xPerfect reads them when it starts)
c = json.load(open(path)); env = dict(c["env"])
if workers == "local":  # the local model is not in xPerfect's model catalog: a catalog id on the local route
    model = {"claude-code": "claude-code:opus", "codex-cli": "codex-cli:native-default"}[profile]
    env["WPR_CLAUDE_CODE_PROVIDER_MODEL"] = c["models"]["claude-code"]
    # One GPU serves her and the work: one job at a time keeps her fast (two at once took her replies from
    # 2.7 to 4.4 s and timed one out). Both lanes: a job's coordinator turn and its Worker (the
    # mission lane, where the work runs: setting only the first let three local Workers overlap).
    env["WPR_HOST_CONVERSATION_SLOTS_PER_CLI"] = "1"
    env["WPR_HOST_MISSION_SLOTS_PER_CLI"] = "1"
else:  # your own Codex / Claude Code sign-in, with this state's exact model (xPerfect's defaults: 2 and 3)
    model = ""  # (set below, once each harness's exact model is known)
    env.pop("WPR_HOST_CONVERSATION_SLOTS_PER_CLI", None)
    env.pop("WPR_HOST_MISSION_SLOTS_PER_CLI", None)
    # A fault to test the Workers' backup: Claude Code gets a sign-in that Anthropic refuses (VX_TEST_BREAK_CLAUDE=1
    # ./vx restart; a plain ./vx restart takes it away again).
    for key in ("WPR_CLAUDE_CODE_AUTH_TOKEN", "WPR_CLAUDE_CODE_BASE_URL"):
        env.pop(key, None)
    if os.environ.get("VX_TEST_BREAK_CLAUDE") == "1":
        env.update(WPR_CLAUDE_CODE_AUTH_TOKEN="broken-for-a-test", WPR_CLAUDE_CODE_BASE_URL="https://api.anthropic.com")
facts = ("You manage one job of Viventium's background work while Viventium keeps talking with the user. The "
         "job's work already runs on its own Worker. The request names the Worker and its access. Your own "
         "session reaches only its workspace, so do not redo the work there. If the user's later turns change the "
         "job, steer that Worker; add helpers only for parts that are independent. Report its result faithfully, "
         "naming each file made or changed by its full path. A tool that was denied or failed is a block, never done.")
# A Worker's browser and computer use are its own harness's (the requirement: the native harnesses provide them):
# Claude Code its own Chrome (Claude in Chrome, Anthropic's extension: no remote debugging), Codex its computer use
# (xPerfect's own list of the tool servers a Worker keeps: computer-use, node_repl, cua_repl). Nothing of Light's own
# connects to Chrome; what an older start kept here for Light's own bridge to it goes.
env["WPR_CLAUDE_CODE_ENABLE_CHROME"] = "1"
# Pass the whole deny list. xPerfect refuses a grant if Grok cannot express any rule.
env["WPR_GROK_DENY"] = env.get("WPR_CLAUDE_CODE_DENY") or "[]"
for key in ("GLASSHIVE_HOST_CODEX_MCP_APPEND", "GLASSHIVE_HOST_CODEX_NATIVE_MCP_ALLOWLIST"):
    env.pop(key, None)
# Its clock rings Light's doorbell (core/doorbell.py) when a moment she was asked to keep has come: a signed notice
# to this Mac only. xPerfect refuses a loopback address unless it is told this one port.
env["WPR_WEBHOOK_ALLOW_LOCAL_HTTP"] = "true"
env["WPR_WEBHOOK_ALLOWED_PORTS"] = "8869"
# Several Claude subscriptions (Accounts, the + on the settings page): on this single-user Mac each one signs in in
# its own home (Claude Code keeps one Keychain login per config folder); xPerfect allows it only when told
# (brain/patches/xperfect-0006). This Mac's own Claude sign-in is not read, copied or changed.
env["GLASSHIVE_ENABLE_LOCAL_MACOS_CLAUDE_ACCOUNTS"] = "1"
# On the local model one GPU serves her and the work: the coordinator is not woken again just to restate the
# Worker's result (Light tells the Worker's own words); in the cloud it reports, and can add what it saw.
# Each Worker harness's thinking effort and exact model, as chosen (WORKER_EFFORT_<HARNESS>, WORKER_MODEL_<HARNESS>;
# xPerfect's own names for them below). Unset: high, and the model this state was set up with.
names = {"claude-code": ("CLAUDE_CODE", "WPR_CLAUDE_CODE_EFFORT"), "codex-cli": ("CODEX_CLI", "WPR_CODEX_CLI_REASONING_EFFORT"),
         "grok-build": ("GROK_BUILD", "WPR_GROK_REASONING_EFFORT")}
models = dict(c["models"])
managed_auth = os.path.join(root, "tools", "grok-worker-auth")
env["WPR_GROK_MANAGED_AUTH_PROVIDER"] = managed_auth
env["WPR_GROK_AUTH_OFF_PATH"] = os.path.join(logs, "grok_mind.off")
env["WPR_GROK_AUTH_ISSUER_FILE"] = os.path.join(root, "core", "grok_worker_auth.py")
env.pop("WPR_GROK_AUTH_PROVIDER_COMMAND", None)
if workers == "signed-in" and os.environ.get("WORKER_GROK_SIGN_IN") == "1":
    env["WPR_GROK_AUTH_PROVIDER_COMMAND"] = managed_auth
    binary = os.path.join(root, "tools", "grok-build", "grok")
    with open(os.path.join(root, "tools", "grok-build-pin.json")) as pin:
        env["WPR_GROK_MANAGED_BINARY_SHA256"] = json.load(pin)["sha256"][platform.machine()]
    env["WPR_GROK_MANAGED_BINARY"] = env["WPR_GROK_BIN"] = binary
    models.setdefault("grok-build", "grok-4.7")  # xPerfect's existing Grok Build route
for harness, (name, effort_key) in names.items():
    env[effort_key] = os.environ.get(f"WORKER_EFFORT_{name}") or "high"
    if workers != "local" and os.environ.get(f"WORKER_MODEL_{name}"):
        models[harness] = os.environ[f"WORKER_MODEL_{name}"]
# Who manages a job is its own choice (MANAGER_PROFILE, MANAGER_EFFORT); unset, it is the first Worker's harness.
manager = profile if workers == "local" else os.environ.get("MANAGER_PROFILE") or profile
env.pop("WPR_CODEX_EXTERNAL_PLAN_COMMAND", None)
env.pop("WPR_CODEX_EXTERNAL_PLAN_WORKERS", None)
if workers != "local":
    if manager == "grok-build" and "WPR_GROK_AUTH_PROVIDER_COMMAND" not in env:
        manager = "claude-code"  # signed out: xPerfect still serves the clock
    model = f"{manager}:{models[manager]}"
effort = (workers != "local" and os.environ.get("MANAGER_EFFORT")) or (env[names[manager][1]] if manager in names else "high")
# An attended Grok job reports through its own Worker. A second Grok run could ask outside its approval path.
wake = workers != "local" and not (manager == "grok-build" and "WPR_GROK_AUTH_PROVIDER_COMMAND" in env)
env["GLASSHIVE_COORDINATOR_CONFIG_JSON"] = json.dumps({"model": model, "effort": effort,
                                                       "wake_on_results": wake, "developer_instructions": facts})
if env != c["env"] or models != c["models"] or ports != c["ports"]:
    c["env"], c["models"], c["ports"] = env, models, ports
    with open(path + ".tmp", "w", opener=lambda p, f: os.open(p, f, 0o600)) as h:
        json.dump(c, h, indent=2); h.write("\n")
    os.replace(path + ".tmp", path)
    print("changed")
EOF
}

first_choice() {  # the first run, no place chosen yet: Hybrid when one of your subscriptions is signed in by now (made in
  # the app's window while she set up), else Local. Decided once, after the downloads both need, before anything differs.
  [ -f "$LOGS/.first-run" ] || return 0
  rm -f "$LOGS/.first-run"
  [ "$PROFILE" = local ] || return 0
  ( load_profile hybrid check >/dev/null; fallback="${WORKER_FALLBACK:-}"
    if have_key grok_mind; then exit 0; fi
    for harness in $WORKER_PROFILE ${fallback//,/ }; do if signed_in_now "$harness"; then exit 0; fi; done; exit 1 ) || return 0
  load_profile hybrid; ask_keys; sign_in
  if [ "${WORKER_GROK_SIGN_IN:-}" = 1 ]; then grok_harness; fi
  echo "  hybrid: your subscription does the work"
}

app_first_choice() {
  [ -n "${VX_FROM_APP:-}" ] && [ -f "$LOGS/.first-run" ] || return 0
  local target="$PROFILE"
  [ "$target" != local ] || target=hybrid
  if (load_profile "$target" assess; cd "$ROOT"; .venv/bin/python -m settings setup-mind); then
    load_profile "$target"
    rm -f "$LOGS/.first-run"
  fi
}

codex_home() {  # the local Workers' Codex home: the tracked template, with this Mac's paths
  sed -e "s#{ROOT}#$ROOT#g" -e "s#{HOME}#$HOME#g" "$ROOT/brain/codex-home-local/config.template.toml" \
    > "$ROOT/brain/codex-home-local/config.toml"
}

draft_first_greeting() {
  [ -n "${VX_FROM_APP:-}" ] && [ -s "$LOGS/.first-conversation-pending" ] && [ ! -e "$LOGS/.first-ready" ] || return 0
  mine "$LOGS/first-greeting.log"
  (load_keys; cd "$ROOT"; exec "$ROOT/.venv/bin/python" -m brain.greeting first) \
    >"$LOGS/first-greeting.log" 2>&1 </dev/null &
}

start_agent() {  # start_agent [VAR=value ...]: the voice agent (cloud keys go to it only)
  livekit_keys; load_keys  # (LiveKit's key: its name on the command line, so a new key restarts her; its secret never)
  LIVEKIT_API_SECRET="$LK_SECRET" start agent - env HF_HUB_OFFLINE=1 LIVEKIT_API_KEY="$LK_KEY" ${VX_TRACE_CONTEXT:+VX_TRACE_CONTEXT=1} \
    "$@" "$ROOT/.venv/bin/python" call/agent.py start
  unload_keys
}

start_life_core() (
  # Small Mac summaries use the same helpers as Feelings. Limit their keys to this process.
  if [ -n "${SMALL_MAC_TIER:-}" ]; then load_keys; fi
  start life-core - "$ROOT/.venv/bin/python" -m core.life core
)

start_chat() {  # Telegram (text, voice notes, the schedules' clock) when a bot token is set; with no bot, the
  # clock alone (core/clock.py), so a reminder still comes due: one owner of the clock at a time.
  load_keys; telegram_token
  if [ "${TELEGRAM:-on}" != off ] && [ -n "${TELEGRAM_BOT_TOKEN:-}" ]; then
    stop clock
    start chat - env HF_HUB_OFFLINE=1 "$ROOT/.venv/bin/python" chat/telegram.py
    unload_keys
  else
    unload_keys  # (the clock needs no key)
    start clock - "$ROOT/.venv/bin/python" -m core.clock
  fi
}

wait_agent() {  # a call only reaches an agent that registered before the room opened
  for _ in $(seq 1 120); do grep -q 'registered worker' "$LOGS/agent.log" 2>/dev/null && return 0; sleep 0.5; done
  echo "  agent did not register; see logs/agent.log"; return 1
}

settle() {  # before a restart on the loaded profile: stop her agent and Telegram (they read their settings when
  # they start) and only the local parts this profile no longer uses. Everything else stays up and warm: a
  # change of one setting used to stop and reload every model and LiveKit, about 25 s in which a call got no answer.
  stop chat; stop clock; stop agent; stop doorbell 8869; stop hearing-setup
  [ -n "${VX_LAN_ORIGIN:-}" ] || stop_doors  # (calling from the phone turned off: its doors close, by their ports too)
  [ "$STT" = whisper_local ] || stop stt 8930
  local_voice || stop tts 8940
  [ "$QUEEN" = ollama ] || stop model 11435
  if [ "${WORKERS:-}" != local ] && [ -z "${WORKERS_LOCAL:-}" ] && [[ "${FEELINGS_URL:-}${MEMORY_URL:-}" != *:11436* ]]; then stop worker-model 11436; fi
}

test_life() {  # test_life SCRIPT [ARGS]: the agent on a fresh copy of the synthetic Life and its own state
  # (conversation, jobs, schedules, Feelings), so test calls never land in yours, and Telegram paused (it
  # would adopt test Workers). Your own Life, state and Telegram come back afterwards, whatever happens.
  local life="$LOGS/tests/life" state="$LOGS/tests/state"
  # Never under a call of yours: the run swaps her agent for one on a test state, and your call would land there.
  # A call touches state/core/call-live every 20 s (call/agent.py).
  local live="$ROOT/state/core/call-live"
  if [ -f "$live" ] && [ $(( $(date +%s) - $(stat -f %m "$live") )) -lt 60 ]; then
    echo "A call is on right now; run the tests when it ends."; exit 1
  fi
  # One test run at a time, decided before anything is touched: two would swap the same agent under each other,
  # and a second one used to wipe the first one's test state before it saw the lock.
  if ! mkdir "$LOGS/tests.lock" 2>/dev/null; then
    if tests_running; then
      echo "Another test run (pid $(cat "$LOGS/tests.lock/pid" 2>/dev/null || echo starting)) is using its agent; run this when it ends."; exit 1
    fi
    rm -rf "$LOGS/tests.lock"; mkdir "$LOGS/tests.lock" 2>/dev/null || { echo "Another test run just started."; exit 1; }
  fi
  echo $$ > "$LOGS/tests.lock/pid"
  # A previous test's Life summary still being written (after its hang-up) would land in this one's fresh
  # Life and be "remembered" here (she took another test's files for work already running).
  for _ in $(seq 1 60); do pgrep -f "core.life summary" >/dev/null || break; sleep 2; done
  rm -rf "$life" "$state"; mkdir -p "$state/core"; cp -R "$ROOT/tests/fixtures/life" "$life"
  cp "$ROOT/state/core/telegram.json" "$state/core/" 2>/dev/null || true  # the owner's chat, for test-telegram
  shared record
  trap 'shared check; stop agent; : > "$LOGS/agent.log"; VX_NO_OPEN=1 up "$PROFILE" | grep -E "agent|chat|Ready|!!|was:|now:|chmod"; rm -rf "$LOGS/tests.lock"' EXIT
  # (VX_TEST_ENV: a fault to test a backup, e.g. "XAI_API_KEY=broken" so her cloud voice cannot be reached)
  # The synthetic Life is findable by meaning, like yours (its own small index, in the test state).
  LIFE="$life" VX_STATE="$state" "$ROOT/.venv/bin/python" -m core.memory refresh >/dev/null 2>&1 || true
  # Its turns go to its own log, never yours: the Live view of the Subconscious page reads yours (else test turns
  # fill it, a test's question showing as the newest turn).
  local turns="$LOGS/tests/turns.jsonl"; : > "$turns"
  stop chat; stop agent; : > "$LOGS/agent.log"; start_agent LIFE="$life" VX_STATE="$state" VX_TURNS="$turns" ${VX_TEST_ENV:-}; wait_agent
  # The test process gets the same synthetic Life and state (test-telegram runs a Queen itself), and
  # only test-telegram gets the keys it needs (start_agent unloads them).
  if [ "${TEST_TELEGRAM:-}" = 1 ]; then load_keys; telegram_token; fi
  # (the meaning model her agent finds by itself, core/memory.py, named for the test: a test reaches a part of his
  # Light only when what runs it names that part, tests/sandbox.py)
  LIFE="$life" VX_STATE="$state" VX_TURNS="$turns" EMBED_URL="${EMBED_URL:-http://127.0.0.1:11437}" "$ROOT/.venv/bin/python" "$@"
}

bench_test() {  # ./vx test: Light's call tests on the bench (tools/bench/bench.py once), a second Light beside this one
  # with its own LiveKit, page, agent, state and Workers' xPerfect, on this profile's mind and Workers. Your Light keeps
  # running (no agent swapped, Telegram not paused) and nothing of yours is touched; it starts and stops around the run.
  local live="$ROOT/state/core/call-live"  # (never under a call of yours: the tests would share her models with it)
  if [ -f "$live" ] && [ $(( $(date +%s) - $(stat -f %m "$live") )) -lt 60 ]; then
    echo "A call is on right now; run the tests when it ends."; exit 1
  fi
  local mind="" workers="${WORKER_PROFILE:-claude-code}"
  if [ "$QUEEN" = ollama ]; then mind=local; else mind=hybrid; fi  # (the profile as the person has it: Local with Feelings and memory by meaning, or Hybrid)
  [ "${WORKERS:-}" = local ] && workers=local
  (cd "$ROOT" && BENCH_PROFILE="$mind" BENCH_WORKER="$workers" "$ROOT/.venv/bin/python" tools/bench/bench.py once "$@")
}

phone_parts() {  # while calling from his phone is on (Settings, Channels, Phone: VX_LAN_ORIGIN): Viventium's own
  # certificate for this Mac's name made, and LiveKit's settings with the phone's sound on the network (call/phone.py);
  # prints that file, then the certificate's generation (its checksum: a new one restarts the doors). Off, or when they
  # cannot be made (said): nothing, and calls stay on this Mac.
  [ -n "${VX_LAN_ORIGIN:-}" ] || return 0
  local made folder
  if folder=$(cd "$ROOT" && "$ROOT/.venv/bin/python" -m call.phone certificate) && [ -f "$folder/doors.crt" ] \
      && made=$(cd "$ROOT" && "$ROOT/.venv/bin/python" -m call.phone livekit) && [ -f "$made" ]; then
    echo "$made"; shasum < "$folder/doors.crt" | cut -c1-12
  else
    echo "  phone: Viventium's certificate or LiveKit's settings for the phone could not be made; calls stay on this Mac" >&2
  fi
}

door_ports() {  # the ports of the phone's two doors: the ones set now (or the usual ones), and the ones they last opened on
  local url port
  for url in "${VX_LAN_ORIGIN:-https://mac.local:3443}" "${VX_LAN_LIVEKIT_URL:-wss://mac.local:7443}"; do
    port=${url##*:}; port=${port%%/*}; [[ "$port" =~ ^[0-9]+$ ]] && echo "$port"
  done
  cat "$LOGS/doors.ports" 2>/dev/null || true
}
stop_doors() {  # the doors stopped, by their ports too; their pass goes with them (no door: nothing may claim one). Their
  # ports' record stays while anything still answers on one (the Phone tile says so), and goes once all are closed.
  local ports port left=""; ports=$(door_ports | sort -u | tr '\n' ' '); stop doors $ports
  rm -f "$ROOT/state/core/phone/door-pass"
  for port in $ports; do if lsof -nP -iTCP:"$port" -sTCP:LISTEN -t >/dev/null 2>&1; then left=1; fi; done
  [ -n "$left" ] || rm -f "$LOGS/doors.ports"
}

call_live() {  # a call is on right now (call/agent.py touches state/core/call-live every 20 s)
  local live="$ROOT/state/core/call-live"
  [ -f "$live" ] && [ $(( $(date +%s) - $(stat -f %m "$live") )) -lt 60 ]
}

starting() {  # another ./vx up is at work right now (its pid is alive, and its lock is from since this Mac started)
  [ -d "$LOGS/up.lock" ] && [ "$(stat -f %m "$LOGS/up.lock")" -ge "$BOOT" ] || return 1
  local owner; owner=$(cat "$LOGS/up.lock/pid" 2>/dev/null || true)
  [ -n "$owner" ] && [ "$owner" != "$$" ] && kill -0 "$owner" 2>/dev/null
}

take_up_lock() {  # one start at a time (before: the keeper and a person each started her, and each build wiped the other's;
  # after five minutes a second start took a live lock, and two first runs downloaded at once). The lock is
  # another start's while its run lives: never stale by age alone, only when its run is gone (or from before this Mac
  # started). Meanwhile this one says how far that one is (logs/up.progress), so the app's window shows its progress.
  local owner said last="" told=""
  until mkdir "$LOGS/up.lock" 2>/dev/null; do
    owner=$(cat "$LOGS/up.lock/pid" 2>/dev/null || true)
    if starting; then
      [ -n "$told" ] || { echo "  another start is at work: this one goes on with it"; told=1; }
      said=$(cat "$LOGS/up.progress" 2>/dev/null || true)
      if [ -n "$said" ] && [ "$said" != "$last" ]; then echo "  $said"; last=$said; fi
      sleep 1
    elif [ -z "$owner" ] && [ "$(stat -f %m "$LOGS/up.lock" 2>/dev/null || echo 0)" -ge "$BOOT" ] \
        && [ $(( $(date +%s) - $(stat -f %m "$LOGS/up.lock" 2>/dev/null || echo 0) )) -lt 5 ]; then
      sleep 1  # (just made by another start: its pid comes next)
    else
      rm -rf "$LOGS/up.lock"  # (its run is gone: it stopped part-way, or this Mac restarted since)
    fi
  done
  echo $$ >"$LOGS/up.lock/pid"
  # (two starts that both judged an old lock stale, after a restart, can each take one: whose it is now decides, and the
  # other waits again)
  sleep 0.3
  if [ "$(cat "$LOGS/up.lock/pid" 2>/dev/null || true)" != "$$" ]; then take_up_lock; return 0; fi
  rm -f "$LOGS/up.progress"
}

progress() {  # progress WHAT: what is downloading (and how far), for the app's window and any start waiting on this one
  echo "  download: $*"
  echo "download: $*" >"$LOGS/up.progress" 2>/dev/null || true
}

recover_restore() {  # before a profile is read or any part starts: never run on a half-restored state
  restore_pending || return 0
  if running agent || running chat || running clock || nc -z 127.0.0.1 "$UI_PORT" 2>/dev/null; then
    echo "  An interrupted restore is pending. Stop Viventium before starting it again."; exit 1
  fi
  (cd "$ROOT" && "$ROOT/.venv/bin/python" -m core.backup recover) || {
    (cd "$ROOT" && "$ROOT/.venv/bin/python" -m core.backup reason)
    exit 1
  }
  (cd "$ROOT" && "$ROOT/.venv/bin/python" -m settings phone-off)
}

prepare_hearing() {
    # SHA-256 values from the two upstream Hugging Face LFS entries.
    fetch "$HOME/.cache/whisper/ggml-large-v3-turbo.bin" https://huggingface.co/ggerganov/whisper.cpp/resolve/5359861c739e955e79d9a303bcbc70fb988958b1/ggml-large-v3-turbo.bin hearing \
      1fc70f774d38eb169993ac391eea357ef47c88757ef72ee5943879b7e8e2bc69
    fetch "$HOME/.cache/whisper/ggml-silero-v5.1.2.bin" https://huggingface.co/ggml-org/whisper-vad/resolve/9ffd54a1e1ee413ddf265af9913beaf518d1639b/ggml-silero-v5.1.2.bin hearing \
      29940d98d42b91fbd05ce489f3ecf7c72f0a42f027e4875919a28fb4c04ea2cf
    start stt 8930 whisper-server -m "$HOME/.cache/whisper/ggml-large-v3-turbo.bin" --host 127.0.0.1 \
      --port 8930 --inference-path /v1/audio/transcriptions -l en -nt -sns -mc 0 -t 6 \
      --vad --vad-model "$HOME/.cache/whisper/ggml-silero-v5.1.2.bin"  # no "Thank you." on noise; -mc 0: no loops
}

up() {
  take_up_lock  # (one start at a time: a second one waits for the first, saying how far it is, then looks again)
  recover_restore
  local was; was="$(cat "$LOGS/profile" 2>/dev/null || true)"
  rm -f "$LOGS/stopped" "$LOGS/blocked"  # (./vx down leaves the first, so the keeper lets her rest; the second is this run's)
  # No place chosen yet, ever: the first run. She starts on Local, or on Hybrid when one of your subscriptions is signed in
  # by the time she starts (first_choice, after the downloads); kept until then, through a run that stops part-way.
  if [ -z "${1:-}" ] && [ -z "$was" ]; then touch "$LOGS/.first-run"; fi
  load_profile "${1:-${was:-local}}"
  # What this profile needs that this Mac lacks, asked or said before anything stops, starts or downloads. Homebrew and
  # its tools are the first download, so this is the one time the space is asked (before, a small
  # Mac that passed here was asked again after Homebrew had used 3 GB of the same budget, and stopped).
  preflight up
  if [ -n "${SMALL_MAC_TIER:-}" ]; then
    if needs_setup; then
      brewed
      if [ ! -x "$ROOT/.venv/bin/python" ]; then
        progress "Viventium's parts"
        (cd "$ROOT" && fetching "her Python parts" uv sync --locked --group test --quiet)
      fi
    fi
    preflight up
  fi
  shared check || true; shared record
  # (the first run in Terminal: what only a terminal can ask, Homebrew's password, a key, a sign-in, is asked there
  # before the app takes over; from the app, a key that is missing stops here, before any download, with its way on)
  if needs_setup; then
    brewed; harnesses
    if [ -z "${VX_FROM_APP:-}" ]; then require_small_mac_sign_in; ask_keys; sign_in; hand_off; fi
    setup background
    shared check || true
  else
    harnesses
  fi
  app_first_choice
  require_small_mac_sign_in
  small_voice
  ask_keys; sign_in
  grok_harness
  # Update every existing install before xPerfect can recover saved work (including retired plan jobs).
  prepare_xperfect
  livekit_keys; phone_key; own_folders  # (before anything starts: no part of a call on a published key, no open state)
  if held_by_other; then rm -rf "$LOGS/up.lock"; exit 1; fi  # (before the switch below stops anything)
  # Switching profile restarts what it changes (a running agent would keep the old profile's models).
  if [ -n "$was" ] && [ "$was" != "$PROFILE" ] && running agent; then
    echo "Switching from $was to $PROFILE"; settle
  fi
  codex_home
  echo "stage: starting"
  echo "Starting Viventium AI ($PROFILE)"
  life_folder
  local greeting_drafting=""
  if [ "$QUEEN" != ollama ]; then
    [ "$QUEEN" = chatgpt_plan ] || draft_first_greeting
    greeting_drafting=yes
  fi
  # Start only the local pieces this profile uses; their models download the first time.
  if [ "$STT" = whisper_local ]; then
    start hearing-setup - "$ROOT/vx" setup-hearing "$PROFILE"
  fi
  export VX_SHARED_HF_CACHE="${VX_SHARED_HF_CACHE:-${HF_HUB_CACHE:-}}"
  export HF_HUB_CACHE="${VX_STATE:-$ROOT/state}/downloads/hub"
  if [ "$STT" != off ] || [ "${STT_AUTO:-}" = 1 ]; then
    start hearing-files - python3 "$ROOT/core/downloads.py" hearing
  fi
  if local_voice; then
    # Both the voice and its nested tokenizer resolve only inside Light's verified cache.
    if ! running tts; then python3 "$ROOT/core/downloads.py" voice --pending; fi
    start tts 8940 env VX_PREPARE_VOICE=1 "$ROOT/speech/tts/run.sh"
  fi
  # qwen3.6 (qwen35moe) serves one request at a time, so the Queen and local Workers each get their
  # own server (same model files) and the Queen never waits behind a Worker. Hers stays warm; the
  # background one lets its copy (about 22 GB) go after 10 idle minutes, for this Mac's other work,
  # and loads again for the next job.
  # (the background one first: on the first run it downloads the model both use, before first_choice)
  if [ "${WORKERS:-}" = local ] || [ -n "${WORKERS_LOCAL:-}" ] || [[ "${FEELINGS_URL:-}${MEMORY_URL:-}" == *:11436* ]]; then  # Workers, Feelings, memory
    serve_model worker-model 11436 "$(if [ -n "${SMALL_MAC_TIER:-}" ]; then echo "$MEMORY_MODEL"
      else grep -m1 '^model *=' "$ROOT/brain/codex-home-local/config.toml" | cut -d'"' -f2; fi)" 10m
  fi
  first_choice  # (the first run: Local or Hybrid, now that what both need is here and before anything that differs starts)
  if [ "$QUEEN" = ollama ]; then serve_model model 11435 "$QUEEN_MODEL" -1 2; fi
  [ -n "$greeting_drafting" ] || draft_first_greeting
  # LiveKit on Light's own key (no --dev: that ran it on the published sample key, with debug pages; without a key of
  # its own it now refuses to start). The key's name rides on the command line so a new key restarts it; never its secret.
  # Calling from his phone on the same Wi-Fi: LiveKit's sound offered on this Mac's network address too, and the page's
  # two doors (phone_parts); off, LiveKit offers its sound on this computer alone (call/livekit.yaml).
  # (its settings' checksum rides on its command line too, as the key's name does: changed settings restart it once)
  local phone made; made=$(phone_parts); phone=$(sed -n 1p <<<"$made")
  local livekit_config="${phone:-call/livekit.yaml}" livekit_sum; livekit_sum=$(cd "$ROOT" && shasum < "$livekit_config" | cut -c1-12)
  LIVEKIT_KEYS="$LK_KEY: $LK_SECRET" start livekit 7880 env VX_LIVEKIT_KEY_NAME="$LK_KEY" VX_LIVEKIT_SETTINGS="${livekit_sum:-}" \
    livekit-server --config "${livekit_config:-call/livekit.yaml}" --bind 127.0.0.1
  # One xPerfect per place: this profile's Workers', and beside it the one of the Workers on this Mac when you
  # ticked them together with online ones (XPERFECT_LOCAL_STATE). Any other is stopped.
  for state in "$ROOT"/brain/state-*; do
    [ "$state" = "$XPERFECT_STATE" ] || [ "$state" = "${XPERFECT_LOCAL_STATE:-}" ] || xp_stop "$state"
  done
  # Each job's background Queen is xPerfect's native coordinator, on this profile's Worker harness;
  # a changed WORKER_PROFILE restarts xPerfect so it takes effect.
  if [ "$(coordinator)" = changed ]; then xp_stop "$XPERFECT_STATE"; fi
  # First start sets the xPerfect UI unlock password from the private file; later starts ignore it.
  local xp_before xp_source
  xp_before=$(xp_supervisor "$XPERFECT_STATE" || true); xp_source=$(source_identity)
  if "$ROOT/brain/xperfect/xperfect" start --state-dir "$XPERFECT_STATE" --unlock-password-stdin \
      < "$XPERFECT_STATE/unlock-password" >"$LOGS/xperfect.log" 2>&1; then
    echo "  workers: ready"; xp_record "$XPERFECT_STATE" "$xp_before" "$xp_source"
  else echo "  her Workers did not start; see logs/xperfect.log"; exit 1; fi
  if [ -n "${XPERFECT_LOCAL_STATE:-}" ]; then  # (its own settings: never the online Workers' efforts or manager)
    if [ "$(WORKER_EFFORT_CLAUDE_CODE= WORKER_EFFORT_CODEX_CLI= WORKER_EFFORT_GROK_BUILD= MANAGER_PROFILE= MANAGER_EFFORT= \
        coordinator "$XPERFECT_LOCAL_STATE" "${WORKERS_LOCAL_PROFILE:-claude-code}" local)" = changed ]; then xp_stop "$XPERFECT_LOCAL_STATE"; fi
    xp_before=$(xp_supervisor "$XPERFECT_LOCAL_STATE" || true); xp_source=$(source_identity)
    if "$ROOT/brain/xperfect/xperfect" start --state-dir "$XPERFECT_LOCAL_STATE" --unlock-password-stdin \
        < "$XPERFECT_LOCAL_STATE/unlock-password" >"$LOGS/xperfect-local.log" 2>&1; then echo "  workers on this Mac: ready"
      xp_record "$XPERFECT_LOCAL_STATE" "$xp_before" "$xp_source"
    else echo "  the Workers on this Mac did not start; see logs/xperfect-local.log"; exit 1; fi
  fi
  # Keys go to the voice agent only; Workers keep their own Codex / Claude Code sign-ins.
  # Local model files only (no Hugging Face update checks).
  start_agent
  # The doorbell xPerfect's clock rings when a moment has come (core/doorbell.py); it also keeps xPerfect's list
  # like Light's. No key of yours: its own signing secret, in the Keychain.
  start doorbell 8869 "$ROOT/.venv/bin/python" -m core.doorbell
  start_chat
  # (the doors start again when what they are changes: the phone's ports, what they lead to, the network, the certificate)
  if [ -n "$phone" ]; then
    door_ports | head -2 >"$LOGS/doors.ports.new"
    start doors - env UI_PORT="$UI_PORT" LIVEKIT_URL="${LIVEKIT_URL:-ws://127.0.0.1:7880}" VX_LAN_ORIGIN="$VX_LAN_ORIGIN" \
      VX_LAN_LIVEKIT_URL="${VX_LAN_LIVEKIT_URL:-}" VX_LAN_NETWORK="${VX_LAN_NETWORK:-}" VX_DOORS_CERT="$(sed -n 2p <<<"$made")" \
      "$ROOT/.venv/bin/python" -m call.phone doors
    mv -f "$LOGS/doors.ports.new" "$LOGS/doors.ports"
  else stop_doors; fi
  # The app, new when its source is (never a reason not to start her; never from her keeper's own round: VX_KEEPING).
  # (a build that failed was silent, and "ready" read as if the app were there)
  [ -n "${VX_KEEPING:-}" ] || helper >>"$LOGS/menubar-build.log" 2>&1 || \
    echo "  The Viventium AI app could not be built (logs/menubar-build.log); Viventium runs, and ./vx up starts it."
  [ -n "${VX_FROM_APP:-}" ] || menubar start
  # Her standing knowledge of you, rebuilt from Life at most daily, in the background.
  if [ -n "${LIFE:-}" ] && [ -n "${MEMORY_URL:-}" ]; then start_life_core; fi
  # Her memory by meaning: the index of Life's text is brought up to date (only what changed), in the background.
  if [ -n "${LIFE:-}" ] && [ "${MEMORY_EMBED:-}" != off ]; then
    if [ -n "${VX_FROM_APP:-}" ] && [ ! -f "$LOGS/.first-ready" ]; then
      start setup-memory - "$ROOT/vx" setup-memory "$PROFILE"
    else
      serve_embed; start life-index - "$ROOT/.venv/bin/python" -m core.memory refresh
    fi
  fi
  # Photo and video models already on this Mac and whole, never proved (weights from before proofs were kept):
  # proved now, in the background, read exactly as Install reads them. Nothing is downloaded, removed or chosen.
  start media-check - "$ROOT/.venv/bin/python" -m settings recognize
  # The call page: a production build served on this computer only. No dev server, so no Next.js
  # version check; no telemetry; rebuilt only when its source changed.
  local ui="$ROOT/call/ui" next="$ROOT/call/ui/node_modules/.bin/next"
  build_page "$ui" "$next" || exit 1
  start_ui "$next" "$ui"
  wait_port livekit 7880 20
  wait_port ui $UI_PORT 60
  # A call only reaches an agent that registered before the room opened.
  wait_agent || exit 1
  key_proof || { echo "  Calls are not on Light's own key yet: ./vx restart"; exit 1; }
  curl -s -o /dev/null "http://localhost:$UI_PORT" || true  # first request warms the server
  # (her mind's own answer, last: a running part that cannot answer is not ready. A start whose mind does not answer leaves
  # her parts up, the page among them, where another is chosen, with the reason: never half; it exits 3 or 4, mind_answers)
  local unanswered=0; mind_answers || unanswered=$?
  if [ "$unanswered" != 0 ]; then
    rm -rf "$LOGS/up.lock" "$LOGS/up.progress"
    if [ "$unanswered" = 5 ]; then
      [ "${VX_NO_OPEN:-}" = 1 ] || open "http://localhost:$UI_PORT"
      return 0
    fi
    exit "$unanswered"
  fi
  echo "Ready: http://localhost:$UI_PORT"  # (her page opens in the conversation: nothing to press first, one path)
  if running chat; then echo "  Telegram: on"; else echo "  Telegram: not connected (./vx telegram)"; fi
  echo "  Its Workers, to watch or steer: http://127.0.0.1:$(xp_ports "$XPERFECT_STATE" ui)"
  [ -z "${XPERFECT_LOCAL_STATE:-}" ] || echo "  The ones on this Mac: http://127.0.0.1:$(xp_ports "$XPERFECT_LOCAL_STATE" ui)"
  rm -rf "$LOGS/up.lock" "$LOGS/up.progress"
  [ "${VX_NO_OPEN:-}" = 1 ] || open "http://localhost:$UI_PORT"
}

stamp_page() {
  local stamp="$1/vx-source"
  (umask 077; printf '%s\n%s\n' "$3" "$2" >"$stamp.new" &&
    mv -f "$stamp.new" "$stamp") || echo "  ui: could not record build source"
}

page_build_complete() {  # Next can write BUILD_ID before it finishes writing the files next start needs
  [ -d "$1/.next/static" ] || return 1
  (cd "$1" && node - >/dev/null 2>&1 <<'JS'
  const { readFileSync, statSync } = require('node:fs');
  const { files } = JSON.parse(readFileSync('.next/required-server-files.json', 'utf8'));
  if (!Array.isArray(files) || files.length === 0) process.exit(1);
  for (const file of files) {
    const stat = statSync(file);
    if (!stat.isFile() || stat.size === 0) process.exit(1);
    if (file.endsWith('.json')) JSON.parse(readFileSync(file, 'utf8'));
  }
JS
  )
}

build_page() {  # a production build and its source stamp are kept together
  local ui=$1 next=$2 id identity pending="$LOGS/ui-build.pending"
  id=$(cat "$ui/.next/BUILD_ID" 2>/dev/null || true)
  if [ -n "$id" ] && [ ! -e "$pending" ] && [ -z "$(find "$ui/app" "$ui/components" "$ui/hooks" "$ui/lib" "$ui/styles" "$ui/fonts" \
      "$ui/public" "$ui/next.config.ts" "$ui/package.json" "$ui/pnpm-lock.yaml" "$ui/postcss.config.mjs" \
      "$ui/tsconfig.json" -newer "$ui/.next/BUILD_ID" -print -quit 2>/dev/null)" ] && page_build_complete "$ui"; then
    # A build without its stamp tells us when it was built, but cannot prove which checkout built it.
    [ -n "$(page_source "$id")" ] || stamp_page "$ui/.next" "$id" "unknown unknown"
    return 0
  fi
  echo "  ui: building"
  stop ui "$UI_PORT" || return 1  # a clean build; a running server must not write into it
  identity=$(source_identity)
  mine "$pending"  # Next can write BUILD_ID before finishing; it proves nothing if this build did not finish
  # (.next-test/types: a test build's generated types may refer to a page that was removed)
  (cd "$ui" && rm -rf .next .next-test/types && NEXT_TELEMETRY_DISABLED=1 "$next" build >"$LOGS/ui-build.log" 2>&1) \
    || { echo "  ui build failed; see logs/ui-build.log"; return 1; }
  rm -f "$pending"
  id=$(cat "$ui/.next/BUILD_ID" 2>/dev/null || true)
  if [ -n "$id" ]; then stamp_page "$ui/.next" "$id" "$identity"; else echo "  ui: could not record build source"; fi
}

