+@pytest.mark.parametrize("profile", ["codex-cli", "direct-openai"])
+def test_gpt_6_2_sol_has_the_exact_shape_of_gpt_6_1_sol(profile):
+    older, newer = GLASSHIVE_MODELS[f"{profile}:gpt-6.1-sol"], GLASSHIVE_MODELS[f"{profile}:gpt-6.2-sol"]
+    assert (newer.id, newer.harness_profile, newer.native_model) == (f"{profile}:gpt-6.2-sol", profile, "gpt-6.2-sol")
+    assert newer.display_name == older.display_name.replace("GPT-6.1 Sol", "GPT-6.2 Sol")
+    assert (newer.effort_choices, newer.recommended_effort, newer.context_window) == (
+        older.effort_choices, older.recommended_effort, older.context_window)
+    assert newer.api_payload(readiness={})["native_model"] == "gpt-6.2-sol"
