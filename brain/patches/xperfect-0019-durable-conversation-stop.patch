+        """Positive native ownership plus no foreign conversation reference, under the close fence."""
+        claims = [row[0] for row in conn.execute(
+            "SELECT conversation_id FROM coordinator_owned_workers WHERE worker_id=? UNION "
+            "SELECT conversation_id FROM provider_sessions WHERE worker_id=? AND tenant_id=? AND owner_id=?",
+            (worker_id, worker_id, tenant, owner))]
+        delegations = conn.execute("SELECT * FROM delegations WHERE worker_id=?", (worker_id,)).fetchall()
+        for work in delegations:
+            goal = conn.execute("SELECT 1 FROM coordinator_goals WHERE conversation_id=? AND "
+                "?=conversation_id || ':' || goal_id AND ?=conversation_id || ':' || goal_id",
+                (conversation_id, work["idempotency_key"], work["origin_ref"])).fetchone()
+            if work["tenant_id"] != tenant or work["owner_id"] != owner or work["origin_surface"] != "coordinator" or not goal:
+                return False
+            claims.append(conversation_id)
+        if not claims or any(claim != conversation_id for claim in claims):
+            return False
