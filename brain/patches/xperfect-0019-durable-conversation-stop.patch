+        assert core.store.get_worker(worker_id)['state'] == 'terminating'
+        with pytest.raises(WorkerClosedStoreError): schedule(core, worker_id)
+        raise RuntimeError('Synthetic unconfirmed compute')
+    def pending_native(*_args, **_kwargs):
+        assert core.store.get_schedule(pending['schedule_id'])['state'] == 'cancelled'
+        assert core.store.get_worker(worker_id)['state'] == 'terminating'
+        with pytest.raises(WorkAdmissionError):
