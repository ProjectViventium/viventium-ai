+def test_close_request_checks_claim_again_when_worker_is_shared(owned):
+    core, cid, worker_id, command = owned
+    first = dispatch(owned)
+    config = CoordinatorConfig(model='exact-native-model', effort='high',
+        scope=CoordinatorScope(project_id=core.store.get_worker(worker_id)['project_id']))
