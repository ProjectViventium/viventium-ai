+            "SELECT 1 FROM coordinator_goals WHERE conversation_id<>? AND (worker_id=? OR "
+            "(json_valid(dispatch_json) AND json_extract(dispatch_json,'$.worker_id')=?)) LIMIT 1",
+            (conversation_id, worker_id, worker_id)).fetchone()
