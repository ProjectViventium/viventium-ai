+                "SELECT worker_id FROM coordinator_goals WHERE conversation_id=? UNION "
+                "SELECT d.worker_id FROM delegations d JOIN coordinator_goals g "
+                "ON d.idempotency_key=g.conversation_id || ':' || g.goal_id "
