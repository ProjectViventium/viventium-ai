+    def _provider_route_owner(self, worker: dict) -> str:
+        """Whose cooling record a route is: the Worker's owner, or, for a Worker bound to a named provider account,
+        that account's. A limit on one account (its own sign-in, its own plan) never holds another account of the
+        same provider, which is why an owner connects a second one."""
+        owner = str(worker.get("owner_id") or "").strip()
+        selection = (self._bootstrap_bundle_for(worker) or {}).get("provider_account")
+        account = str(selection.get("account_id") or "").strip() if isinstance(selection, dict) else ""
+        return f"{owner}#account:{account}" if owner and account else owner
