+def test_attended_permission_deadline_stops_an_unresponsive_native_peer(tmp_path):
+    import signal
+    from workers_projects_runtime import grok_acp_runner
+
+    peer = tmp_path / 'grok'
+    peer.write_text(PERMISSION_FIXTURE.replace('PYTHON', sys.executable)
+                    .replace("{'id':'cached_token'}", "{'id':'grok.com','_meta':{'external_provider':True}}")
+                    .replace("while reply.get('id')!='perm-1': reply=json.loads(sys.stdin.readline())",
+                             "import time; time.sleep(30)"))
+    peer.chmod(0o700)
+    run = ("import functools, sys\n"
+           "from workers_projects_runtime import grok_acp_runner as r\n"
+           "r.ControlMailbox = functools.partial(r.ControlMailbox, permission_timeout=.2)\n"
+           "sys.exit(r.main(sys.argv[1:]))\n")
+    command = [sys.executable, '-c', run, '--binary', str(peer), '--model', 'grok-selected',
+               '--control-dir', str(tmp_path / 'control'), '--run-id', 'run', '--attempt-id', 'attempt']
+    env = {**os.environ, 'GROK_HOME': str(tmp_path / 'home'), 'GROK_AUTH_PATH': '/dev/null/auth.json',
+           'WPR_GROK_ATTENDED': '1', 'PYTHONPATH': str(Path(grok_acp_runner.__file__).parents[1])}
+    with subprocess.Popen(command, env=env, cwd=tmp_path, text=True, stdin=subprocess.PIPE,
+                          stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True) as runner:
+        try:
+            output, error = runner.communicate('Synthetic instruction', timeout=5)
+        finally:
