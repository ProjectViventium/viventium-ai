+def test_local_macos_claude_accounts_are_explicit_and_single_user(monkeypatch):
+    """A named Claude subscription account on a Mac: refused as before, unless this is the single-user local host
+    and its owner switched GLASSHIVE_ENABLE_LOCAL_MACOS_CLAUDE_ACCOUNTS on; then it is a route like any other, at
+    setup and when a Worker starts on it. Never on a hosted, contained or multi-user deployment."""
+    from workers_projects_runtime import provider_accounts as pa
+
+    local = {"GLASSHIVE_SECURITY_MODE": "local", "GLASSHIVE_AUTH_MODE": "local", "WPR_DEFAULT_EXECUTION_MODE": "host"}
+    for name in ("GLASSHIVE_ENABLE_LOCAL_MACOS_CLAUDE_ACCOUNTS", "GLASSHIVE_PROVIDER_ACCOUNT_ISOLATION",
+                 "GLASSHIVE_ENABLE_HOSTED_MODE", "GLASSHIVE_ENTERPRISE_MODE", "WPR_ENTERPRISE_MODE"):
+        monkeypatch.delenv(name, raising=False)
+    for key, value in local.items():
+        monkeypatch.setenv(key, value)
+    monkeypatch.setattr(pa, "provider_setup_binary", lambda provider: "/usr/local/bin/claude")
+    homes = pa.ProviderAccountHomeManager.__new__(pa.ProviderAccountHomeManager)
+
+    def support() -> str:
+        return pa.provider_platform_support(provider="claude", auth_method="subscription", platform_name="darwin")
+
+    def route_ok() -> bool:
+        try:
+            homes.require_supported_route(provider="claude", auth_method="subscription", execution_mode="host",
+                                          platform_name="darwin", hosted_consumer_auth_enabled=False)
+            return True
+        except pa.ControlPlaneError:
+            return False
+
+    assert support() == "unsupported_macos_host" and not route_ok()
+    monkeypatch.setenv("GLASSHIVE_ENABLE_LOCAL_MACOS_CLAUDE_ACCOUNTS", "1")
+    assert support() == "supported" and route_ok()
+    monkeypatch.setenv("GLASSHIVE_SECURITY_MODE", "multi_user")
+    assert support() != "supported" and not route_ok()
+    monkeypatch.setenv("GLASSHIVE_SECURITY_MODE", "local")
+    monkeypatch.setenv("GLASSHIVE_PROVIDER_ACCOUNT_ISOLATION", "per_worker_container")
+    assert support() == "unsupported_macos_host" and not route_ok()
+    monkeypatch.delenv("GLASSHIVE_PROVIDER_ACCOUNT_ISOLATION")
+    monkeypatch.setenv("WPR_DEFAULT_EXECUTION_MODE", "docker")
+    assert support() == "unsupported_macos_host"
+    monkeypatch.setenv("WPR_DEFAULT_EXECUTION_MODE", "host")
+    # Linux and the other providers are as they were.
+    assert pa.provider_platform_support(provider="claude", auth_method="subscription", platform_name="linux") == "provider_permission_required"
+
