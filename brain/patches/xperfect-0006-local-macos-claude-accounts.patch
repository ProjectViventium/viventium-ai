+def _local_macos_claude_accounts() -> bool:
+    """Named Claude subscription accounts on this Mac: only on the explicit single-user local host, and only when
+    its owner switched them on (GLASSHIVE_ENABLE_LOCAL_MACOS_CLAUDE_ACCOUNTS). Claude Code keeps one Keychain
+    login per CLAUDE_CONFIG_DIR ("Claude Code-credentials-<hash>"), so each account home signs in on its own; the
+    owner's own sign-in is not read, copied or changed. Hosted, contained or multi-user deployments are unchanged."""
+    return (
+        _env_enabled("GLASSHIVE_ENABLE_LOCAL_MACOS_CLAUDE_ACCOUNTS")
+        and str(os.environ.get("GLASSHIVE_SECURITY_MODE") or "").strip().lower() == "local"
+        and str(os.environ.get("GLASSHIVE_AUTH_MODE") or "").strip().lower() == "local"
+        and str(os.environ.get("WPR_DEFAULT_EXECUTION_MODE") or "").strip().lower() == "host"
+        and str(os.environ.get("GLASSHIVE_PROVIDER_ACCOUNT_ISOLATION") or "").strip().lower() != "per_worker_container"
+        and not any(_env_enabled(name) for name in ("GLASSHIVE_ENABLE_HOSTED_MODE", "GLASSHIVE_ENTERPRISE_MODE", "WPR_ENTERPRISE_MODE"))
+    )
+
+
 def provider_platform_support(
     *,
     provider: str,
@@ -251,6 +266,8 @@ def provider_platform_support(
         if isolation_mode != "per_worker_container":
             return "isolated_substrate_required"
     if normalized_provider in {"claude", "anthropic"}:
+        if current_platform == "darwin" and _local_macos_claude_accounts():
+            return "supported" if provider_setup_binary(normalized_provider) else "setup_cli_required"
         if current_platform == "darwin":
             return "unsupported_macos_host"
         if not _env_enabled("GLASSHIVE_ENABLE_HOSTED_CLAUDE_CONSUMER_AUTH"):
@@ -708,6 +725,8 @@ class ProviderAccountHomeManager:
     ) -> None:
