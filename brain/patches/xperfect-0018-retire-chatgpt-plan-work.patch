+"""Upgrade from a saved plan Worker or Coordinator with native Codex available."""
+import json
+from unittest.mock import Mock
+
+import pytest
+from test_coordinator_existing_worker import existing  # noqa: F401
+from workers_projects_runtime.coordinator import Control, CoordinatorConflict, canonical
+from workers_projects_runtime.mission_provider_accounts import native_current_account_allowed
+from workers_projects_runtime.openclaw_runtime import RuntimeErrorBase
+
+
+REASON = "ChatGPT plan background work ended. Its workspace and receipts were kept."
+
+
+def test_saved_plan_worker_cannot_dispatch_on_native_authority(existing):
+    core, cid, worker_id, command = existing
+    worker = core.store.get_worker(worker_id)
+    bundle = {**json.loads(worker["bootstrap_bundle_json"]), "external_plan_session": "fixture-plan-session"}
+    core.store.update_worker(worker_id, bootstrap_bundle_json=json.dumps(bundle), profile="codex-cli")
+    core.service.assign_run = assigned = Mock(return_value={"run_id": "unexpected-native-run"})
+    with core.store._connect() as conn:
+        # The upgrade lands after a dispatch was saved and before its assignment.
+        conn.execute("UPDATE coordinator_goals SET dispatch_json=?,worker_id=? WHERE conversation_id=?",
+                     (canonical(command.request_payload()), worker_id, cid))
+    [outcome] = core.recover_dispatches("local", "owner", cid)
+    assigned.assert_not_called()
+    assert outcome["state"] == "failed" and outcome["error_text"] == REASON
+    assert not outcome["run_id"]
+    assert json.loads(core.store.get_worker(worker_id)["bootstrap_bundle_json"]) == bundle
+    assert not native_current_account_allowed(core.store.get_worker(worker_id))
+    assert native_current_account_allowed(worker)
+    core.service._consume_local_qa = preflight = Mock()
+    with pytest.raises(RuntimeErrorBase, match="background work ended"):
+        core.service._run_local_admitted_worker(core.store.get_worker(worker_id), {"run_id": "saved-run"})
+    preflight.assert_not_called()
+    with pytest.raises(CoordinatorConflict, match="background work ended"):
+        core.control("local", "owner", cid, command.goal_id,
+                     Control(action="resume", idempotency_key="resume", run_id=""))
+    assert core.recover_dispatches("local", "owner", cid) == []
+
+
+def test_saved_plan_coordinator_cannot_start_or_accept_more_work(existing):
+    core, cid, _, command = existing
+    with core.store._connect() as conn:
+        saved = conn.execute("SELECT config_json FROM coordinator_conversations WHERE conversation_id=?", (cid,)).fetchone()
+        config = json.loads(saved[0])
+        config["bootstrap_bundle"]["external_plan_session"] = "fixture-plan-session"
+        conn.execute("UPDATE coordinator_conversations SET config_json=? WHERE conversation_id=?",
+                     (json.dumps(config), cid))
+    core.provider.start = start = Mock()
+    outcome = core.start_turn("local", "owner", cid, "turn")
+    start.assert_not_called()
+    assert outcome["message"] == REASON
+    turn = core.snapshot("local", "owner", cid)["turns"][0]
+    assert turn["blocker"] == "chatgpt_plan_retired"
+    assert turn["message"] == "Exact user goal.\nKeep  two spaces."
+    with pytest.raises(CoordinatorConflict, match="background work ended"):
+        core.dispatch("local", "owner", cid, command)
+    with pytest.raises(CoordinatorConflict, match="background work ended"):
+        core.accept_turn("local", "owner", cid, "next", "Follow up")
