diff --git a/runtime_phase1/tests/test_grok_external_auth.py b/runtime_phase1/tests/test_grok_external_auth.py
new file mode 100644
--- /dev/null
+++ b/runtime_phase1/tests/test_grok_external_auth.py
@@ -0,0 +1,87 @@
+import json
+import os
+import sys
+from io import StringIO
+
+import pytest
+
+from workers_projects_runtime import grok_acp, grok_acp_runner
+from workers_projects_runtime.failure_classification import classify_cli_failure
+from workers_projects_runtime.grok_runtime import HostGrokBuildRuntime
+
+
+@pytest.mark.parametrize('section', ['auth', 'grok_com_config'])
+def test_external_auth_boots_from_worker_config_without_consulting_current_login(tmp_path, monkeypatch, section):
+    runtime = HostGrokBuildRuntime(str(tmp_path / 'runtime'))
+    worker = {'worker_id': 'worker', 'profile': 'grok-build'}
+    home = runtime._grok_home(worker)
+    home.mkdir(parents=True)
+    (home / 'config.toml').write_text(f'[{section}]\nauth_provider_command = "/local/provider"\n')
+    monkeypatch.setattr(runtime, '_host_env', lambda _: {})
+    current_login = []
+    monkeypatch.setattr(runtime, '_current_host_auth_path', lambda _: current_login.append(True))
+
+    env = runtime._native_environment(worker, host=True)
+
+    assert env['GROK_AUTH_PATH'] == '/dev/null/auth.json'
+    assert not current_login
+    assert not (home / 'auth.json').exists()
+
+
+@pytest.mark.parametrize('outcome', ['success', 'signed_out', 'refused', 'timeout', 'unadvertised'])
+def test_external_auth_stops_or_opens_session_on_native_evidence(tmp_path, monkeypatch, capfd, outcome):
+    peer = tmp_path / 'grok'
+    peer.write_text('#!' + sys.executable + '\n' + f'outcome = {outcome!r}\n' + '''
+import json, sys, time
+
+def send(data):
+    print(json.dumps({'jsonrpc': '2.0', **data}), flush=True)
+
+for line in sys.stdin:
+    request = json.loads(line)
+    method = request['method']
+    if method == 'initialize':
+        result = {'protocolVersion': 1, '_meta': {'grokShell': True},
+                  'authMethods': [{'id': 'grok.com', '_meta': {'external_provider': outcome != 'unadvertised'}}]}
+    elif method == 'authenticate':
+        assert request['params'] == {'methodId': 'grok.com', '_meta': {'headless': True}}
+        if outcome == 'timeout':
+            time.sleep(30)
+        if outcome != 'success':
+            send({'id': request['id'], 'error': {'code': -32000, 'message': 'private failure detail'}})
+            continue
+        result = {}
+    elif method == 'session/new':
+        assert outcome == 'success'
+        result = {'sessionId': 'synthetic', 'models': {'currentModelId': 'grok-selected'}}
+    elif method == 'session/prompt':
+        send({'method': 'session/update', 'params': {'sessionId': 'synthetic', 'update': {
+            'sessionUpdate': 'agent_message_chunk', 'content': {'type': 'text', 'text': 'Synthetic result'}}}})
+        result = {'stopReason': 'end_turn'}
+    else:
+        raise AssertionError(method)
+    send({'id': request['id'], 'result': result})
+''')
+    peer.chmod(0o700)
+    monkeypatch.setenv('GROK_HOME', str(tmp_path / 'home'))
+    monkeypatch.setenv('GROK_AUTH_PATH', '/dev/null/auth.json')
+    monkeypatch.setattr(grok_acp, 'EXTERNAL_AUTH_TIMEOUT', 1.0, raising=False)
+    monkeypatch.setattr(sys, 'stdin', StringIO('Synthetic instruction'))
+
+    status = grok_acp_runner.main(['--binary', os.fspath(peer), '--model', 'grok-selected'])
+    captured = capfd.readouterr()
+    events = [json.loads(line) for line in captured.out.splitlines()]
+    if outcome == 'success':
+        assert status == 0
+        started = next(event for event in events if event['type'] == 'grok.session.started')
+        assert started['auth_method'] == 'external_provider'
+        assert events[-1]['output'] == 'Synthetic result'
+        return
+
+    assert status == 2
+    assert not any(event.get('phase') == 'prompt_started' for event in events)
+    assert 'private failure detail' not in captured.out + captured.err
+    assert events[-1]['failure_class'] == 'provider_auth_missing'
+    failure = classify_cli_failure(stdout=captured.out, stderr=captured.err, runtime_name='grok-build', exit_code=2)
+    assert failure.failure_class == 'provider_auth_missing'
+    assert 'sign in' in failure.user_message.lower()
