@@ -0,0 +1,143 @@
+"""A standalone local owner's worker access grant for one host Grok Worker.
+
+The grant is not a bootstrap bundle field: no create, assign, find-or-resume, duplicate or route bundle can carry,
+create or extend one. It is one insert-only row per Worker, minted only with a proof made from a key that lives in
+this instance's private state (never in an environment variable, config.json or a bearer token), and it carries the
+deny list it was minted under. A restriction seen on a granted Worker is latched in its row for good.
+"""
+from __future__ import annotations
+
+import hashlib
+import hmac
+import json
+import math
+import os
+import re
+import secrets
+import stat
+from pathlib import Path
+from typing import Any
+
+GRANT_KEY_FILE = "worker-access-grant.key"
+MAX_GRANT_SECONDS = 24 * 3600.0
+# The question window an ungranted Grok request already has (grok_control.ControlMailbox's default).
+GRANT_INPUT_WINDOW_SECONDS = 60
+# Tool names Grok's permission rules recognise; Grok skips any other name with a warning, so one is refused here.
+GROK_DENY_TOOLS = ("Bash", "Read", "Edit", "Write", "Grep", "Glob", "MCPTool", "WebFetch", "WebSearch")
+_RULE = re.compile(r"\*|(?:" + "|".join(GROK_DENY_TOOLS) + r")(?:\(.+\))?")
+_MCP_RULE = re.compile(r"mcp__(?:\*|[a-zA-Z0-9-]+(?:_[a-zA-Z0-9-]+)*(?:__[a-zA-Z0-9_*-]+)?)")
+
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS worker_access_grants (
+    worker_id TEXT PRIMARY KEY,
+    tenant_id TEXT NOT NULL,
+    owner_id TEXT NOT NULL,
+    expires_at REAL NOT NULL,
+    deny_rules_json TEXT NOT NULL,
+    proof TEXT NOT NULL,
+    restricted INTEGER NOT NULL DEFAULT 0,
+    created_at REAL NOT NULL
+);
+CREATE TRIGGER IF NOT EXISTS worker_access_restricted_latch
+AFTER UPDATE OF bootstrap_bundle_json ON workers
+WHEN json_valid(NEW.bootstrap_bundle_json)
+ AND json_type(NEW.bootstrap_bundle_json, '$.provider_capabilities.native_tools') = 'false'
+BEGIN
+    UPDATE worker_access_grants SET restricted = 1 WHERE worker_id = NEW.worker_id;
+END;
+"""
+
+
+class WorkerAccessGrantError(ValueError):
+    """A grant that cannot be minted; the message names why, never a secret."""
+
+
+def deny_rules(value: Any) -> list[str]:
+    """The owner's Grok deny rules, each one Grok recognises: refused whole when any is not."""
+    if (not isinstance(value, list) or not 1 <= len(value) <= 256
+            or any(not isinstance(rule, str) or len(rule) > 1000 or not rule.isprintable()
+                   or not (_RULE.fullmatch(rule.strip()) or _MCP_RULE.fullmatch(rule.strip()))
+                   for rule in value)):
+        raise WorkerAccessGrantError("Grok deny rules must be a non-empty list of rules Grok recognises")
+    return list(dict.fromkeys(rule.strip() for rule in value))
+
+
+def native_deny_rules(value: Any) -> list[str]:
+    """Express supported Claude MCP rules using Grok's native matcher."""
+    native = []
+    for rule in deny_rules(value):
+        if rule.startswith("mcp__"):
+            server, _, tool = rule.removeprefix("mcp__").partition("__")
+            pattern = "*" if server == "*" else f"{server}__{tool or '*'}"
+            rule = f"MCPTool({pattern})"
+        native.append(rule)
+    return native
+
+
+def owner_deny_rules_from_environment() -> list[str]:
+    """The instance's WPR_GROK_DENY (owner configuration); [] when unset, refused when invalid."""
+    raw = os.environ.get("WPR_GROK_DENY", "").strip()
+    if not raw:
+        return []
+    try:
+        value = json.loads(raw)
+    except ValueError:
+        value = None
+    return deny_rules(value)
+
+
+def ensure_grant_key(data_root: Path) -> Path:
+    """This instance's private grant key, made once: a regular file of this user, readable by no one else."""
+    path = Path(data_root) / GRANT_KEY_FILE
+    try:
+        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+    except FileExistsError:
+        read_grant_key(path)
+        return path
+    with os.fdopen(descriptor, "w") as handle:
+        handle.write(secrets.token_hex(32) + "\n")
+    return path
+
+
+def read_grant_key(path: Path) -> bytes:
+    info = os.lstat(path)
+    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
+            or stat.S_IMODE(info.st_mode) & 0o077):
+        raise WorkerAccessGrantError("The worker access grant key is not this owner's private file")
+    key = Path(path).read_text().strip()
+    if not re.fullmatch(r"[0-9a-f]{64}", key):
+        raise WorkerAccessGrantError("The worker access grant key is malformed")
+    return bytes.fromhex(key)
+
+
+def grant_proof(key: bytes, worker_id: str, expires_at: float, rules: list[str]) -> str:
+    """The proof the owner's own client sends: it binds the Worker, the expiry and the deny list."""
+    digest = hashlib.sha256(json.dumps(list(rules), separators=(",", ":")).encode()).hexdigest()
+    message = json.dumps({"v": 1, "worker_id": worker_id, "expires_at": round(float(expires_at), 3),
+                          "deny_sha256": digest}, sort_keys=True, separators=(",", ":"))
+    return hmac.new(key, message.encode(), hashlib.sha256).hexdigest()
+
+
+def finite_expiry(value: Any) -> float:
+    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or value <= 0:
+        raise WorkerAccessGrantError("A grant needs a finite expiry")
+    return round(float(value), 3)
+
+
+def ensure_schema(conn) -> None:
+    """Made on first use beside the existing schema: a database of an earlier tree opens unchanged."""
+    from .schema_version import execute_schema_script
+    execute_schema_script(conn, SCHEMA)
+
+
+def get_grant(conn, worker_id: str) -> dict | None:
+    row = conn.execute(
+        "SELECT worker_id, tenant_id, owner_id, expires_at, deny_rules_json, proof, restricted, created_at "
+        "FROM worker_access_grants WHERE worker_id = ?", (worker_id,)).fetchone()
+    if row is None:
+        return None
+    keys = ("worker_id", "tenant_id", "owner_id", "expires_at", "deny_rules_json", "proof", "restricted", "created_at")
+    record = dict(zip(keys, tuple(row)))
+    record["deny_rules"] = json.loads(record.pop("deny_rules_json"))
+    record["restricted"] = bool(record["restricted"])
+    return record
