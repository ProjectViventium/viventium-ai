+def test_no_bundle_path_creates_or_extends_a_grant(service):
+    offered = {"worker_access_grant": {"version": 1, "worker_access": "full", "execution_mode": "host",
+                                       "expires_at": time.time() + 30 * 24 * 3600}}
+    with pytest.raises(ParallelExecutionIsolationError):
+        make(service, offered)
+    worker = make(service)
+    grant = mint(service, worker)
+    for bundle_kind in ("runtime_bundle", "run_local_bundle"):
+        with pytest.raises(ParallelExecutionIsolationError):
+            service.assign_run(worker["worker_id"], "task", start_processor=False, resume_paused_worker=False,
+                               **{bundle_kind: offered})
+    with pytest.raises(ParallelExecutionIsolationError):
+        service.find_or_create_worker(project_id=worker["project_id"], owner_id="owner-a", name="Job worker",
+                                      role="worker", profile="grok-build", backend="", alias="Job worker",
+                                      execution_mode="host", bootstrap_bundle=offered, start_synchronously=False)
+    assert service.worker_access_grant_record(worker["worker_id"]) == grant
