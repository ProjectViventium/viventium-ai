+# -- minting: the local owner's own path only --
+
+def test_the_owners_proof_mints_one_immutable_grant(service):
+    worker = make(service)
+    expires = round(time.time() + 3600, 3)
+    first = mint(service, worker, expires)
+    assert first["expires_at"] == expires and first["deny_rules"] == DENY and not first["restricted"]
+    assert mint(service, worker, expires) == first  # (the same request again: the same record)
+    for later in (expires + 600, expires - 600):  # (never widened, never moved)
+        with pytest.raises(WorkerAccessGrantError):
+            mint(service, worker, later)
+    assert service.worker_access_grant_record(worker["worker_id"])["expires_at"] == expires
+    assert "worker_access_grant" not in bundle_of(service, worker)
+
+
+def test_a_bearer_caller_without_the_owners_key_cannot_mint(service, tmp_path):
+    worker = make(service)
+    other = tmp_path / "other"
+    other.mkdir()
+    with pytest.raises(WorkerAccessGrantError, match="proof"):
+        mint(service, worker, key=read_grant_key(ensure_grant_key(other)))
+    with pytest.raises(WorkerAccessGrantError, match="proof"):
+        service.mint_worker_access_grant(worker["worker_id"], expires_at=time.time() + 60, deny_rules=DENY, proof="")
+    assert service.worker_access_grant_record(worker["worker_id"]) is None
+
