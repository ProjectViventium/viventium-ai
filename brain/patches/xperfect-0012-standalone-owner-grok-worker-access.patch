+def test_a_grant_is_refused_outside_the_local_owners_own_grok_worker(service, monkeypatch, case):
+    worker = make(service, tenant="other-tenant") if case == "tenant" else \
+        make(service, owner="someone-else") if case == "owner" else \
+        make(service, profile="codex-cli") if case == "profile" else make(service)
+    expires, rules = None, DENY
+    if case == "delegation":
+        monkeypatch.setattr(service.store, "get_delegation_for_worker", lambda *a, **k: {"origin_ref": "helper"})
+    if case == "not_standalone":
+        monkeypatch.setenv("GLASSHIVE_AUTH_MODE", "service")
+    if case == "too_long":
+        expires = time.time() + 3 * 24 * 3600
+    if case == "expired":
+        expires = time.time() - 1
+    if case == "no_deny_list":
+        monkeypatch.setenv("WPR_GROK_DENY", "")
+    if case == "other_deny_list":
+        rules = DENY[:1]
+    if case == "unrecognised_rule":
+        rules = ["CronCreate", *DENY]
+        monkeypatch.setenv("WPR_GROK_DENY", json.dumps(rules))
+    with pytest.raises(WorkerAccessGrantError):
+        mint(service, worker, expires, rules)
+    assert service.worker_access_grant_record(worker["worker_id"]) is None
