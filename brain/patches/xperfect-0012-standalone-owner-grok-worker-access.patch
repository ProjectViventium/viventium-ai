+def test_under_a_grant_a_command_grok_still_asks_about_is_refused_at_once_and_never_published(tmp_path):
+    from types import SimpleNamespace
+    from workers_projects_runtime.grok_control import ControlMailbox
+    events = []
+    root = tmp_path / "control"
+    mailbox = ControlMailbox(root, run_id="run-1", attempt_id="attempt-1",
+                             session=SimpleNamespace(session_id="native-id"), event=events.append,
+                             permission_deadline_at=time.time() + 3600, input_window=60, refuse_permissions=True)
+    began = time.monotonic()
+    answer = mailbox.permission({"sessionId": "native-id", "toolCall": {"title": "Execute `bash -c \"$(echo x)\"`"},
+                                 "options": [{"optionId": "allow-once", "kind": "allow_once"},
+                                             {"optionId": "reject-once", "kind": "reject_once"}]})
+    assert answer == "reject-once" and time.monotonic() - began < 1
+    assert not list(root.glob("*.pending"))  # (nothing the Worker could answer for itself)
+    assert events[-1]["type"] == "grok.permission.refused" and events[-1]["reason"] == "owner_grant"
