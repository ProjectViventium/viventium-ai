+def test_a_restriction_committed_before_mint_is_latched(service, monkeypatch):
+    from workers_projects_runtime import owner_worker_access
+
+    worker = make(service)
+
+    def restrict_before_insert(*args):
+        service.store.update_worker(worker["worker_id"], bootstrap_bundle_json=json.dumps(
+            {**bundle_of(service, worker), "provider_capabilities": {"native_tools": False}}))
+        return grant_proof(*args)
+
+    monkeypatch.setattr(owner_worker_access, "grant_proof", restrict_before_insert)
+    mint(service, worker)
+    service.store.update_worker(worker["worker_id"], bootstrap_bundle_json=json.dumps(
+        {**bundle_of(service, worker), "provider_capabilities": {"native_tools": True}}))
+    assert service.worker_access_grant_record(worker["worker_id"])["restricted"]
