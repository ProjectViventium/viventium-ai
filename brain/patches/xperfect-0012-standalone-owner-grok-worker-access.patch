+def test_the_grants_expiry_ends_approval_mid_turn(tmp_path):
+    returned, events, started, took = runner_case(tmp_path, mode="5", deadline=1.0, ignore_cancel=True, supervise=True)
+    assert started and any(event.get("phase") == "prompt_started" for event in events)
+    assert returned != 0 and events[-1]["failure_class"] == "native_authority_expired"
+    assert took < 3  # The native process ignores ACP cancel and would run for five seconds.
+    assert (tmp_path / "exit_code").read_text().strip() == str(-signal.SIGKILL)
+
+
+@pytest.mark.parametrize("manifest", ["null", "invalid-json"])
+def test_a_null_or_malformed_ceiling_blocks_start_and_warm_attach(tmp_path, manifest):
+    returned, events, started, _ = runner_case(tmp_path, ceiling_text=manifest, warm=True)
+    assert returned == 2 and not started
+    assert events[-1]["failure_class"] == "native_ceiling_unverified"
+    assert not any(event.get("phase", "").startswith("warm_") for event in events)
+
+
+def test_a_question_rejects_an_unfingerprinted_reply_after_its_window(tmp_path):
+    from types import SimpleNamespace
+    from workers_projects_runtime.grok_control import ControlMailbox
+
+    expired_reply = []
+
+    def observe(event):
+        if event["type"] == "grok.permission.requested":
+            # The waiter has published the question but has not polled its deadline yet.
+            time.sleep(0.12)
+            with pytest.raises(ValueError, match="expired"):
+                mailbox._handle({"action": "permission", "run_id": "run-1", "attempt_id": "attempt-1",
+                                 "session_id": "native-id", "request_id": event["request_id"], "response": "late"})
+            expired_reply.append(True)
+
+    mailbox = ControlMailbox(tmp_path / "control", run_id="run-1", attempt_id="attempt-1",
+                             session=SimpleNamespace(session_id="native-id"), event=observe,
+                             permission_deadline_at=time.time() + 3600, input_window=0.05)
+    assert mailbox.interaction("x.ai/ask_user_question", {"sessionId": "native-id"}) is None
+    assert expired_reply == [True] and mailbox.terminal_cause() == "expired"
+
+
+def test_a_question_window_starts_when_the_question_is_asked(tmp_path):
+    from types import SimpleNamespace
+    from workers_projects_runtime.grok_control import ControlMailbox
+    events = []
+    mailbox = ControlMailbox(tmp_path / "control", run_id="run-1", attempt_id="attempt-1",
+                             session=SimpleNamespace(session_id="native-id"), event=events.append,
+                             permission_deadline_at=time.time() + 3600, input_window=0.5)
+    time.sleep(0.8)  # (past the window counted from the mailbox's start)
+    began = time.monotonic()
+    answer = mailbox.interaction("x.ai/ask_user_question", {"sessionId": "native-id"})
+    waited = time.monotonic() - began
+    assert answer is None and 0.4 <= waited < 3
+    assert any(event.get("reason") == "expired" for event in events if event["type"] == "grok.permission.response_submitted")
+
