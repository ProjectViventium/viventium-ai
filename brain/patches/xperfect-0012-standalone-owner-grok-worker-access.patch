+"""A standalone local owner's Grok worker access grant: who can mint it, what it binds, how it ends, its ceiling."""
+from __future__ import annotations
+
+import json
+import os
+import signal
+import sqlite3
+import subprocess
+import sys
+import threading
+import time
+from pathlib import Path
+
+import pytest
+
+from workers_projects_runtime.broker_admission import BrokerAdmissionError
+from workers_projects_runtime.grok_runtime import HostGrokBuildRuntime
+from workers_projects_runtime.openclaw_runtime import RuntimeInfo, StubRuntime
+from workers_projects_runtime.owner_worker_access import (WorkerAccessGrantError, deny_rules, ensure_grant_key,
+                                                          grant_proof, read_grant_key)
+from workers_projects_runtime.service import ParallelExecutionIsolationError, WorkersProjectsService
+from workers_projects_runtime.store import Store
+
+LEASE = "a" * 64
+DENY = ["Bash(sudo *)", "Bash(spctl *)"]
+STANDALONE = {"GLASSHIVE_SECURITY_MODE": "local", "GLASSHIVE_AUTH_MODE": "local", "WPR_DEFAULT_EXECUTION_MODE": "host",
+              "GLASSHIVE_HOST_WORKERS_ENABLED": "true", "WPR_MODEL_GROK_BUILD": "grok-selected",
+              "GLASSHIVE_DEFAULT_OWNER_ID": "owner-a", "WPR_GROK_DENY": json.dumps(DENY)}
+
+
+@pytest.fixture
+def standalone(monkeypatch, tmp_path):
+    for name, value in STANDALONE.items():
+        monkeypatch.setenv(name, value)
+    for name in ("XPERFECT_EXECUTION_PROFILE", "VIVENTIUM_PARALLEL_WORK_EXECUTION_MODE",
+                 "VIVENTIUM_GLASSHIVE_ISOLATED_PARALLEL_POLICY"):
+        monkeypatch.delenv(name, raising=False)
+    monkeypatch.setenv("GROK_HOME", str(tmp_path / "unconnected-grok"))  # (never this machine's own Grok home)
+
+
+@pytest.fixture
+def service(tmp_path, standalone):
+    service = WorkersProjectsService(Store(str(tmp_path / "state.db")), StubRuntime(), reconcile_on_startup=False)
+    ensure_grant_key(tmp_path)
+    yield service
+    service.shutdown()
+
+
+def make(service, bundle=None, profile="grok-build", tenant="local", owner="owner-a"):
+    project = service.create_project(owner, "Jobs", "Synthetic work", profile, tenant_id=tenant)
+    return service.create_worker(project_id=project["project_id"], owner_id=owner, name="Job worker",
+                                 role="worker", profile=profile, backend="", execution_mode="host",
+                                 bootstrap_bundle=bundle or {}, start_synchronously=False, tenant_id=tenant)
+
+
+def mint(service, worker, expires=None, rules=DENY, key=None):
+    expires = round(time.time() + 3600 if expires is None else expires, 3)
+    key = key or read_grant_key(service.worker_access_key_path())
+    return service.mint_worker_access_grant(worker["worker_id"], expires_at=expires, deny_rules=rules,
+                                            proof=grant_proof(key, worker["worker_id"], expires, rules))
+
+
+def bundle_of(service, worker):
+    return json.loads(service.store.get_worker(worker["worker_id"])["bootstrap_bundle_json"] or "{}")
+
+
+def run_worker_for(service, worker, run_local_bundle=None, runtime_bundle=None):
+    run = service.assign_run(worker["worker_id"], "Synthetic task.", start_processor=False, resume_paused_worker=False,
+                             run_local_bundle=run_local_bundle, runtime_bundle=runtime_bundle)
+    return service._run_local_worker(service.store.get_worker(worker["worker_id"]), service.store.get_run(run["run_id"]),
+                                     authority_context={"host_startup_lease_id": LEASE})
+
+
+def command(tmp_path, run_worker):
+    record = {"_active_run_id": "run-1", **run_worker, "_run_attempt_id": "attempt-1",
+              "_run_startup_token_digest": LEASE}
+    info = RuntimeInfo("grok-build", "grok-selected", "", None, None, None,
+                       str(tmp_path / "native-state"), str(tmp_path / "workspace"), None)
+    return HostGrokBuildRuntime(str(tmp_path / "native"))._grok_command(record, info, host=True)
+
+
+def value(argv, flag):
+    return argv[argv.index(flag) + 1] if flag in argv else None
+
