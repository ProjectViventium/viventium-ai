+FIXTURE = '''#!PYTHON
+import json,os,select,sys,time
+mode=os.environ.get('FIXTURE_MODE','')
+if os.environ.get('FIXTURE_STARTED'): open(os.environ['FIXTURE_STARTED'],'w').write('started')
+buffer=b''
+def line(timeout=None):
+    global buffer
+    while b'\\n' not in buffer:
+        ready,_,_=select.select([0],[],[],timeout)
+        if not ready: return None
+        chunk=os.read(0,65536)
+        if not chunk: sys.exit(0)
+        buffer+=chunk
+    raw,buffer=buffer.split(b'\\n',1)
+    return json.loads(raw)
+def send(o): print(json.dumps(o),flush=True)
+while True:
+    r=line()
+    method=r.get('method')
+    if method=='initialize': result={'protocolVersion':1,'agentCapabilities':{},'authMethods':[{'id':'cached_token'}],'_meta':{'grokShell':True,'agentVersion':'fixture','defaultAuthMethodId':'cached_token'}}
+    elif method=='authenticate': result={}
+    elif method=='session/new':
+        if os.environ.get('FIXTURE_TAMPER'): open(os.environ['FIXTURE_TAMPER'],'w').write('[permission]\\ndeny = []\\n')
+        result={'sessionId':'native-id','models':{'currentModelId':'grok-selected'}}
+    elif method=='session/prompt':
+        end,stop=time.time()+float(mode or 0),'end_turn'
+        while time.time()<end:
+            message=line(0.05)
+            if (message and message.get('method')=='session/cancel'
+                    and not os.environ.get('FIXTURE_IGNORE_CANCEL')): stop='cancelled'; break
+        if stop=='end_turn': send({'jsonrpc':'2.0','method':'session/update','params':{'sessionId':'native-id','update':{'sessionUpdate':'agent_message_chunk','content':{'type':'text','text':'done'}}}})
+        result={'stopReason':stop}
+    else: continue
+    send({'jsonrpc':'2.0','id':r['id'],'result':result})
+'''
+
+
+def runner_case(tmp_path, *, mode="0", deny=DENY, deadline=3600, tamper=False, warm=False,
+                ceiling_text=None, ignore_cancel=False, supervise=False):
+    from workers_projects_runtime import grok_acp_runner as runner
+    fake = tmp_path / "grok-fixture"
+    fake.write_text(FIXTURE.replace("PYTHON", sys.executable))
+    fake.chmod(0o700)
+    home = tmp_path / "home"
+    home.mkdir(mode=0o700)
+    (home / "config.toml").write_text("[permission]\ndeny = " + json.dumps(deny) + "\n")
+    (home / "config.toml").chmod(0o600)
+    ceiling = tmp_path / "owner-ceiling.json"
+    ceiling.write_text(json.dumps({"home": str(home), "deny_rules": DENY}) if ceiling_text is None else ceiling_text)
+    started = tmp_path / "started"
+    env = {**os.environ, "GROK_HOME": str(home), "FIXTURE_MODE": mode, "FIXTURE_STARTED": str(started)}
+    env.pop("XAI_API_KEY", None)
+    if tamper:
+        env["FIXTURE_TAMPER"] = str(home / "config.toml")
+    if ignore_cancel:
+        env["FIXTURE_IGNORE_CANCEL"] = "1"
+    argv = [sys.executable, "-B", str(Path(runner.__file__)),
+            "--binary", str(fake), "--model", "grok-selected", "--control-dir", str(tmp_path / "control"),
+            "--run-id", "run-1", "--attempt-id", "attempt-1", "--permission-deadline-at", str(time.time() + deadline),
+            "--yolo-mode", "true", "--input-window-seconds", "60", "--stop-at-permission-deadline",
+            "--owner-ceiling-file", str(ceiling)]
+    if warm:
+        argv += ["--native-warm-lease", str(tmp_path / "no-such-lease")]
+    if supervise:
+        (tmp_path / "instruction").write_text("task")
+        (tmp_path / "start-permit").touch()
+        runtime = HostGrokBuildRuntime(str(tmp_path / "native"))
+        argv = runtime._durable_host_process_command(
+            argv, run_root=tmp_path, exit_path=tmp_path / "exit_code", timeout_sec=6,
+            stdin_path=tmp_path / "instruction", child_record_path=tmp_path / "native-child.json")
+    began = time.monotonic()
+    with subprocess.Popen(argv, cwd=tmp_path, env=env, text=True, start_new_session=True,
+                          stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE) as proc:
+        try:
+            stdout, _ = proc.communicate("task", timeout=16 if supervise else 8)
+        except subprocess.TimeoutExpired:
+            os.killpg(proc.pid, signal.SIGKILL)
+            proc.communicate(timeout=2)
+            raise
+    events = [json.loads(line) for line in stdout.splitlines() if line.startswith("{")]
+    return proc.returncode, events, started.exists(), time.monotonic() - began
+
+
+def test_the_runner_starts_grok_only_with_the_owners_deny_rules_in_its_home(tmp_path):
