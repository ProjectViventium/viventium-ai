+def _grok_config_with_deny(text, rule):
+    """Add one rule to [permission].deny without rewriting unrelated TOML bytes (as the skill policy does)."""
+    original = tomllib.loads(text)
+    permission = original.get('permission', {})
+    if not isinstance(permission, dict):
+        raise ValueError('Grok permission configuration must be a table')
+    deny = permission.get('deny', [])
+    if not isinstance(deny, list) or any(not isinstance(item, str) for item in deny):
+        raise ValueError('Grok deny rules must be a list of rule strings')
+    if rule in deny:
+        return text
+    expected = {**original, 'permission': {**permission, 'deny': [*deny, rule]}}
+    value = json.dumps(rule, ensure_ascii=False)
+    # Accept an insertion only when its parsed document changes this one list.
+    candidates = []
+    if 'permission' not in original:
+        candidates.append((len(text), '\n[permission]\ndeny = [' + value + ']\n'))
+    elif 'deny' not in permission:
+        candidates.append((0, 'permission.deny = [' + value + ']\n'))
+        candidates.append((len(text), '\ndeny = [' + value + ']\n'))
+        candidates.extend((i + 1, 'deny = [' + value + ']\n')
+                          for i, char in enumerate(text) if char == '\n')
+        candidates.extend((i, prefix + 'deny = [' + value + ']')
+                          for i, char in enumerate(text) if char == '}' for prefix in ('', ', '))
+    else:
+        candidates.extend((i, addition) for i, char in enumerate(text) if char == ']'
+                          for addition in (value, ', ' + value, value + ','))
+    for offset, addition in candidates:
+        candidate = text[:offset] + addition + text[offset:]
+        try:
+            if tomllib.loads(candidate) == expected:
+                return candidate
+        except tomllib.TOMLDecodeError:
+            continue
+    raise ValueError('Grok deny rules could not preserve the existing TOML document')
+
+
