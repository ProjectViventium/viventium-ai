+"""The review findings of 21 Nov on patch 0008 (f68135e), as behaviour: each test fails on that tree."""
+from __future__ import annotations
+
+import json
+import time
+
+import pytest
+
+from workers_projects_runtime.broker_admission import BrokerAdmissionError
+from workers_projects_runtime.grok_runtime import HostGrokBuildRuntime
+from workers_projects_runtime.openclaw_runtime import RuntimeInfo, StubRuntime
+from workers_projects_runtime.service import ParallelExecutionIsolationError, WorkersProjectsService
+from workers_projects_runtime.store import Store
+
+LEASE = "a" * 64
+DENY = ["Bash(sudo *)", "Bash(spctl *)"]
+
+
+def bundle_grant(expires_at=None):
+    return {"version": 1, "worker_access": "full", "execution_mode": "host",
+            "expires_at": time.time() + 3600 if expires_at is None else expires_at}
+
+
+@pytest.fixture
+def service(tmp_path, monkeypatch):
+    for name, value in {"GLASSHIVE_SECURITY_MODE": "local", "GLASSHIVE_AUTH_MODE": "local",
+                        "WPR_DEFAULT_EXECUTION_MODE": "host", "GLASSHIVE_HOST_WORKERS_ENABLED": "true",
+                        "WPR_MODEL_GROK_BUILD": "grok-selected", "GLASSHIVE_DEFAULT_OWNER_ID": "owner-a",
+                        "WPR_GROK_DENY": json.dumps(DENY)}.items():
+        monkeypatch.setenv(name, value)
+    for name in ("XPERFECT_EXECUTION_PROFILE", "VIVENTIUM_PARALLEL_WORK_EXECUTION_MODE",
+                 "VIVENTIUM_GLASSHIVE_ISOLATED_PARALLEL_POLICY"):
+        monkeypatch.delenv(name, raising=False)
+    monkeypatch.setenv("GROK_HOME", str(tmp_path / "unconnected-grok"))
+    service = WorkersProjectsService(Store(str(tmp_path / "state.db")), StubRuntime(), reconcile_on_startup=False)
+    try:
+        from workers_projects_runtime.owner_worker_access import ensure_grant_key
+        ensure_grant_key(tmp_path)
+    except ImportError:
+        pass
+    yield service
+    service.shutdown()
+
+
+def plain(service, bundle=None, tenant="local"):
+    project = service.create_project("owner-a", "Jobs", "Synthetic work", "grok-build", tenant_id=tenant)
+    return service.create_worker(project_id=project["project_id"], owner_id="owner-a", name="Job worker",
+                                 role="worker", profile="grok-build", backend="", execution_mode="host",
+                                 bootstrap_bundle=bundle or {}, start_synchronously=False, tenant_id=tenant)
+
+
+def granted(service, tmp_path):
+    """A Worker with an owner grant, by whatever path the tree under test offers its owner."""
+    if hasattr(service, "mint_worker_access_grant"):
+        worker = plain(service)
+        from workers_projects_runtime.owner_worker_access import grant_proof, read_grant_key
+        expires = time.time() + 3600
+        key = read_grant_key(service.worker_access_key_path())
+        service.mint_worker_access_grant(worker["worker_id"], expires_at=expires, deny_rules=DENY,
+                                         proof=grant_proof(key, worker["worker_id"], expires, DENY))
+        return service.store.get_worker(worker["worker_id"])
+    return plain(service, {"worker_access_grant": bundle_grant()})
+
+
+def admitted(service, worker):
+    run_worker = service._run_local_admitted_worker(service.store.get_worker(worker["worker_id"]), {"run_id": "run-1"},
+                                                    authority_context={"host_startup_lease_id": LEASE})
+    return run_worker
+
+
+def command(tmp_path, worker):
+    record = {"_active_run_id": "run-1", **worker, "_run_attempt_id": "attempt-1", "_run_startup_token_digest": LEASE}
+    bundle = json.loads(record.get("bootstrap_bundle_json") or "{}")
+    if isinstance(record.get("_run_local_launch_authority"), dict):
+        bundle["launch_authority"] = record["_run_local_launch_authority"]
+    record["bootstrap_bundle_json"] = json.dumps(bundle)
+    info = RuntimeInfo("grok-build", "grok-selected", "", None, None, None,
+                       str(tmp_path / "native-state"), str(tmp_path / "workspace"), None)
+    return HostGrokBuildRuntime(str(tmp_path / "native"))._grok_command(record, info, host=True)
+
+
+# 1. Only the local owner's own path mints a grant.
+def test_a_bundle_offered_at_creation_never_becomes_authority(service):
+    try:
+        worker = plain(service, {"worker_access_grant": bundle_grant()})
+    except ParallelExecutionIsolationError:
+        return  # (refused outright: no Worker, no authority)
+    assert "_native_input_deadline_at" not in admitted(service, worker)
+
+
+def test_another_tenant_label_in_local_mode_never_gets_a_grant(service):
+    try:
+        worker = plain(service, {"worker_access_grant": bundle_grant()}, tenant="other-tenant")
+    except ParallelExecutionIsolationError:
+        return
+    assert "_native_input_deadline_at" not in admitted(service, worker)
+
+
+def test_assign_never_creates_a_grant(service):
+    worker = plain(service)
+    try:
+        service.assign_run(worker["worker_id"], "task", runtime_bundle={"worker_access_grant": bundle_grant()},
+                           start_processor=False, resume_paused_worker=False)
+    except ParallelExecutionIsolationError:
+        pass  # (refused outright)
+    assert "_native_input_deadline_at" not in admitted(service, worker)
+
+
+def grant_expiry(service, worker):
+    if hasattr(service, "worker_access_grant_record"):
+        return service.worker_access_grant_record(worker["worker_id"])["expires_at"]
+    stored = json.loads(service.store.get_worker(worker["worker_id"])["bootstrap_bundle_json"])
+    return stored["worker_access_grant"]["expires_at"]
+
+
+def test_assign_and_find_or_resume_never_extend_a_grant(service, tmp_path):
+    worker = granted(service, tmp_path)
+    before = grant_expiry(service, worker)
+    later = bundle_grant(time.time() + 30 * 24 * 3600)
+    try:
+        service.assign_run(worker["worker_id"], "task", runtime_bundle={"worker_access_grant": later},
+                           start_processor=False, resume_paused_worker=False)
+    except ParallelExecutionIsolationError:
+        pass  # (refused outright)
+    assert grant_expiry(service, worker) == before
+    project = service.store.get_worker(worker["worker_id"])["project_id"]
+    try:
+        service.find_or_create_worker(project_id=project, owner_id="owner-a", name="Job worker", role="worker",
+                                      profile="grok-build", backend="", alias="Job worker", execution_mode="host",
+                                      bootstrap_bundle={"worker_access_grant": later}, start_synchronously=False)
+    except ParallelExecutionIsolationError:
+        pass  # (refused outright)
+    assert grant_expiry(service, worker) == before
+
+
+# 2. Restricted mode always wins.
+def test_a_restriction_once_set_cannot_be_cleared_on_a_granted_worker(service, tmp_path):
+    worker = granted(service, tmp_path)
+    restricted = {**json.loads(service.store.get_worker(worker["worker_id"])["bootstrap_bundle_json"] or "{}"),
+                  "provider_capabilities": {"native_tools": False}}
+    service.store.update_worker(worker["worker_id"], bootstrap_bundle_json=json.dumps(restricted))
+    cleared = {**restricted, "provider_capabilities": {"native_tools": True}}
+    service.store.update_worker(worker["worker_id"], bootstrap_bundle_json=json.dumps(cleared))  # (as worker_run can)
+    run = service.assign_run(worker["worker_id"], "task", start_processor=False, resume_paused_worker=False)
+    run_worker = service._run_local_worker(service.store.get_worker(worker["worker_id"]),
+                                           service.store.get_run(run["run_id"]),
+                                           authority_context={"host_startup_lease_id": LEASE})
+    argv = command(tmp_path, {**run_worker, "_active_run_id": run["run_id"]})
+    assert "--native-tools-disabled" in argv and argv[argv.index("--yolo-mode") + 1] == "false"
+
+
+# 3. Expiry: the question window starts when asked; the authority ends at the grant's expiry.
+def test_the_input_deadline_is_the_grants_expiry_and_the_window_is_per_question(service, tmp_path):
+    worker = granted(service, tmp_path)
+    run_worker = admitted(service, worker)
+    assert run_worker["_native_input_deadline_at"] > time.time() + 3000
+    argv = command(tmp_path, run_worker)
+    assert argv[argv.index("--input-window-seconds") + 1] == "60"
+    assert "--stop-at-permission-deadline" in argv
+
+
+# 4. The ceiling fails closed.
+def test_no_grant_takes_effect_without_a_deny_list(service, tmp_path, monkeypatch):
+    monkeypatch.setenv("WPR_GROK_DENY", "")
+    try:
+        worker = granted(service, tmp_path)
+    except (ParallelExecutionIsolationError, ValueError):
+        return
+    with pytest.raises(BrokerAdmissionError):
+        admitted(service, worker)
+
+
+# 5. Deny parity is exact, and ungranted runs keep today's behaviour.
+def test_an_unrecognised_grok_tool_name_is_refused_not_skipped(service, tmp_path, monkeypatch):
+    from workers_projects_runtime.openclaw_runtime import RuntimeErrorBase
+    monkeypatch.setenv("WPR_GROK_DENY", json.dumps(["CronCreate", *DENY]))
+    with pytest.raises((RuntimeErrorBase, ValueError, ParallelExecutionIsolationError, BrokerAdmissionError)):
+        worker = granted(service, tmp_path)
+        runtime = HostGrokBuildRuntime(str(tmp_path / "native"))
+        home = runtime._grok_home(worker)
+        home.mkdir(parents=True, exist_ok=True)
+        (home / "auth.json").write_text("{}")
+        runtime._native_environment(admitted(service, worker), host=True)
+
+
+@pytest.mark.parametrize("lane", ["mission", "conversation"])
+def test_an_ungranted_worker_or_coordinator_config_is_left_as_it_is(tmp_path, monkeypatch, lane):
+    monkeypatch.setenv("GROK_HOME", str(tmp_path / "unconnected-grok"))
+    monkeypatch.setenv("WPR_GROK_DENY", json.dumps(DENY))
+    runtime = HostGrokBuildRuntime(str(tmp_path / "native"))
+    monkeypatch.setattr(runtime, "_host_env", lambda _: {})
+    record = {"worker_id": "worker-grok", "owner_id": "local", "profile": "grok-build", "model": "grok-selected",
+              "workspace_dir": str(tmp_path / "workspace"), "execution_mode": "host", "trusted_run_lane": lane,
+              "bootstrap_bundle_json": "{}"}
+    home = runtime._grok_home(record)
+    home.mkdir(parents=True)
+    (home / "auth.json").write_text("{}")
+    before = '[marketplace]\nofficial_marketplace_auto_installed = true\n'
+    (home / "config.toml").write_text(before)
+    runtime._native_environment(record, host=True)
+    assert (home / "config.toml").read_text() == before or lane == "conversation" and "permission" not in (home / "config.toml").read_text()
