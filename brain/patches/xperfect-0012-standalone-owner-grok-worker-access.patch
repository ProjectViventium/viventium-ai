+def native_home(tmp_path, monkeypatch, lane="mission"):
+    runtime = HostGrokBuildRuntime(str(tmp_path / "native"))
+    monkeypatch.setattr(runtime, "_host_env", lambda _: {})
+    record = {"worker_id": "worker-grok", "owner_id": "owner-a", "profile": "grok-build", "model": "grok-selected",
+              "workspace_dir": str(tmp_path / "workspace"), "execution_mode": "host", "trusted_run_lane": lane,
+              "bootstrap_bundle_json": "{}"}
+    home = runtime._grok_home(record)
+    home.mkdir(parents=True)
+    (home / "auth.json").write_text("{}")
+    (home / "config.toml").write_text('[marketplace]\nofficial_marketplace_auto_installed = true\n')
+    return runtime, record, home
