+def test_the_api_mints_only_with_the_owners_proof(tmp_path, standalone, monkeypatch):
+    from fastapi.testclient import TestClient
+    from workers_projects_runtime.api import create_app
+    client = TestClient(create_app(str(tmp_path / "runtime.db"), runtime=StubRuntime()))
+    key = read_grant_key(tmp_path / "worker-access-grant.key")  # (made by the app at its start, standalone)
+    project = client.post("/v1/projects", json={"owner_id": "owner-a", "title": "Jobs", "goal": "g"}).json()
+    body = {"owner_id": "owner-a", "name": "Job worker", "role": "worker", "profile": "grok-build",
+            "execution_mode": "host", "start_synchronously": False}
+    offered = {**body, "bootstrap_bundle": {"worker_access_grant": {"version": 1, "worker_access": "full",
+                                                                   "execution_mode": "host",
+                                                                   "expires_at": time.time() + 3600}}}
+    assert client.post(f"/v1/projects/{project['project_id']}/workers", json=offered).status_code == 409
+    worker = client.post(f"/v1/projects/{project['project_id']}/workers", json=body).json()
+    expires = round(time.time() + 3600, 3)
+    path = f"/v1/workers/{worker['worker_id']}/worker-access-grant"
+    bearer_only = client.post(path, json={"expires_at": expires, "deny_rules": DENY, "proof": "0" * 64})
+    assert bearer_only.status_code == 403
+    granted = client.post(path, json={"expires_at": expires, "deny_rules": DENY,
+                                      "proof": grant_proof(key, worker["worker_id"], expires, DENY)})
+    assert granted.status_code == 201 and granted.json()["expires_at"] == expires
