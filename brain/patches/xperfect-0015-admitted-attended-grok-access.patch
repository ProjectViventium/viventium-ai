+def test_provider_gate_serves_only_the_running_native_process(tmp_path):
+    import socket
+    import subprocess
+    import tempfile
+    from pathlib import Path
+    from threading import Thread
+
+    helper = """import socket, sys
+with socket.socket(socket.AF_UNIX) as s:
+    s.settimeout(2)
+    s.connect(sys.argv[1])
+    s.sendall(b'B')
+    sys.stdout.buffer.write(s.recv(256))
+"""
+    parent = """import subprocess, sys
+assert sys.stdin.readline() == 'go\\n'
+result = subprocess.run([sys.executable, '-c', sys.argv[1], sys.argv[2]], capture_output=True, check=True)
+sys.stdout.buffer.write(result.stdout)
+"""
+    issued = []
+    status = []
+
+    def credential(background):
+        issued.append(background)
+        return b'K', b'synthetic-access'
+
+    with tempfile.TemporaryDirectory(prefix='grok-gate-test-', dir='/tmp') as socket_dir, socket.socket(socket.AF_UNIX) as gate:
+        path = str(Path(socket_dir) / 'gate')
+        gate.bind(path)
+        gate.listen(4)
+        gate.settimeout(0.1)
+        with subprocess.Popen([sys.executable, '-c', parent, helper, path],
+                              stdin=subprocess.PIPE, stdout=subprocess.PIPE) as native:
+            thread = Thread(target=grok_acp_runner._serve_provider_gate,
+                            args=(gate, native, credential, status), daemon=True)
+            thread.start()
+            try:
+                outside = subprocess.run([sys.executable, '-c', helper, path], capture_output=True, timeout=3)
+                assert not outside.stdout and not issued
+                output, _ = native.communicate(b'go\n', timeout=5)
+                assert native.returncode == 0 and output == b'synthetic-access'
+                assert issued == [True] and status == [b'K']
+            finally:
+                if native.poll() is None:
+                    native.kill()
+                thread.join(1)
+
+
