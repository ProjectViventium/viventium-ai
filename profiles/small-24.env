MEMORY_CORTEX=mac
MEMORY_URL=http://127.0.0.1:11436/v1
MEMORY_MODEL=qwen3:1.7b
LOCAL_CONTEXT=8192
VX_MOST_CONVERSATIONS=2

VX_MOST_CALLS=1
