# Apple silicon with 24 to 31 GiB. The Grok mind with local voice and helpers.
SMALL_MAC_TIER=24
LIVEKIT_URL=ws://127.0.0.1:7880
STT=whisper_local
STT_URL=http://127.0.0.1:8930/v1
TTS=auto                             # Eve with your Grok connection; otherwise this Mac
TTS_URL=http://127.0.0.1:8940/v1
TTS_MODEL=mlx-community/chatterbox-turbo-8bit
TTS_VOICE=eve
TTS_TAGS="[laugh] [sigh] [gasp]"    # Native, best effort; no inserted clips
TTS_FALLBACK=mlx_local
TTS_STREAM=1
TTS_STREAM_SECONDS=0.5
MISSING_KEY=backup
QUEEN=xai_plan
QUEEN_MODEL=grok-4.7
QUEEN_EFFORT=low
QUEEN_FALLBACK=openai
QUEEN_FALLBACK_MODEL=gpt-6.1-sol
WORKERS=signed-in
WORKERS_OPTIONAL=1
WORKER_PROFILE=claude-code
WORKER_FALLBACK=codex-cli
XPERFECT_STATE=brain/state-cloud
FEELINGS=warm
FEELINGS_URL=helpers
