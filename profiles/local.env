# Fully local: every model runs on this Mac. Switch with: ./vx up cloud

# Call (LiveKit on this Mac, on Light's own key: ./vx makes it once and keeps it in the Keychain)
LIVEKIT_URL=ws://127.0.0.1:7880

# Speech
STT=whisper_local                    # whisper_local | assemblyai
STT_URL=http://127.0.0.1:8930/v1     # whisper.cpp large-v3-turbo
TTS=mlx_local                        # mlx_local (mlx-audio server) | xai
TTS_URL=http://127.0.0.1:8940/v1     # mlx-audio server
TTS_MODEL=mlx-community/chatterbox-turbo-8bit   # the default voice model
TTS_VOICE=default
TTS_TAGS="[laugh] [sigh] [gasp]"    # Native, best effort; no inserted clips
TTS_STREAM=1                         # each sentence plays as it renders (first audio ~0.3 s vs ~0.6 s whole)
TTS_STREAM_SECONDS=1.0               # audio per streamed chunk (0.5: first audio 0.15 s, more GPU per sentence)

# Brain: Queen (fast, direct) + Workers (xPerfect, native harness)
QUEEN=ollama                         # ollama | openai | anthropic | xai
QUEEN_MODEL=qwen3.6:latest
QUEEN_URL=http://127.0.0.1:11435/v1
QUEEN_EFFORT=none                    # thinking off: ~0.25 s to first word
WORKER_PROFILE=claude-code   # Claude Code: uses MCP tools on the local model; Codex cannot here
WORKERS=local                        # Workers on qwen3.6 via brain/codex-home-local (own model server)
XPERFECT_STATE=brain/state-local       # her Workers' own xPerfect (its address follows from it: ./vx, xp_ports)

# Feelings and memory in Life (LIFE is set in profiles/machine.local.env) run on the Workers' local model
# server, as in every profile: background work, free and private. Either URL can point elsewhere.
FEELINGS=warm                        # off | grounded | candid | warm | curious
FEELINGS_MODEL=qwen3.6:latest
FEELINGS_URL=http://127.0.0.1:11436
MEMORY_URL=http://127.0.0.1:11436/v1
MEMORY_MODEL=qwen3.6:latest
