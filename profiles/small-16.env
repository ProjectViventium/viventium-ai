# Apple silicon with 16 to 23 GiB. Listen locally and speak with Eve or the macOS voice.
SMALL_MAC_TIER=16
LIVEKIT_URL=ws://127.0.0.1:7880
STT=whisper_local
STT_URL=http://127.0.0.1:8930/v1
TTS=auto                             # Eve with your Grok connection; otherwise this Mac
TTS_VOICE=eve
TTS_TAGS="[laugh] [sigh]"
TTS_FALLBACK=mac_say
QUEEN=xai_plan
QUEEN_MODEL=grok-4.7
QUEEN_EFFORT=low
QUEEN_FALLBACK=openai
QUEEN_FALLBACK_MODEL=gpt-6.1-sol
WORKERS=signed-in
WORKERS_OPTIONAL=1
WORKER_PROFILE=claude-code
WORKER_FALLBACK=codex-cli
XPERFECT_STATE=brain/state-cloud
FEELINGS=warm
FEELINGS_URL=helpers
HELPERS=xai_plan:grok-4.7,openai:gpt-6.1-sol
MEMORY_CORTEX=mac
MEMORY_URL=http://127.0.0.1:11436/v1
MEMORY_MODEL=qwen3:1.7b
LOCAL_CONTEXT=8192
VX_MOST_CONVERSATIONS=2
