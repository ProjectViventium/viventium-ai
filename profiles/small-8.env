# Apple silicon with less than 16 GiB. Online listening avoids loading Whisper.
SMALL_MAC_TIER=8
LIVEKIT_URL=ws://127.0.0.1:7880
STT=off
STT_AUTO=1
TTS=auto
TTS_FALLBACK=mac_say
QUEEN=xai_plan
QUEEN_MODEL=grok-4.7
QUEEN_EFFORT=low
QUEEN_FALLBACK=openai
QUEEN_FALLBACK_MODEL=gpt-6.1-sol
WORKERS=signed-in
WORKERS_OPTIONAL=1
WORKER_PROFILE=claude-code
WORKER_FALLBACK=codex-cli
XPERFECT_STATE=brain/state-cloud
FEELINGS=off
FEELINGS_URL=
HELPERS=xai_plan:grok-4.7,openai:gpt-6.1-sol
MEMORY_URL=
MEMORY_MODEL=
MEMORY_EMBED=off
VX_MOST_CONVERSATIONS=1
