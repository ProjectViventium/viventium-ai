# Cloud speech and models. Same call, UI and xPerfect Workers. Switch with: ./vx up local
# Keys come from your environment or macOS Keychain (see README); never write them here.

# Call (LiveKit on this Mac, on Light's own key: ./vx makes it once and keeps it in the Keychain)
LIVEKIT_URL=ws://127.0.0.1:7880

# Speech
STT=assemblyai                       # needs ASSEMBLYAI_API_KEY
TURN=stt                             # AssemblyAI decides end of turn (local profile: LiveKit's local model)
TTS=auto                             # Eve with your Grok connection; otherwise this Mac
TTS_VOICE=eve
TTS_TAGS="[laugh] [sigh]"
TTS_FALLBACK=mlx_local               # if xAI cannot be reached: her local voice (kept ready on this Mac)
TTS_URL=http://127.0.0.1:8940/v1
TTS_MODEL=mlx-community/chatterbox-turbo-8bit
TTS_STREAM=1
TTS_STREAM_SECONDS=1.0

# Brain
QUEEN=openai                         # openai (OPENAI_API_KEY) | anthropic (ANTHROPIC_API_KEY) | xai (XAI_API_KEY)
QUEEN_MODEL=gpt-6.1-sol              # e.g. claude-opus-5-5 with QUEEN=anthropic, grok-4.7 with QUEEN=xai
QUEEN_EFFORT=low
QUEEN_FALLBACK=local                 # an online mind limited, refused or not answering: this Mac's model answers
WORKER_PROFILE=codex-cli             # codex-cli | claude-code
WORKERS=signed-in                    # your own Codex (gpt-6.1-sol) / Claude Code (claude-opus-5-5) sign-ins
WORKER_FALLBACK=claude-code          # if OpenAI's route is down (limit, sign-in, outage): your Claude Code sign-in
XPERFECT_STATE=brain/state-cloud       # (its address follows from it: ./vx, xp_ports)

# Her quick helpers (one-word checks, Deep Memory's judgement, Feelings' appraisal, summaries of your Life) are
# online: Claude Opus 5.5, then GPT-6.1 Sol, then this Mac, for call checks too. Claude uses your Anthropic key,
# your Claude Code sign-in, or your Foundry deployment. LIFE is set in profiles/machine.local.env.
HELPERS=claude:claude-opus-5-5,openai:gpt-6.1-sol,mac
FEELINGS=warm                        # off | grounded | candid | warm | curious
FEELINGS_URL=helpers                 # (an OpenAI-compatible URL and FEELINGS_MODEL instead: that one only)
MEMORY_URL=http://127.0.0.1:11436/v1 # this Mac's helper: the last backup
MEMORY_MODEL=qwen3.6:latest
