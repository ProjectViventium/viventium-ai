# Hybrid, the daily profile: your words are heard on this Mac (accurate, fast, private); her mind is
# online (GPT-6.1 Sol, or Claude Opus 5.5 with your Anthropic key); her voice is Eve (SpaceXSI); her quick helpers and
# background work are online. Every online part names its backup: this Mac's model for her mind, her local voice for
# Eve, this Mac last for her helpers, your ChatGPT plan when Claude's route is down. ./vx up hybrid

# Call (LiveKit on this Mac, on Light's own key: ./vx makes it once and keeps it in the Keychain)
LIVEKIT_URL=ws://127.0.0.1:7880

# Speech
STT=whisper_local                    # whisper_local | assemblyai
STT_URL=http://127.0.0.1:8930/v1     # whisper.cpp large-v3-turbo
TTS=auto                             # Eve with your Grok connection; otherwise this Mac
TTS_VOICE=eve
TTS_TAGS="[laugh] [sigh]"
TTS_FALLBACK=mlx_local               # if xAI cannot be reached: her local voice (kept ready on this Mac)
TTS_URL=http://127.0.0.1:8940/v1
TTS_MODEL=mlx-community/chatterbox-turbo-8bit
TTS_STREAM=1
TTS_STREAM_SECONDS=1.0

# Brain
QUEEN=openai                         # openai (OPENAI_API_KEY) | anthropic (ANTHROPIC_API_KEY): the settings page
QUEEN_MODEL=gpt-6.1-sol              # claude-opus-5-5 with QUEEN=anthropic
QUEEN_EFFORT=low
QUEEN_FALLBACK=local                 # her mind limited, refused or not answering: this Mac's model answers
WORKER_PROFILE=claude-code           # her background Queen and Workers: your Claude Code sign-in (Opus 5.5)
WORKERS=signed-in
WORKER_FALLBACK=codex-cli            # if Claude's route is down (limit, sign-in, outage): your Codex sign-in
# One subscription is enough: her Workers run on the first of the two that is signed in, and a part whose key
# this Mac lacks starts on its declared backup on this Mac (her mind as Local runs it, her local voice); Settings says
# what answers now, and the part goes online once its key is added. Cloud keeps its keys as needs.
MISSING_KEY=backup
XPERFECT_STATE=brain/state-cloud       # (its address follows from it: ./vx, xp_ports)

# Her quick helpers (one-word checks, Deep Memory's judgement, Feelings' appraisal, summaries of your Life) are
# online: Claude Opus 5.5, then GPT-6.1 Sol, then this Mac, for call checks too. Claude uses your Anthropic key,
# your Claude Code sign-in, or your Foundry deployment. LIFE is set in profiles/machine.local.env.
HELPERS=claude:claude-opus-5-5,openai:gpt-6.1-sol,mac
FEELINGS=warm                        # off | grounded | candid | warm | curious
FEELINGS_URL=helpers                 # (an OpenAI-compatible URL and FEELINGS_MODEL instead: that one only)
MEMORY_URL=http://127.0.0.1:11436/v1 # this Mac's helper: the last backup, her mind's backup too
MEMORY_MODEL=qwen3.6:latest
