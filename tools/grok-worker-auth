#!/usr/bin/env python3
"""Grok Build's external provider for an admitted Light Worker."""
import os
import socket
import sys


def main() -> int:
    path = os.environ.get("WPR_GROK_AUTH_SOCKET")
    if not path:
        return 1
    background = os.environ.get("GROK_AUTH_EXPIRED") == "1"
    try:
        with socket.socket(socket.AF_UNIX) as gate:
            gate.settimeout(2.0 if background else 300.0)
            gate.connect(path)
            gate.sendall(b'B' if background else b'I')
            data = gate.makefile('rb').read(64 * 1024)
    except OSError:
        return 1
    if not data:
        return 1
    sys.stdout.buffer.write(data + b'\n')
    return 0


if __name__ == "__main__":
    sys.exit(main())
